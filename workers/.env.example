# ============================================
# UseMoney Workers - Environment Variables
# ============================================
# Copy this file to .env.local and fill in values
#
# cp .env.example .env.local
#
# Note: Workers also load the monorepo root .env file first,
# which provides broker API keys, encryption key, and GCP settings.
# Variables in .env.local override the root .env values.
# ============================================

# ============================================
# Server
# ============================================
PORT=8081
NODE_ENV=development

# ============================================
# Database (REQUIRED)
# ============================================
# Same MongoDB Atlas connection as web app
# Get from: MongoDB Atlas Dashboard
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/stockbook

# ============================================
# Redis (REQUIRED)
# ============================================
# Used for application caching only (job queuing uses Cloud Pub/Sub)
# Local: redis://localhost:6379
# DigitalOcean: rediss://default:PASSWORD@host:25061
REDIS_URL=redis://localhost:6379

# ============================================
# Encryption (REQUIRED for broker sync jobs)
# ============================================
# AES-256-GCM encryption key for broker credentials
# MUST be same key as web app (shared credentials)
# MUST be a 64-character hex string
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ============================================
# Cache Configuration
# ============================================
CACHE_ENABLED=true
LOG_LEVEL=info

# ============================================
# Broker APIs (REQUIRED for broker sync & instrument sync)
# ============================================
# These are also available from monorepo root .env
# Override here if workers need different credentials

# Zerodha — FREE "Personal" Kite app (multi-user) for portfolio sync (MONEY-837).
# The paid "Connect" app's live-data code lives DORMANT in workers/src/connect;
# if/when activated it reads ZERODHA_CONNECT_API_KEY/SECRET (token captured via
# the web /api/brokers/zerodha-connect founder flow).
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
# System-level key for instrument master data sync (no user auth needed; the
# /instruments dump is public + tier-agnostic).
# ZERODHA_SYSTEM_API_KEY=

# Upstox
# UPSTOX_API_KEY=
# UPSTOX_API_SECRET=

# Angel One
# ANGEL_API_KEY=

# Dhan
# DHAN_CLIENT_ID=

# Fyers
# FYERS_APP_ID=
# FYERS_SECRET_KEY=

# ============================================
# Google Cloud Platform (for Cloud Run deployment)
# ============================================
# GCP Project ID
GCP_PROJECT_ID=

# GCP region for Vertex AI (default: us-central1)
GCP_LOCATION=us-central1

# --- Local Development: use file path ---
# Service account needs: Pub/Sub Subscriber, Storage Admin
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Cloud Run / CI: use base64-encoded JSON key ---
# GCP_SERVICE_ACCOUNT_KEY_BASE64=

# ============================================
# AI - Anthropic Claude (MONEY-506 slice)
# ============================================
# The research portfolio-analysis synthesis runs in this worker, so the
# worker is the runtime that calls Claude Sonnet 4.6. Present = slice on;
# CLAUDE_PORTFOLIO_AGENT=off forces Gemini. On Cloud Run this is injected
# from the ANTHROPIC_API_KEY_QA/_PROD secret (Secret Manager).
ANTHROPIC_API_KEY=
CLAUDE_PORTFOLIO_AGENT=

# ============================================
# Note: On GCP Cloud Run, DATABASE_URL and REDIS_URL
# are injected as secrets from Secret Manager.
# No GCP key needed - Cloud Run uses --service-account flag.
# ============================================

# ============================================
# StockSage 2.0 (MONEY-779)
# ============================================
# Vertex AI RAG retriever seam (packages/core/src/rag). With VERTEX_RAG_CORPUS
# EMPTY the code safely falls back to the Atlas RAG retriever — Vertex only
# activates once VERTEX_RAG_ENABLED=true AND GCP_PROJECT_ID AND VERTEX_RAG_CORPUS
# are all set. GCP_PROJECT_ID is defined above; not duplicated here.
VERTEX_RAG_ENABLED=true
VERTEX_RAG_LOCATION=us-central1
# Filled in post-provision via scripts/ops/setup-vertex-rag.sh. Empty => Atlas.
VERTEX_RAG_CORPUS=
# Document AI layout-aware PDF extraction (stock-document-extract job).
# Empty DOCUMENT_AI_PROCESSOR_ID => worker falls back to pdf-parse.
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=
# Local dev only: pull Pub/Sub jobs instead of waiting for push subscriptions.
ENABLE_PULL_SUBSCRIBER=true

# ============================================
# US price backbone — Tiingo (MONEY-980 / MONEY-1262)
# ============================================
# TIINGO_API_KEY is sent as `Authorization: Token <key>` on every
# api.tiingo.com call. The client THROWS when it is absent rather than
# fetching unauthenticated, so a missing key is a loud failure instead of a
# nightly job that quietly writes nothing. On Cloud Run it is injected from the
# TIINGO_API_KEY_QA / _PROD secret.
TIINGO_API_KEY=
# TIINGO_PLAN selects which rate ceilings the client paces against:
#   COMMERCIAL      20,000/hr   150,000/day     100 GB/month   (what we hold)
#   REDISTRIBUTION  80,000/hr   1,200,000/day   1 TB/month     (contracted next)
# Unset or unrecognised resolves to COMMERCIAL — the LOWER pair — on purpose:
# guessing high walks a run into a 429 wall mid-universe and leaves a
# half-filled table, guessing low only makes it slower. Set it EXPLICITLY here
# and in both cloudbuild specs anyway: "absent" and "explicitly commercial"
# must not be the same state, which is how MF_METADATA_PROVIDER disabled its
# job silently for months (MONEY-1214).
TIINGO_PLAN=COMMERCIAL
