{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "ui_kits/app/**",
              "ui_kits/app/components/**",
              "ui_kits/app/shared/**",
              "ui_kits/stocksage/**",
              "ui_kits/website/shared/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Instrument Serif|JetBrains Mono|Inter))/i]",
        "message": "Font not provided by the design system. Available: Instrument Serif, JetBrains Mono, Inter."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--code-bg",
      "--code-fg",
      "--dot-fg",
      "--dot-fg-2",
      "--emerald",
      "--emerald-bg",
      "--emerald-text",
      "--font-mono",
      "--font-sans",
      "--font-serif",
      "--fs-body",
      "--fs-h1",
      "--fs-h2",
      "--fs-h3",
      "--fs-hero",
      "--fs-lede",
      "--fs-meta",
      "--fs-sm",
      "--gain",
      "--ink",
      "--ink-2",
      "--ink-3",
      "--ink-4",
      "--loss",
      "--ls-mono",
      "--ls-snug",
      "--ls-tight",
      "--on-pop",
      "--paper",
      "--paper-2",
      "--paper-3",
      "--pf-skel-base",
      "--pf-skel-glow",
      "--pop-1",
      "--pop-1-text",
      "--pop-2",
      "--pop-2-text",
      "--pop-3",
      "--pop-3-text",
      "--pop-4",
      "--pop-4-text",
      "--pop-5",
      "--pop-5-text",
      "--r-lg",
      "--r-md",
      "--r-pill",
      "--r-sm",
      "--r-xl",
      "--rule",
      "--rule-soft",
      "--rule-softer",
      "--shadow-hard",
      "--shadow-soft"
    ],
    "tokenKinds": {
      "--paper": "color",
      "--paper-2": "color",
      "--paper-3": "color",
      "--ink": "color",
      "--ink-2": "color",
      "--ink-3": "color",
      "--ink-4": "color",
      "--rule": "color",
      "--rule-soft": "color",
      "--rule-softer": "color",
      "--dot-fg": "color",
      "--dot-fg-2": "color",
      "--emerald": "color",
      "--emerald-bg": "color",
      "--pop-1": "color",
      "--pop-2": "color",
      "--pop-3": "color",
      "--pop-4": "color",
      "--pop-5": "color",
      "--emerald-text": "font",
      "--pop-1-text": "font",
      "--pop-2-text": "font",
      "--pop-3-text": "font",
      "--pop-4-text": "font",
      "--pop-5-text": "font",
      "--on-pop": "color",
      "--gain": "color",
      "--loss": "color",
      "--shadow-hard": "shadow",
      "--shadow-soft": "shadow",
      "--code-bg": "color",
      "--code-fg": "color",
      "--r-sm": "spacing",
      "--r-md": "spacing",
      "--r-lg": "spacing",
      "--r-xl": "spacing",
      "--r-pill": "spacing",
      "--font-sans": "font",
      "--font-serif": "font",
      "--font-mono": "font",
      "--fs-hero": "font",
      "--fs-h1": "font",
      "--fs-h2": "font",
      "--fs-h3": "font",
      "--fs-lede": "font",
      "--fs-body": "font",
      "--fs-sm": "font",
      "--fs-meta": "font",
      "--ls-tight": "spacing",
      "--ls-snug": "spacing",
      "--ls-mono": "spacing",
      "--pf-skel-base": "color",
      "--pf-skel-glow": "color"
    },
    "fontFamilies": [
      "Instrument Serif",
