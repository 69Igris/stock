#!/bin/sh

# Enforce branch naming convention: {type}/MONEY-{number}
# Allowed types: feat, fix, test, chore, docs, refactor, perf, ci, build, style, hotfix
# Text descriptions in branch names are NOT allowed - the Linear ticket is the source of truth.

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)

# Skip validation for exempt branches
case "$BRANCH" in
  main|release|develop) exit 0 ;;
esac

# Validate branch name
if ! echo "$BRANCH" | grep -qE '^(feat|fix|test|chore|docs|refactor|perf|ci|build|style|hotfix)/MONEY-[0-9]+$'; then
  echo ""
  echo "❌ Branch name does not follow the naming convention."
  echo ""
  echo "  Expected: {type}/MONEY-{number}     (no text description)"
  echo "  Got:      $BRANCH"
  echo ""
  echo "  Allowed types: feat, fix, test, chore, docs, refactor, perf, ci, build, style, hotfix"
  echo "  Text descriptions are NOT allowed - the Linear ticket is the source of truth."
  echo ""
  echo "  Examples:"
  echo "    feat/MONEY-85"
  echo "    fix/MONEY-108"
  echo "    test/MONEY-112"
  echo ""
  echo "  Rename your branch: git branch -m {type}/MONEY-{number}"
  echo ""
  exit 1
fi
