# ============================================
# UseMoney Web App - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# All others are server-only.
# ============================================

# ============================================
# Database (REQUIRED)
# ============================================
# MongoDB Atlas connection string
# Create cluster: https://cloud.mongodb.com
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/stockbook

# ============================================
# Authentication - Clerk (REQUIRED)
# ============================================
# Get keys from: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk webhook signing secret (for user sync webhook)
# Set up webhook at: https://dashboard.clerk.com/webhooks
# Endpoint: https://your-domain.com/api/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_...

# ============================================
# Redis / Cache (RECOMMENDED)
# ============================================
# Redis connection URL for application caching (not job queuing).
# Supports: DigitalOcean Managed Redis, Upstash, Redis Cloud
# DigitalOcean format: rediss://default:PASSWORD@private-db-redis-xxx.g.db.ondigitalocean.com:25061
# TLS format: rediss://default:PASSWORD@host:port
# Non-TLS:    redis://default:PASSWORD@host:port
# If not set, falls back to in-memory cache only
REDIS_URL=

# Alternative: Google Cloud Memorystore (use these instead of REDIS_URL)
# REDIS_HOST=10.0.0.3
# REDIS_PORT=6379
# REDIS_AUTH_STRING=your-auth-string

# Enable/disable caching globally (default: true)
CACHE_ENABLED=true

# Logging level: trace, debug, info, warn, error, fatal (default: info)
LOG_LEVEL=info

# ============================================
# Encryption (REQUIRED for broker integration)
# ============================================
# AES-256-GCM encryption key for broker credentials
# MUST be a 64-character hex string
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ============================================
# Google Cloud Platform (REQUIRED for AI & storage)
# ============================================
# GCP Project ID
GCP_PROJECT_ID=

# GCP region for Vertex AI (default: us-central1)
GCP_LOCATION=us-central1

# GCS bucket for private content (learning videos, documents)
GCP_STORAGE_BUCKET=

# GCS bucket for public content images (blog, newsletter) - direct GCS URLs
# Dev: stockbook-public-content-dev | Prod: stockbook-public-content
GCP_PUBLIC_STORAGE_BUCKET=

# --- Local Development: use file path ---
# Service account needs: Storage Admin, Vertex AI User, Pub/Sub Publisher
# Generate: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_APPLICATION_CREDENTIALS=

# --- Vercel / Production: use base64-encoded JSON key ---
# Generate: cat service-account.json | base64
GCP_SERVICE_ACCOUNT_KEY_BASE64=

# ============================================
# AI - Gemini (OPTIONAL)
# ============================================
# Enable Gemini integration (true = real AI, false = mock responses)
USE_GEMINI=false

# Maximum retries for failed Gemini requests (default: 3)
GEMINI_MAX_RETRIES=3

# Request timeout in milliseconds (default: 30000)
GEMINI_TIMEOUT_MS=30000

# ============================================
# AI - Anthropic Claude (MONEY-506 BAD-1 slice)
# ============================================
# When set, the research portfolio-analysis agent synthesizes via Claude
# Sonnet 4.6 (every other agent stays on Gemini). The eval (`yarn evals`)
# also needs it to call Claude. The research synthesis runs in the WORKER,
# so this must also be present in the worker runtime (root .env locally;
# ANTHROPIC_API_KEY_QA/_PROD GCP secret + cloudbuild wiring in QA/prod).
ANTHROPIC_API_KEY=
# Kill switch — set to "off" to force the slice back to Gemini.
CLAUDE_PORTFOLIO_AGENT=

# Enable LLM guardrails for finance-focused content (default: true in prod)
# USE_LLM_GUARDRAILS=true

# ============================================
# Payments - Dodo (REQUIRED for subscriptions)
# ============================================
# Get keys from: https://dodopayments.com
DODO_PAYMENTS_API_KEY=

# Webhook signing secret
# Endpoint: https://your-domain.com/api/webhooks/dodo
DODO_WEBHOOK_SECRET=

# Mode: "test" or "live" (default: test)
NEXT_PUBLIC_DODO_MODE=test

# Brand ID from Dodo dashboard
DODO_BRAND_ID=

# Cron secret for authenticated product sync
# Generate: openssl rand -base64 32
CRON_SECRET=

# ============================================
# Email - Resend (REQUIRED for transactional email & newsletter)
# ============================================
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_...

# HMAC secret for stateless unsubscribe links
# Generate: openssl rand -hex 32
EMAIL_UNSUBSCRIBE_SECRET=

# Resend Audience IDs for user segments (created in Resend dashboard)
# - free: never-paid users
# - paid: active paid subscription (PRO/PREMIUM/ULTIMATE)
# - downgraded: previously paid, now on FREE plan (good for win-back campaigns)
# - security: all users (transactional/account emails, no unsubscribe)
RESEND_AUDIENCE_FREE_ID=
RESEND_AUDIENCE_PAID_ID=
RESEND_AUDIENCE_DOWNGRADED_ID=
RESEND_AUDIENCE_USEMONEY_SECURITY_ID=

# Newsletter audience — one var, each Vercel env sets its own value
# dev / qa: fface17c-b20c-4798-92bc-8ed48f267b45
# prod:    169f6d19-ec82-472f-9375-99e4fb0172c8
RESEND_AUDIENCE_NEWSLETTER_ID=

# Marketing audience — placeholder — leave blank until the marketing audience is provisioned
RESEND_AUDIENCE_MARKETING_ID=

# Sender address (default: Shaswat Deep <shaswat@email.usemoney.ai> — founder-sent).
# Any address @email.usemoney.ai works (verified Resend domain). Override here.
# EMAIL_FROM=Shaswat Deep <shaswat@email.usemoney.ai>

# Reply-to address (default: support@usemoney.ai)
# EMAIL_REPLY_TO=support@usemoney.ai

# ============================================
# Broker APIs (OPTIONAL - enable per broker)
# ============================================
# Each broker requires registration at their developer portal.
# OAuth redirect URI: https://your-domain.com/api/brokers/{broker}/callback

# Zerodha - https://kite.trade/connect
# MONEY-837 — TWO Kite apps:
#  Personal (FREE, multi-user): the keys below — power ALL portfolio sync
#  (holdings/positions/tradebook/MF/profile + the /instruments master). The
#  Personal tier has no live quotes/charts, so web market data is Yahoo-only.
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
#  Connect (PAID): founder-only token capture via /api/brokers/zerodha-connect —
#  stores the encrypted token for the dormant workers/src/connect live-data code
#  (candles/quotes/ticks). Does NOT sync anything.
ZERODHA_CONNECT_API_KEY=
ZERODHA_CONNECT_API_SECRET=
ZERODHA_CONNECT_REDIRECT_URI=
# CONNECT_FOUNDER_EMAILS=   # optional CSV; default deepshaswat@gmail.com

# Upstox - https://developer.upstox.com
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# Angel One - https://smartapi.angelbroking.com
ANGEL_API_KEY=

# Dhan - https://dhanhq.co/docs
DHAN_CLIENT_ID=
DHAN_API_KEY=

# Fyers - https://myapi.fyers.in
FYERS_APP_ID=
FYERS_SECRET_KEY=

# Groww - Partner API
GROWW_API_KEY=
GROWW_API_SECRET=
# GROWW_TOTP_SECRET=

# HDFC Sky (planned)
# HDFC_API_KEY=
# HDFC_SECRET_KEY=

# ICICI Direct (planned)
# ICICI_API_KEY=
# ICICI_SECRET_KEY=

# ============================================
# Analytics - PostHog (OPTIONAL)
# ============================================
# Get keys from: https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============================================
# Application URLs
# ============================================
# Base URL for the application (used for OAuth callbacks, emails, OG images)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# App URL used in email templates and newsletter links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Advanced / Debug (OPTIONAL)
# ============================================
# Enable debug features (never enable in production)
# ENABLE_DEBUG_FEATURES=false

# Enable MongoDB vector search (requires Atlas Search index)
# MONGODB_VECTOR_SEARCH_ENABLED=false

# ============================================
# GST / Billing (MONEY-212 → MONEY-217)
# ============================================
# DIS Digital LLP seller details - frozen, do not parameterise per env
GST_SELLER_GSTIN=
GST_SELLER_PAN=
GST_SELLER_ADDRESS=
GST_SELLER_STATE_CODE=
GST_DEFAULT_SAC=998314

# LUT ARN - re-filed every FY. Hard-blocks invoice generation if empty.
GST_LUT_ARN=

# Half-month invoice cadence (default 15 - produces 1st-15th and 16th-end-of-month)
BILLING_PERIOD_DAYS=15

# Webhook ingestion is OFF by default; v1 ships manual CSV upload only.
FEATURE_DODO_WEBHOOK_INGEST=false

# Optional ops overrides for RBI reference rates per (currency, date), used when
# the live RBI archive fetch is unavailable. Format: GST_FX_RATE_<CCY>_<YYYY-MM-DD>=<rate>
# GST_FX_RATE_USD_2026-04-30=83.42

# Bank details printed on every export invoice (see docs/gst/monthly-process.md)
GST_BANK_BENEFICIARY=
GST_BANK_ACCOUNT=
GST_BANK_IFSC=
GST_BANK_SWIFT=

# GST invoice PDF storage (defaults to "usemoney-gst-invoices" - must be PRIVATE)
GCS_BUCKET_GST_INVOICES=usemoney-gst-invoices

# Per-user domestic invoice GST rate (MONEY-227). Default 18% - confirm with
# CA before changing per service classification (some FinTech services are
# exempt; some are 28% as luxury).
GST_DOMESTIC_RATE=18

# Optional override for the seller legal name printed on PDFs. Defaults to
# "DIS Digital LLP" if unset (used when RDB readSellerEnv fallback applies).
GST_SELLER_LEGAL_NAME=

# ============================================
# StockSage 2.0 (MONEY-779)
# ============================================
# Vertex AI RAG retriever seam (packages/core/src/rag). With VERTEX_RAG_CORPUS
# EMPTY the code safely falls back to the Atlas RAG retriever — Vertex only
# activates once VERTEX_RAG_ENABLED=true AND GCP_PROJECT_ID AND VERTEX_RAG_CORPUS
# are all set. GCP_PROJECT_ID is defined above; not duplicated here.
VERTEX_RAG_ENABLED=true
VERTEX_RAG_LOCATION=us-central1
# Filled in post-provision via scripts/ops/setup-vertex-rag.sh. Empty => Atlas.
VERTEX_RAG_CORPUS=
# Document AI layout-aware PDF extraction (workers stock-document-extract job).
# Empty DOCUMENT_AI_PROCESSOR_ID => worker falls back to pdf-parse.
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=

# MONEY-1466 (A1) — the Cloud Run UDF datafeed. Read by TradingViewAdvancedChart
# but NOT used until A3 flips the base URL; A1 ships the plumbing only.
NEXT_PUBLIC_MARKET_DATA_URL=https://market-data-qa.usemoney.ai
# The HS256 key `mintMarketDataToken` signs with, and the Cloud Run service
# verifies against. BOTH SIDES MUST CARRY THE SAME VALUE and neither has a
# default: an empty HMAC key is a VALID HMAC key, so a missing secret would
# otherwise mint tokens that verify against any other instance whose secret is
# equally missing. Both sides refuse instead — the action returns null, the
# verifier refuses every token.
#
# On Cloud Run it is mounted from Secret Manager (MARKET_DATA_TOKEN_SECRET_QA /
# _PROD) by apps/market-data/cloudbuild.*.yaml. On VERCEL it is a project
# environment variable and has to be set there by hand — this line is the only
# thing that says so. Unused until A5 wires the token onto the intraday routes.
MARKET_DATA_TOKEN_SECRET=
