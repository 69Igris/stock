{
  "name": "@usemoney/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "test": "node --import tsx ../../scripts/test-timeout.ts --import tsx --import ../../scripts/css-stub-register.mjs --test --test-concurrency=$(node -p \"Math.min(4,require('os').availableParallelism())\") --test-timeout=30000 \"__tests__/**/*.test.ts\"",
    "test:coverage": "c8 --reporter=text-summary --reporter=lcov --reporter=json-summary --include='app/**' --include='lib/**' --include='hooks/**' --include='components/**' --exclude='**/*.test.ts' --exclude='**/__tests__/**' --exclude='**/*.d.ts' --exclude='**/loading.tsx' --exclude='**/page.tsx' node --import tsx --test --test-timeout=30000 \"__tests__/**/*.test.ts\"",
    "test:coverage:all": "c8 --all --reporter=text-summary --reporter=json-summary --include='app/**' --include='lib/**' --include='hooks/**' --include='components/**' --exclude='**/*.test.ts' --exclude='**/__tests__/**' --exclude='**/*.d.ts' --exclude='**/loading.tsx' --exclude='**/page.tsx' --exclude='**/index.ts' node --import tsx --test --test-timeout=30000 \"__tests__/**/*.test.ts\"",
    "test:cache": "node --import tsx --test --test-timeout=30000 __tests__/cache/*.test.ts",
    "test:cache:redis": "RUN_REDIS_TESTS=true node --import tsx --test --test-timeout=30000 __tests__/cache/*.test.ts",
    "test:email": "node --import tsx --test --test-timeout=30000 __tests__/email/*.test.ts",
    "test:newsletter": "node --import tsx --test --test-timeout=30000 __tests__/newsletter/*.test.ts",
    "test:market": "node --import tsx --test --test-timeout=30000 __tests__/market/*.test.ts",
    "test:pubsub": "node --import tsx --test --test-timeout=30000 __tests__/pubsub/*.test.ts",
    "test:watch": "node --import tsx --test --test-timeout=30000 --watch \"__tests__/**/*.test.ts\"",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
  },
