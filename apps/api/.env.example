# ============================================
# UseMoney API - Environment Variables
# ============================================
# Copy to .env.local for local development
#
# cp .env.example .env.local
#
# Note: The API also loads the monorepo root .env file first,
# which provides broker API keys, encryption key, and GCP settings.
# Variables in .env.local override the root .env values.
#
# GCP Project: stock-book-483718
# Region: asia-south1
#
# Environments:
#   - local: Local development (localhost)
#   - qa: QA environment (api.qa.usemoney.ai)
#   - prod/production: Production (api.usemoney.ai)
# ============================================

# ============================================
# Environment
# ============================================
NODE_ENV=local
PORT=8080

# ============================================
# CORS Origins
# ============================================
# Local
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# QA (uncomment for QA)
# WEB_URL=https://qa.usemoney.ai
# ADMIN_URL=https://admin.qa.usemoney.ai

# Production (uncomment for production)
# WEB_URL=https://usemoney.ai
# ADMIN_URL=https://admin.usemoney.ai

# ============================================
# Database (REQUIRED - MongoDB Atlas)
# ============================================
# Format: mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/stockbook

# ============================================
# Redis (REQUIRED)
# ============================================
# Used for application caching only (not job queuing - jobs use Cloud Pub/Sub).
# Local: redis://localhost:6379
# DigitalOcean: rediss://default:PASSWORD@host:25061
REDIS_URL=redis://localhost:6379

# ============================================
# Authentication - Clerk (REQUIRED)
# ============================================
# Get from: https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_...

# ============================================
# Encryption (REQUIRED for broker operations)
# ============================================
# AES-256-GCM encryption key for broker credentials
# MUST be same key as web app (shared credentials)
# MUST be a 64-character hex string
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ============================================
# Cache Configuration
# ============================================
CACHE_ENABLED=true
LOG_LEVEL=debug

# ============================================
# Google Cloud Platform
# ============================================
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

# GCS bucket for content storage
GCP_STORAGE_BUCKET=

# --- Local Development: use file path ---
# Service account needs: Storage Admin, Vertex AI User
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Cloud Run / CI: use base64-encoded JSON key ---
# GCP_SERVICE_ACCOUNT_KEY_BASE64=

# ============================================
# Broker APIs (REQUIRED for broker operations)
# ============================================
# These are also available from monorepo root .env
# Override here if API needs different credentials

# Zerodha — FREE "Personal" Kite app (multi-user) for portfolio sync (MONEY-837).
# The paid "Connect" app (live data) lives in the apps/connect service.
# ZERODHA_API_KEY=
# ZERODHA_API_SECRET=

# Upstox
# UPSTOX_API_KEY=
# UPSTOX_API_SECRET=

# Angel One
# ANGEL_API_KEY=

# Dhan
# DHAN_CLIENT_ID=
# DHAN_API_KEY=

# Fyers
# FYERS_APP_ID=
# FYERS_SECRET_KEY=

# ============================================
# Rate Limiting (OPTIONAL)
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Note: On GCP Cloud Run, DATABASE_URL, REDIS_URL,
# and CLERK_SECRET_KEY are injected as secrets
# from Secret Manager.
# ============================================
