{
  "name": "@usemoney/api-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup && mkdir -p public && echo '{}' > public/.keep",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "node --import tsx ../../scripts/test-timeout.ts --import tsx --test --test-timeout=30000 \"__tests__/**/*.test.ts\""
  },
  "dependencies": {
    "@clerk/backend": "3.4.14",
    "@hono/node-server": "^1.19.13",
    "@hono/trpc-server": "^0.3.2",
    "@usemoney/api-utils": "*",
    "@usemoney/datadog": "*",
    "@usemoney/cache": "*",
    "@usemoney/core": "*",
    "@usemoney/fire": "*",
    "@usemoney/services": "*",
    "@usemoney/database": "*",
    "@usemoney/email": "*",
    "@usemoney/logger": "*",
    "@usemoney/pubsub": "*",
    "@usemoney/trpc": "*",
    "@usemoney/types": "*",
    "@usemoney/validation": "*",
    "@trpc/server": "^11.0.0-rc.682",
    "dotenv": "^17.2.3",
    "hono": "^4.12.18",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@usemoney/eslint-config": "*",
    "@usemoney/typescript-config": "*",
    "@types/node": "^22.13.4",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "@usemoney/research": "*"
  }
}
