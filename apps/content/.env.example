# ============================================
# UseMoney Content CMS - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local
# ============================================

# ============================================
# Database (REQUIRED)
# ============================================
# Same MongoDB Atlas connection as web app
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/stockbook

# ============================================
# Authentication - Clerk (REQUIRED)
# ============================================
# Same Clerk instance as web app
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# ============================================
# Application URL
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Web app URL (for image proxy URLs stored in post content)
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# ============================================
# Google Cloud Platform (REQUIRED for storage & AI)
# ============================================
# GCP Project ID
GCP_PROJECT_ID=

# GCP region for Vertex AI
GCP_LOCATION=us-central1

# GCS bucket for private content (learning, documents)
GCP_STORAGE_BUCKET=

# GCS bucket for public content images (blog, newsletter) - direct GCS URLs
# Dev: stockbook-public-content-dev | Prod: stockbook-public-content
GCP_PUBLIC_STORAGE_BUCKET=

# --- Local Development: use file path ---
GOOGLE_APPLICATION_CREDENTIALS=/path/to/qa-key.json

# --- Vercel / Production: use base64-encoded JSON key ---
# GCP_SERVICE_ACCOUNT_KEY_BASE64=

# ============================================
# Redis (REQUIRED for cache invalidation)
# ============================================
# Same Redis instance as web app - used to clear cached content after publish
REDIS_URL=rediss://default:password@host:25061

# ============================================
# Email - Resend (REQUIRED for newsletter)
# ============================================
RESEND_API_KEY=re_...

# HMAC secret for stateless unsubscribe links
# Generate: openssl rand -hex 32
EMAIL_UNSUBSCRIBE_SECRET=

# Resend Audience IDs for user segments (created in Resend dashboard)
# - free: never-paid users
# - paid: active paid subscription (PRO/PREMIUM/ULTIMATE)
# - downgraded: previously paid, now on FREE plan (good for win-back campaigns)
# - security: all users (transactional/account emails, no unsubscribe)
RESEND_AUDIENCE_FREE_ID=
RESEND_AUDIENCE_PAID_ID=
RESEND_AUDIENCE_DOWNGRADED_ID=
RESEND_AUDIENCE_USEMONEY_SECURITY_ID=

# ============================================
# PostHog Analytics (OPTIONAL)
# ============================================
# Same PostHog project as web app - differentiated by hostname
NEXT_PUBLIC_POSTHOG_KEY=phc_...

# ============================================
# AI - Gemini (OPTIONAL)
# ============================================
GOOGLE_GENAI_API_KEY=

# ============================================
# Access Control
# ============================================
# Comma-separated list of emails that can access the CMS
CONTENT_ADMIN_EMAILS=
