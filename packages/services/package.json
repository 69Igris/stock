{
  "name": "@usemoney/services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared service layer for UseMoney (web, API, workers)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./coupon": "./src/coupon.service.ts",
    "./events": "./src/events.service.ts",
    "./fire": "./src/fire.service.ts",
    "./gst": "./src/gst/index.ts",
    "./preferences": "./src/preferences/index.ts",
    "./product-sync": "./src/product-sync.service.ts",
    "./scheduled-plan-changes": "./src/scheduled-plan-changes.service.ts",
    "./payment-provisioning-logic": "./src/payment-provisioning-logic.ts",
    "./platform-config": "./src/platform-config.service.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "node --import tsx ../../scripts/test-timeout.ts --import tsx --test --test-timeout=30000 \"__tests__/**/*.test.ts\""
  },
  "dependencies": {
    "@google-cloud/storage": "^7.18.0",
    "@react-pdf/renderer": "^4.3.0",
    "@usemoney/cache": "*",
    "@usemoney/core": "*",
    "@usemoney/database": "*",
    "@usemoney/logger": "*",
    "@usemoney/pubsub": "*",
    "@usemoney/research": "*",
    "@usemoney/roast": "*",
    "@usemoney/security": "*",
    "@usemoney/storage": "*",
    "@usemoney/types": "*",
    "@usemoney/validation": "*",
    "posthog-node": "^5.20.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@usemoney/typescript-config": "*",
    "typescript": "^5.9.2"
  }
}
