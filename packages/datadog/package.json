{
  "name": "@usemoney/datadog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tracer": "./src/tracer.ts",
    "./metrics": "./src/metrics.ts",
    "./logger-transport": "./src/logger-transport.ts",
    "./constants": "./src/constants.ts",
    "./job-outcome": "./src/job-outcome.ts",
    "./llmobs": "./src/llmobs.ts"
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit && tsc -p tsconfig.test.json",
