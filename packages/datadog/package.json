    "test": "node --import tsx ../../scripts/test-timeout.ts --import tsx --test --test-timeout=180000 \"__tests__/**/*.test.ts\""
  },
  "dependencies": {
    "dd-trace": "^5.49.0",
    "datadog-metrics": "^0.12.0"
  },
  "devDependencies": {
    "@usemoney/typescript-config": "*",
    "@types/node": "^22.15.3",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "pino": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "pino": {
      "optional": true
    }
  }
