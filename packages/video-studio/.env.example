# ── Google / Vertex (Veo + Gemini director) ───────────────────────────────
# Same service account your repo already uses (roles/aiplatform.user).
GCP_PROJECT_ID=stock-book-483718
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa-key.json

# Veo model — VERIFY the current GA model id for your region before use.
# e.g. veo-3.0-generate-001 / veo-3.1-generate-preview (changes over time).
VEO_MODEL=veo-3.0-generate-001

# Gemini model the director uses to turn a brief into a timeline.
GEMINI_MODEL=gemini-2.5-flash

# ── Google Cloud Text-to-Speech (voiceover) ───────────────────────────────
# Uses GOOGLE_APPLICATION_CREDENTIALS above. VERIFY voice names via the
# TTS "voices.list" API; Neural2 is broadly available, Chirp3-HD is newer.
TTS_VOICE_HI=hi-IN-Neural2-A
TTS_VOICE_EN=en-IN-Neural2-A
TTS_SPEAKING_RATE=1.0

# ── Local tooling ─────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Royalty-free / licensed music you own, named track keys -> files (see README).
MUSIC_DIR=./assets/music
# Where rendered clips + final videos are written. RECOMMENDED: a path OUTSIDE the
# repo so finished videos never touch git. The work-*/ scratch dirs and the Veo
# cache (.veo-cache/) also live under here. Quote it if the path contains spaces
# (run-mcp.sh sources this file). Defaults to ./.video-out if unset.
# e.g. VIDEO_STUDIO_OUT="/Users/you/Documents/Claude/Projects/Content Strategy/Videos"
VIDEO_STUDIO_OUT=./.video-out
# Brand stylesheet (defaults to the bundled v3 cream-paper system).
BRAND_CSS=./src/brand/um-brand.css
