{
  "name": "@usemoney/video-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prompt-driven video studio MCP — director (brief → timeline) → motion graphics + Veo + Google TTS/music → ffmpeg compose. SEBI-safe by design.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./jobs": "./src/jobs.ts",
    "./director": "./src/director.ts",
    "./editor/ops": "./src/editor/ops.ts",
    "./editor/parse": "./src/editor/parse.ts",
    "./editor/compose": "./src/editor/compose.ts"
  },
  "bin": {
    "video-studio-mcp": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc && cp src/brand/um-brand.css dist/brand/um-brand.css",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx ../../scripts/test-timeout.ts --import tsx --test --test-timeout=30000 \"__tests__/**/*.test.ts\"",
    "mcp": "node --import tsx src/index.ts",
    "studio": "node --import tsx src/cli.ts",
    "postinstall": "playwright install chromium || true"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@google-cloud/text-to-speech": "^5.6.0",
    "@google/genai": "^2.8.0",
    "@modelcontextprotocol/sdk": "1.22.0",
    "@usemoney/logger": "*",
    "playwright": "^1.48.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@usemoney/typescript-config": "*",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
