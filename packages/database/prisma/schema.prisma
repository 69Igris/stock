// ============== PERSISTENT MARKET DATA ==============

// MONEY-1113 (Data Engine P10 F1) — company financials straight from the
// exchange's own XBRL, i.e. the filing itself rather than somebody's reading
// of it.
//
// ## Why this is a NEW table and not more rows in StockFinancials
//
// `StockFinancials` below is a DERIVED, reader-facing projection: five fixed
// buckets of Float?, keyed on (symbol, exchange, statementType, periodType,
// period) with NO source in the key. Writing XBRL into it would overwrite the
// Tickertape row for the same period — and overwriting is precisely what makes
// P10 F3's "validate against Tickertape, then switch readers over" impossible,
// because the two numbers would never coexist to be compared. You cannot
// reconcile against a value you just destroyed.
//
// It would also flatten what XBRL is actually good for. A filing carries far
// more than five buckets, it carries them with an explicit CONTEXT (period,
// entity, dimensions), and it says which taxonomy version defined each concept.
// Collapsing that to Float? at ingest throws away the provenance that makes the
// number defensible.
//
// So: F1 lands the filing HERE, verbatim-ish and per-filing. F3 projects from
// here into StockFinancials/StockRatios under a declared authority order — the
// same shape as the price-source precedence that fixed MONEY-1175, where the
// bug was likewise "two sources, no declared winner, last writer silently wins".
//
// ## Coverage starts ~April 2018, and that is a fact about NSE, not about us
//
// Filings before then carry a well-formed URL that ends in `/-` — it 404s, but
// it STARTS WITH "http", so a `startsWith('http')` validity check reports 100%
// coverage for every year back to 2012. Measured properly (`.endsWith('.xml')`)
// the real numbers are 0% through Feb-2018, 89% in May-2018, and 97–98% from
// 2019 on. F2's backfill window is scoped to that, and the stub-URL check is a
// golden test rather than a comment.
model XbrlFiling {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// The instrument this filing belongs to, when it could be resolved. NULLABLE
  /// on purpose: NSE's metadata gives us a symbol and usually an ISIN, and a
  /// filing whose issuer is not in `instrument_mappings` (a delisting, a fresh
  /// listing, a symbol change we have not yet aliased) is still a real filing
  /// worth keeping. Dropping it at ingest for want of a join would make the
  /// archive lie about what was published.
  instrumentId String?            @db.ObjectId
  instrument   InstrumentMapping? @relation(fields: [instrumentId], references: [id])

  /// NSE trading symbol as the filing metadata spells it.
  symbol   String
  exchange String  @default("NSE")
  /// From the metadata's `isin` field. The stabler join key — symbols change,
  /// ISINs do not — which is why both are kept rather than one.
  isin     String?

  /// QUARTERLY | HALF_YEARLY | NINE_MONTH | ANNUAL, normalised from the
  /// document's own reporting span.
  ///
  /// FOUR values as of MONEY-1114, not three. `classifyFilingPeriod`
  /// (xbrl-filing-index.ts) assigns them from the document's own span using
  /// bands WITH GAPS — a span outside every band is refused rather than
  /// rounded into the nearest one, which is how a 274-day nine-month YTD used
  /// to be stored as HALF_YEARLY and a 425-day transition year as ANNUAL.
  ///
  /// NINE_MONTH always carries `cumulative: true`, and that pairing is
  /// load-bearing: `judgeProjectionEligibility` keys on `cumulative` to refuse
  /// it (CUMULATIVE_IS_NOT_A_QUARTER). At `cumulative: false` only the span
  /// check would stand between nine months of revenue and a quarter cell.
  periodType  String
  /// The period the numbers describe, as a UTC-midnight range. START and END
  /// both stored because a quarterly filing and the nine-month cumulative that
  /// shares its end date are DIFFERENT facts — keying on the end date alone
  /// silently merges them, which is the cumulative-vs-discrete trap the
  /// metadata's own `cumulative` flag exists to flag.
  periodStart DateTime
  periodEnd   DateTime
  /// The metadata's `cumulative` flag, preserved. See above.
  cumulative  Boolean  @default(false)
  /// CONSOLIDATED | STANDALONE. Not a detail: consolidated revenue for a
  /// holding company can be a multiple of standalone, so charting them as one
  /// series produces a step change that looks like growth.
  basis       String

  /// Whether the numbers are audited or unaudited, as filed.
  audited   Boolean @default(false)
  /// The filer's own industry classification from the metadata (`indAs`,
  /// `bank`, `reInd` all inform how the tags must be read — banks and insurers
  /// use different tag variants for the same economic concept).
  filerKind String  @default("GENERIC")

  /// The taxonomy namespace version the document declared, e.g. "2020-03-31".
  /// Stored per filing because the namespace is DATE-VERSIONED and BSE-hosted
  /// even for NSE filings. A concept map keyed on one hardcoded version starts
  /// returning nothing the day NSE adopts the next one, and returns it as an
  /// empty result rather than an error.
  taxonomyVersion String

  /// The extracted canonical facts: concept id → value, with the context that
  /// scoped it. Json rather than columns because the concept set is defined by
  /// the taxonomy, not by us, and every new column would be a migration
  /// triggered by an upstream decision. The reader-facing FIXED shape is
  /// StockFinancials; this is the raw side of that seam deliberately.
  facts Json

  /// Which canonical concepts were actually found, so absence is VISIBLE.
  /// A filing that yielded revenue but no EPS must be distinguishable from one
  /// that yielded an EPS of zero — the recurring defect in this repo is a
  /// completeness signal computed at the wrong granularity, reported as
  /// success (MONEY-1189, five occurrences).
  conceptsFound String[]
  /// 0–1. Share of the canonical concept set that resolved for this filing.
  coverage      Float    @default(0)

  /// The archived XBRL URL this row was parsed from — provenance back to bytes.
  sourceUrl String
  /// When NSE broadcast the filing (metadata `broadCastDate`), distinct from
  /// when we ingested it.
  filedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// Identity is (issuer, period, basis, cumulative). `basis` is in the key
  /// because a company files BOTH consolidated and standalone for the same
  /// quarter and both are canonical; `cumulative` because the nine-month roll-up
  /// shares its periodEnd with Q3. Leaving either out does not raise an error —
  /// it silently keeps whichever landed last, which is the failure mode this
  /// key exists to prevent.
  ///
  /// `sourceUrl` is NOT in the key: it is provenance. If NSE re-publishes a
  /// corrected filing at a new URL, that must UPDATE the period, not fork it.
  /// MONEY-1220 — stamped when the projection has written this filing into
  /// StockFinancials. Stale-first cursor for xbrl-projection-daily; a filing
  /// whose write FAILED keeps a null stamp so the next run retries it, while
  /// one that was authority-blocked is stamped (it will never be written).
  projectedAt DateTime?

  @@unique([symbol, exchange, periodEnd, periodType, basis, cumulative])
  @@index([projectedAt])
  /// Hot read: one company's filings as a time series, newest first.
  @@index([symbol, exchange, periodEnd(sort: Desc)])
  /// ISIN join for the F3 projection and for issuers whose symbol has changed.
  @@index([isin])
  @@index([instrumentId])
  /// Ops sweep: "what did the F2 backfill actually land for 2019?" and the
  /// coverage report that decides whether a year is done.
  @@index([periodEnd(sort: Desc), coverage])
  @@map("xbrl_filings")
}

// MONEY-1105 (Data Engine P8a) — monthly portfolio disclosures filed by AMCs.
//
// SEBI requires every AMC to publish each scheme's full holdings monthly. This
// is that filing: authoritative, complete, and dated — as opposed to
// `FundHolding` above, which is an LLM extraction (`source: "gemini"`) carrying
// only `weightPercent`, keyed on (fundType, fundId, holdingName) with NO date.
//
// ## Why not just write into FundHolding
//
// Three reasons, any one sufficient:
//
//  1. FundHolding has no period in its key, so it is a CURRENT-SNAPSHOT table.
//     Writing twelve months of disclosures into it would have each month
//     overwrite the last, leaving one month present and eleven silently gone.
//  2. It has no quantity and no market value — only a percentage. The
//     disclosures carry all three, and quantity is what makes "did the fund
//     add or did the stock just go up?" answerable at all.
//  3. It backs a shipped feature (fund composition). Repointing its writer at a
//     different source mid-ticket changes that feature's behaviour as a side
//     effect, which is not what P8a was asked to do.
//
// So this table holds the filed history, and any future switchover of the
// composition feature onto it is a deliberate, separate change.
//
// ## Scheme identity is the hard part
//
// NOT ONE of the four AMC file shapes carries an AMFI scheme code — verified
// against real July-2026 files from SBI, ABSL, Nippon and HDFC. The only
// in-file identifier is the scheme NAME as the AMC writes it, and AMCs do not
// spell their own scheme names consistently across months. Hence `schemeName`
// stored verbatim, `schemeKey` as our normalised join handle, and
// `amfiSchemeCode` nullable and resolved separately — never invented here.
model MfPortfolioHolding {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// UTC midnight of the month the disclosure describes, anchored to the FIRST
  /// of the month. Month-end would have to guess 28/29/30/31 and moves under a
  /// leap year — the same call MacroSeries.period makes for monthly series, and
  /// made the same way so the two are joinable without a special case.
  period DateTime

  /// AMC id ("SBI" | "ABSL" | "NIPPON" | "HDFC" | "KOTAK"), from the fetcher,
  /// not the bytes — the file does not reliably name its own filer.
  amc String

  /// The scheme name EXACTLY as printed in the file. Verbatim on purpose: it is
  /// the only identifier present, so normalising it in place would destroy the
  /// evidence needed when a join fails.
  schemeName     String
  /// Normalised join handle derived from schemeName (case-folded, punctuation
  /// and plan/option suffixes stripped). Ours, not the AMC's — which is why it
  /// is a separate field and why a change to the normaliser is a backfill.
  schemeKey      String
  /// AMFI scheme code, when a mapping resolved. NULL is the honest and common
  /// case; it is NOT derivable from these files.
  ///
  /// PREFER `amfiSchemeCodes` when you need ALL of a scheme's plan variants.
  ///
  /// This column holds an ARBITRARY member of that array — `codes[0]`, i.e. AMFI
  /// FEED ORDER — and exists only because every reader was written against one
  /// code. It is NOT "the Direct Growth plan".
  ///
  /// This comment claimed it held "the PRIMARY (Direct + Growth where that is
  /// identifiable)" until 2026-09-14. **Nothing implemented that**, and the
  /// writer's own comment said the opposite, so the schema and the code were two
  /// spellings of one fact disagreeing — the defect class this table's other
  /// comments keep warning about. Picking Direct+Growth was DELIBERATELY not
  /// built: it would be a second, disagreeing implementation of a grouping
  /// `resolveSchemeCode` already performs, and it has no consumer that branches
  /// on which variant it is. A reader that genuinely needs a specific plan should
  /// look it up against `MutualFundMaster` at read time rather than trust a
  /// denormalised guess frozen at write time.
  ///
  /// There IS one consumer that renders it: `docs-section-logic.ts` builds
  /// `href: mfHref(amfiSchemeCode)` for the "funds holding this stock" section.
  /// That link lands on an arbitrary PLAN of the right scheme — never a wrong
  /// scheme — and all plans of a scheme share the filed portfolio.
  amfiSchemeCode String?

  /// Every AMFI code this scheme resolves to — MONEY-1294.
  ///
  /// AMFI splits one scheme into up to FOUR codes (Direct/Regular x
  /// Growth/IDCW) that share a single filed portfolio. Measured 2026-09-13:
  /// 435 of the 436 unresolved-as-ambiguous schemes are exactly that shape —
  /// every candidate normalises to the identical `schemeKeyOf`, so they are
  /// one fund, not several. A single `amfiSchemeCode` cannot represent them,
  /// which is why the resolver correctly refused rather than guessing: picking
  /// one would attribute a portfolio to a plan the user did not ask for, and
  /// nothing downstream could see it.
  ///
  /// ABSENT on all 54,248 pre-existing rows, so NEVER filter it with a bare
  /// `null` in either direction — on Mongo `{f: null}` and `{f: {not: null}}`
  /// BOTH return zero on a field a `db push` never created (MONEY-1050 / 1205 /
  /// 1234 / 1236). Read it with `{ has: code }`, which is absence-safe.
  amfiSchemeCodes String[] @default([])

  /// ISIN of the held instrument. Nullable — cash, TREPS, net receivables and
  /// several debt lines legitimately have none, and dropping those rows would
  /// make the weights fail to sum to 100.
  isin           String?
  /// The holding as printed.
  instrumentName String
  /// Our instrument, when the ISIN resolved. Nullable for the same reason as
  /// XbrlFiling.instrumentId — an unmatched holding is still a real holding.
  instrumentId   String?            @db.ObjectId
  instrument     InstrumentMapping? @relation(fields: [instrumentId], references: [id])

  /// EQUITY | DEBT | CASH | DERIVATIVE | REIT_INVIT | GOLD | OTHER, classified
  /// from the sheet section the row appeared under.
  holdingType String  @default("OTHER")
  /// Issuer industry as the AMC prints it. NOTE: SBI REVERSES the column order
  /// (Rating / Industry) relative to Nippon (Industry / Rating), so a
  /// position-based read swaps these two fields with no error and no warning.
  /// Matching is by normalised header, never by index.
  industry    String?
  /// Credit rating for debt lines ("CRISIL AAA"). Same reversal caveat.
  rating      String?

  /// Units/shares held. Nullable because cash-equivalent lines have no quantity.
  quantity     Float?
  /// Market value in ₹ LAKH — the AMCs' own unit, stored unconverted. Spelled
  /// "Lakhs" by SBI and "Lacs" by the others; same magnitude, and the parser
  /// asserts that rather than assuming it.
  marketValue  Float?
  /// Percent of the scheme's net assets. One concept, three upstream spellings
  /// ("% to NAV", "% to Net Assets", "% to AUM") collapsed here.
  percentToNav Float?

  /// The AMC file family this came from, for provenance back to the bytes.
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Identity is (month, scheme, holding). `isin` cannot be the holding half of
  /// the key — it is null for cash and several debt lines, and MongoDB treats
  /// missing as a value, so every null-ISIN row in a scheme would collide into
  /// one. `instrumentName` is always present, so it is the key.
  @@unique([period, amc, schemeKey, instrumentName])
  /// Hot read: one scheme's full portfolio for a month.
  @@index([schemeKey, period(sort: Desc)])
  @@index([amfiSchemeCode, period(sort: Desc)])
  @@index([amfiSchemeCodes, period(sort: Desc)])
  /// The reverse question, and the one worth having this table for: "which
  /// funds hold RELIANCE, and how did that change?"
  @@index([isin, period(sort: Desc)])
  @@index([instrumentId, period(sort: Desc)])
  /// Ops sweep: what did month M's ingest actually land, per AMC.
  @@index([period, amc])
  @@map("mf_portfolio_holdings")
}

// Stock Financials - Income statement, balance sheet, cash flow per period
model StockFinancials {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  instrumentId String            @db.ObjectId
  instrument   InstrumentMapping @relation(fields: [instrumentId], references: [id])
  symbol       String
  exchange     String

  statementType String // INCOME | BALANCE_SHEET | CASH_FLOW
  periodType    String // ANNUAL | QUARTERLY
  period        String // e.g. "2024", "Q3-2024"

  // Income Statement
  revenue         Float?
  grossProfit     Float?
  /// The non-operating income line, stored as its own value — MONEY-1250.
  ///
  /// Schedule III mandates "Revenue from operations" and "Other income" as
  /// SEPARATE line items and states their sum as Total income; the filing
  /// asserts that identity and it cross-foots to the rupee on every taxonomy
  /// family we carry. Keeping the component means neither convention has to be
  /// chosen destructively:
  ///
  ///     operations-only EBITDA = ebitda - otherIncome
  ///     inclusive       EBITDA = ebitda
  ///
  /// MONEY-1249 finding 2 was otherwise a ONE-WAY choice between them on a
  /// column whose @@unique carries no `source`, i.e. the first XBRL write
  /// destroys the value it replaced. Sized on prod: other income is p50 12.1%
  /// of our ebitda, moves 56% of filings by >10%, and FLIPS THE SIGN of 368
  /// (6.5%). Storing it turns the definition into a reversible display choice.
  otherIncome     Float?
  operatingIncome Float?
  netIncome       Float?
  ebitda          Float?

  /// ── OUR figures, stored beside the vendor's rather than over them ──────
  ///
  /// MONEY-1255. `revenue`, `operatingIncome` and `ebitda` above are the
  /// VENDOR's columns and the XBRL projection no longer owns any of them (see
  /// `UNOWNED_VENDOR_COLUMNS` in packages/core/src/market-data/
  /// xbrl-projection.ts). The three columns below carry OUR reading of the
  /// same filings, so both definitions coexist and the F3 switchover destroys
  /// neither. That matters here more than elsewhere: this model's `@@unique`
  /// carries no `source`, so a write over the vendor's cell is unrecoverable.
  ///
  /// They are named for WHAT THEY MEASURE, never for where they came from. A
  /// `*Xbrl` suffix would tell a reader the provenance — which `source`
  /// already carries — and nothing about why the number differs from the
  /// column beside it, which is the only question anyone comparing them has.
  ///
  /// ## ABSENT, not null, on every pre-existing row
  ///
  /// A Mongo `prisma db push` creates INDEXES, never FIELDS, so all ~32,359
  /// rows written before this change carry no such attribute at all. Prisma's
  /// Mongo connector does not treat absent as null, so BOTH `{f: null}` and
  /// `{f: {not: null}}` return ZERO rows. Any query that filters on one of
  /// these must spell it `OR: [{f: null}, {f: {isSet: false}}]`, or use a raw
  /// `$exists`. This class has caused MONEY-1050, MONEY-1205, MONEY-1234 and
  /// MONEY-1236; it is written here so it cannot cause a fifth.
  ///
  /// ## `null` means UNSOURCED — never zero
  ///
  /// An absent value here says the filing did not let us compute the figure.
  /// It must never be written as 0: `ebitdaBeforeExceptionalItems = 0` is a
  /// factual claim about the company that a screen would act on. The additive
  /// COMPONENTS inside the projection still treat a missing part as 0 where
  /// absence genuinely means zero (`sumPresent`) — that is a measurement; this
  /// is an outcome, and the two get opposite defaults.
  ///
  /// Revenue from operations, EXCLUDING other income — the Schedule III line
  /// item of that exact name, read straight off the filing's
  /// `RevenueFromOperations` concept (or a lender's `InterestEarned`). The
  /// vendor's `revenue` above is TOTAL INCOME, i.e. this plus `otherIncome`;
  /// the F3 gate reconstructs one from the other on 2,529 of 4,772 comparable
  /// annual pairs, which is what established that the gap is definitional
  /// rather than a data error on either side.
  revenueFromOperations Float?

  /// EBIT computed on revenue from operations only: `revenueFromOperations -
  /// totalExpenses + financeCosts` (a lender's `operatingProfitBeforeProvisions`).
  /// AFTER depreciation, which is an operating cost of the assets that produced
  /// the revenue, and BEFORE finance costs, which are a financing charge.
  ///
  /// The vendor's `operatingIncome` above is EBIT INCLUDING other income; the
  /// gate reconstructs theirs as `ours + otherIncome` on 3,014 of 4,462
  /// comparable pairs. Named `…ExOtherIncome` rather than plain
  /// `operatingIncome` precisely because the plain column sits three lines up
  /// meaning something else.
  operatingIncomeExOtherIncome Float?

  /// `profitBeforeTax + financeCosts + depreciationAndAmortisation`, LESS any
  /// exceptional items the filing declares (`exceptionalAdjustment`).
  ///
  /// ## Why NOT `ebitdaExOtherIncome`
  ///
  /// Because that name would be false in both halves. This figure is derived
  /// from PBT, and PBT is struck AFTER other income, so ours INCLUDES other
  /// income — it is the vendor's `ebitda` that is operations-only. The gate
  /// measures the direction directly: `ours - otherIncome` reconstructs the
  /// vendor on 66 pairs, while `ours + exceptionalItems` reconstructs it on
  /// 824. So EXCEPTIONAL ITEMS, not other income, are the dominant difference,
  /// and "before exceptional items" is both the accurate description and a
  /// standard published measure (screener.in excludes them too).
  ///
  /// The exclusion is not cosmetic: a -30,711 Cr AGR provision turned a
  /// +8,928 Cr EBITDA into -21,783 Cr, feeding `ebitdaMargin` at -103%.
  /// `otherIncome` above remains the component that makes the operations-only
  /// reading recoverable — `ebitdaBeforeExceptionalItems - otherIncome` —
  /// without a second write path.
  ebitdaBeforeExceptionalItems Float?

  // Balance Sheet
  totalAssets      Float?
  totalLiabilities Float?
  totalEquity      Float?
  totalDebt        Float?
  totalCash        Float?

  // Cash Flow
  operatingCashFlow  Float?
  capitalExpenditure Float?
  freeCashFlow       Float?

  /// UTC end-of-period, when the source supplies one. Tickertape sends
  /// `endDate` on EVERY row including the `TTM` row; `period` is a free-text
  /// LABEL and does not sort ("TTM" has no year, so a label sort files the
  /// freshest figure in the oldest column). This is the sortable key.
  /// MONEY-1207.
  periodEnd DateTime?

  /// CONSOLIDATED | STANDALONE — whose accounts these figures are (MONEY-1235).
  ///
  /// A company files BOTH for the same period and they differ by a MULTIPLE for
  /// any holding company (360ONE FY2025 totalAssets: 19,768 Cr consolidated
  /// against 7,332 Cr standalone). `XbrlFiling` keeps both because its key
  /// carries `basis`; THIS key does not, so one row holds one of them and,
  /// until now, said nothing about which. Written by the XBRL projection on
  /// every create and update.
  ///
  /// DELIBERATELY NOT IN @@unique — adding it would make consolidated and
  /// standalone two rows for one period, which every reader (research tools,
  /// the Financials tab, the reconcile gate) would then double-count while
  /// looking entirely normal.
  ///
  /// NEVER FILTER THIS WITH `basis: null`. On MongoDB a `db push` creates
  /// indexes, never fields, so the attribute is ABSENT — not null — on all
  /// ~32,359 pre-existing rows and on every row the projection has not yet
  /// rewritten. Prisma's Mongo connector does not treat absent as null, so both
  /// `{basis: null}` and `{basis: {not: null}}` return ZERO. Use
  /// `OR: [{basis: null}, {basis: {isSet: false}}]`, or raw `$exists`. This
  /// class has now caused MONEY-1050, MONEY-1234 and MONEY-1235.
  ///
  /// It is provenance for READERS, never a guard: the projection's own
  /// basis-downgrade check reads `rawData.xbrl.filing.basis` precisely because
  /// that has been populated since the first projection write, while this
  /// column is absent on exactly the rows the guard has to protect.
  basis String?

  rawData Json? // Raw source payload. ALSO holds `displacedByXbrl` — the
  // DisplacementRecord a projection write leaves behind (packages/core/src/
  // market-data/xbrl-projection.ts). Overwriting this column destroys the only
  // copy of what the previous source said.

  // Provenance AND precedence. Ranked by FINANCIALS_AUTHORITY:
  //   NSE_XBRL > TICKERTAPE > SCREENER > YAHOO   (an unknown value ranks LAST,
  //   so a new upstream can only ever fill a gap.)
  // Deliberately NOT in the @@unique below: two sources describing one period
  // are ONE row, so a write does not duplicate — it ERASES. Every writer must
  // therefore call mayOverwriteFinancials(<its source>, incumbent?.source)
  // before an upsert/update/create. An `update:` that rewrites values without
  // touching this column leaves the row asserting a provenance it no longer has
  // (MONEY-1175 / MONEY-1198 / MONEY-1204). Enforced by a source scan:
  // packages/core/__tests__/market-data/financials-write-authority.test.ts
  source    String   @default("TICKERTAPE")
  fetchedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, exchange, statementType, periodType, period])
  @@index([instrumentId])
  @@index([symbol, exchange])
  @@index([fetchedAt])
  @@index([symbol, exchange, statementType, periodType, periodEnd(sort: Desc)])
  @@map("stock_financials")
}

// Stock Ratios - Latest ratios snapshot (upserted daily)
model StockRatios {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  instrumentId String            @unique @db.ObjectId
  instrument   InstrumentMapping @relation(fields: [instrumentId], references: [id])
  symbol       String
  exchange     String

  // Valuation
  pe         Float?
  pb         Float?
  evToEbitda Float?
  pegRatio   Float?

  // Profitability
  roe             Float?
  roa             Float?
  /// WHICH denominator `roe` and `roa` used — MONEY-1250.
  ///
  /// "AVERAGE" = (closing + prior closing) / 2, the vendor's convention and the
  /// right one for a flow-over-stock ratio. "CLOSING" = point-in-time, used when
  /// the symbol has no ADJACENT prior annual filing.
  ///
  /// Stored rather than chosen. Measured on prod: CLOSING reproduces the vendor
  /// 45.3% of the time, AVERAGE 89.5% (92.5% consolidated), so a reconcile that
  /// cannot tell them apart is judging a mixture and blaming the data. The gate
  /// should compare only AVERAGE rows.
  ///
  /// ABSENT on every pre-existing row — a Mongo `db push` creates indexes, not
  /// fields. NEVER filter it with `returnBasis: null` (MONEY-1050/1234/1236);
  /// use `{ isSet: false }` or a positive `in` list.
  returnBasis     String?
  roce            Float?
  grossMargin     Float?
  operatingMargin Float?
  netMargin       Float?

  // Growth (YoY %)
  revenueGrowth    Float?
  earningsGrowth   Float?
  revenueGrowth3Y  Float?
  earningsGrowth3Y Float?
  revenueGrowth5Y  Float?
  earningsGrowth5Y Float?

  // Leverage
  debtToEquity     Float?
  currentRatio     Float?
  interestCoverage Float?

  // Market
  beta            Float?
  dividendYield   Float?
  marketCap       Float?
  enterpriseValue Float?

  // Analyst
  /// MONEY-1220. Computed by `deriveRatios` since MONEY-1115 but with no column
  /// to land in, so the producer reported them under `computedButUnstorable`.
  ebitdaMargin  Float?
  assetTurnover Float?

  /// Sell-side ANALYST OPINION — the only two columns on this model that are
  /// NOT derivable from a filing or our own price history. Deliberately left
  /// null since MONEY-1220 rather than scraped: a number a reader cannot trace
  /// to a filing id does not belong beside 26 that they can.
  targetPrice    Float?
  recommendation String? // BUY | HOLD | SELL

  /// MONEY-1220 — the two clocks this row runs on.
  ///
  /// Filing-dependent columns (margins, growth, the CAGRs, current ratio) only
  /// change when a NEW filing lands; price-dependent ones (pe, pb, marketCap,
  /// enterpriseValue, evToEbitda, dividendYield, pegRatio, beta) change every
  /// close. Storing both stamps makes "why did this row change today" answerable
  /// and lets the daily job skip the expensive half when the filing is the same.
  ratiosFilingId  String?   @db.ObjectId
  ratiosPriceDate DateTime?
  /// Stale-first cursor for the nightly derive. Ordering by this ASC puts
  /// never-derived rows first and moves a freshly-written row to the back — the
  /// same fix MONEY-1211 needed when a constant sort handed every run the same
  /// 100 instruments forever.
  ratiosDerivedAt DateTime?

  rawData   Json?
  // Same FINANCIALS_AUTHORITY ranking as StockFinancials.source
  // (NSE_XBRL > TICKERTAPE > SCREENER > YAHOO; unknown ranks last), and the same
  // rule: guard every write with mayOverwriteFinancials.
  // The exposure here is LARGER, not smaller. @@unique([symbol, exchange]) means
  // ONE row per symbol with no period dimension, so an unguarded write replaces
  // the symbol's ENTIRE ratio set — and `ratios-sync-daily` runs 23:30 IST
  // Mon-Fri, against the weekly cadence of the financials pass (MONEY-1204).
  source    String   @default("TICKERTAPE")
  fetchedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, exchange])
  /// Serves the nightly stale-first select. Without it that ORDER BY is a
  /// collection scan over every ratio row, every night.
  @@index([ratiosDerivedAt])
  @@index([pe])
  @@index([roe])
  @@index([marketCap])
  @@index([fetchedAt])
  // MONEY-1129 - the screener's ratios-first path
  // (packages/services/src/screener.service.ts, ratiosFirstPath) builds $gte/$lte
  // ranges for exactly six ratio fields; `pe`, `roe` and `marketCap` were already
  // indexed, these three were not, so filtering on them scanned the collection.
  // All three are continuous floats (high cardinality), so a range on them is
  // selective enough to earn the index. `exchange` is deliberately NOT indexed -
  // it is issued as an equality filter but only ever holds NSE/BSE, so an index
  // would cost writes and halve nothing.
  @@index([dividendYield])
  @@index([debtToEquity])
  @@index([revenueGrowth])
  @@map("stock_ratios")
}

// Stock Peers - Peer comparison data
model StockPeers {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  instrumentId String            @unique @db.ObjectId
  instrument   InstrumentMapping @relation(fields: [instrumentId], references: [id])
  symbol       String
  exchange     String

  peers     Json[] // Array of { symbol, name, pe, roe, marketCap, ... }
  peerCount Int      @default(0)
  source    String   @default("TICKERTAPE")
  fetchedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, exchange])
  @@map("stock_peers")
}

// Stock Shareholding - Quarterly shareholding pattern
model StockShareholding {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  instrumentId String            @db.ObjectId
  instrument   InstrumentMapping @relation(fields: [instrumentId], references: [id])
  symbol       String
  exchange     String

  /// Tickertape's label, stored VERBATIM. Measured on prod 2026-08-16 every
  /// row uses the month-name form ("Jun 2026", "Sep 2025") — NOT the
  /// "Q3-2024" this comment claimed for a year. It is free text and is NOT
  /// lexicographically sortable: alphabetically "Sep 2020" outranks
  /// "Jun 2026". Rank it with `quarterSortRank` (which understands this form),
  /// never with an `orderBy`. Distinct from `ShareholdingPattern.quarter`,
  /// which is NSE's and IS canonicalised to "YYYY-MM".
  quarter        String
  promoter       Float? // % held by promoters
  fii            Float? // % held by FIIs
  dii            Float? // % held by DIIs
  public         Float? // % held by public
  pledgedPercent Float? // % of promoter shares pledged

  rawData   Json?
  source    String   @default("TICKERTAPE")
  fetchedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, exchange, quarter])
  @@index([instrumentId])
  @@map("stock_shareholding")
}

// Stock News - Accumulated news articles for stocks
model StockNews {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  instrumentId String?            @db.ObjectId
  instrument   InstrumentMapping? @relation(fields: [instrumentId], references: [id])
  symbol       String

  title     String
  link      String
  pubDate   DateTime?
  source    String // "GOOGLE_NEWS" | "ECONOMIC_TIMES" | etc.
  snippet   String?
  sentiment String? // POSITIVE | NEGATIVE | NEUTRAL

  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())

  /// US articles are NOT in this table — see `UsStockNews`.

  @@unique([symbol, link])
  @@index([symbol, pubDate])
  @@index([fetchedAt])
  @@map("stock_news")
}

/// US news — MONEY-1264, split out of `stock_news`.
///
/// The split follows the table-sharing rule in packages/database/CLAUDE.md:
/// `stock_news` is unique on `(symbol, link)`, so the market discriminator is
/// NOT in the key, and its four India readers filter on `symbol` alone. Both
/// halves of the rule fail, so the tables separate.
///
/// This model previously WAS a `market` column on `stock_news`, defended on the
/// grounds that a wrong news row is "informational — a wrong paragraph" where a
/// wrong corporate action is a wrong tax number. That severity argument is
/// true and it is not a schema rule: it decides how BADLY a shared table fails,
/// never whether it does. With 214 measured India/US ticker collisions, ACC
/// Cement's news card would carry Atlas Air Worldwide's headlines — and the
/// `market` column could not prevent it, because the readers that would have to
/// check it were written before the column existed and do not.
model UsStockNews {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  symbol      String
  /// Tiingo's durable security id where the article's ticker resolved to one.
  permaTicker String?

  title     String
  link      String
  pubDate   DateTime?
  source    String // "TIINGO" | ...
  snippet   String?
  sentiment String? // POSITIVE | NEGATIVE | NEUTRAL

  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([symbol, link])
  @@index([symbol, pubDate])
  @@index([permaTicker, pubDate])
  @@index([fetchedAt])
  @@map("us_stock_news")
}

/// US news, ARTICLE-LEVEL — MONEY-1309.
///
/// The successor store to `UsStockNews`, and the reason it is a second table
/// rather than an edit to the first one is a KEY, not a preference.
///
/// `us_stock_news` is `@@unique([symbol, link])`. That was a deliberate
/// MONEY-1264 anti-collision choice and it remains correct for what it does:
/// the shared `stock_news` is unique on the same pair with no market
/// discriminator, its four India readers filter on `symbol` ALONE (they predate
/// any `market` column), and there are 214 measured India/US ticker collisions
/// — so a shared table would have put Atlas Air's headlines on ACC Cement's
/// news card and no column could have stopped it.
///
/// What that key CANNOT do is describe an article. One story mentioning five
/// companies becomes FIVE rows there, each carrying a full copy of the title,
/// url, publisher and snippet, and none of them able to say "these five are one
/// story". Three things follow and all three are wanted:
///
///   - "this article mentions 5 companies" is unrepresentable. The fan-out is
///     the storage model, so the relationship is gone by the time it is stored.
///   - DEDUPLICATION is impossible. Wire stories are re-published verbatim by
///     a dozen outlets under a dozen urls; with `link` in the key each is a
///     distinct row per ticker, and there is no article identity to group on.
///   - Counting is a trap. "How much news did AAPL get" and "how many stories
///     ran" are different questions with the same answer shape, and the
///     symbol-keyed table can only answer the first.
///
/// So this table keys on `tiingoId` — Tiingo's OWN article id, one row per
/// article — and carries the tickers as a validated array. `UsStockNews` is
/// left ENTIRELY ALONE: not dropped, not migrated, not written to by the new
/// poller, and its own writer's data stays where it is. It is read-only legacy
/// until its readers move over, and this comment is the whole of the migration
/// plan — there is no dual-write, because a dual-write is two sources of truth
/// with a race between them.
model UsNewsArticle {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// Tiingo's own article id, and the ONLY unique on this model.
  ///
  /// A NUMBER in the live payload, not a string — measured 2026-08-28, and
  /// `parseNewsResponse` types it as such. It is the upsert key, which is what
  /// makes the 2-minute poller idempotent: the overlap window below re-fetches
  /// articles this job has already seen ON PURPOSE, so the SAME article
  /// arriving for the fifth time must write once and not five times.
  ///
  /// NOT `url`. Two different Tiingo articles have been observed at one url
  /// (a publisher updating a story in place), and a url is a string we do not
  /// control the normalisation of — trailing slash, utm parameters, http vs
  /// https. `tiingoId` is upstream's identity claim and it is the one thing on
  /// the row that upstream guarantees.
  tiingoId Int @unique

  title String
  url   String
  /// The SNIPPET Tiingo sends, never a fetched article body.
  ///
  /// This column is the entire text footprint of the feed and it stays that
  /// way. The poller does not fetch the article, does not follow `url`, and
  /// stores no body/content field — deliberately, and asserted by a test rather
  /// than left as an intention: a full-text store of other people's journalism
  /// is a licensing question, not a schema question, and the answer changes
  /// nothing about what this feed is FOR (headlines, tickers, timing).
  description String?

  /// When the PUBLISHER published it.
  publishedAt DateTime
  /// When TIINGO crawled it. The cursor column — see `UsNewsCursor`.
  ///
  /// Both dates are stored because they are genuinely different facts and the
  /// gap between them is the thing the poller exists to shrink: an article can
  /// be published at 14:00 and crawled at 14:03, or crawled hours late. Sorting
  /// a feed by `crawlDate` shows our pipeline's order; sorting by `publishedAt`
  /// shows the world's. A reader wants the second; the cursor needs the first.
  crawlDate DateTime

  /// The PUBLISHER's domain (`prnewswire.com`), not a feed name.
  ///
  /// Same column semantics as `UsStockNews.source` and the same caveat: India's
  /// `stock_news.source` holds a FEED name (`GOOGLE_NEWS`), so the two tables
  /// spell one column two ways. `feedSource` below is what answers the
  /// provenance question here, which is why this one is free to be the more
  /// useful fact.
  source String

  /// Tickers that RESOLVED against `us_instruments`, uppercased and deduped.
  ///
  /// VALIDATED, never raw. Tiingo tags articles with things that are not
  /// securities we carry — `tech`, `ai`, crypto, OTC symbols — and its
  /// `tickers[]` REPEATS ITSELF (measured: 79 of 200 market-wide rows). An
  /// unvalidated array joins to nothing and is visible only as an inflated
  /// count; the dropped ones are COUNTED in the job outcome instead of being
  /// silently discarded, because "Tiingo names symbols we do not carry" and
  /// "our master lookup is broken" produce the identical empty array and send
  /// an operator to two different systems.
  ///
  /// An EMPTY array is a completely normal row — measured, 15 of 32 articles in
  /// one market-wide day carried no tickers at all (macro and general-business
  /// stories). Storing them is the point of an article-level table: they are
  /// real market news that the symbol-keyed table could not represent, because
  /// a row there needs a symbol to exist.
  tickers String[] @default([])
  /// Tiingo's own topic tags, verbatim and unvalidated (`earnings`, `tech`).
  /// Not a controlled vocabulary and not joined to anything — kept because it
  /// is free on the wire and a later classifier would otherwise have to re-poll
  /// three months of history to get it.
  tags String[] @default([])

  /// A normalized-title fingerprint, for FUTURE dedup. Written, not yet read.
  ///
  /// Wire copy is republished verbatim under many urls and many `tiingoId`s, so
  /// `tiingoId` — correctly — does not collapse them. `clusterKeyFor` lowercases,
  /// strips punctuation and stopwords, and hashes what is left, so the same
  /// story from four outlets lands on one key.
  ///
  /// Stored rather than computed at read time because it must be STABLE: the
  /// normaliser is versioned by its own constant, and a key computed on the fly
  /// would silently re-cluster the whole table the day that function changes.
  /// Nothing reads it yet, and it is deliberately NOT unique — collapsing on
  /// insert would DELETE the sibling copies whose existence is the signal
  /// ("this story ran in twelve places") that a future ranker wants.
  clusterKey String

  /// "US". Present so this table can take a second market without a migration,
  /// and matched POSITIVELY by every reader: on Mongo an attribute absent from
  /// a pre-existing row makes both `{market: null}` and `{market: {not: null}}`
  /// return ZERO (MONEY-1050 / 1205 / 1234 / 1236). A default cannot backfill
  /// rows that already exist — `db push` creates indexes, not fields — so the
  /// table starting empty is what makes this one safe.
  market String @default("US")
  /// Which upstream supplied it. Distinct from `source`, which is the
  /// publisher: a second news vendor carrying the same prnewswire story is a
  /// different `feedSource` and the same `source`.
  feedSource String @default("TIINGO")

  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// `publishedAt` DESC is the feed query — the only ordering a reader wants.
  @@index([publishedAt])
  /// Mongo indexes an array field per ELEMENT, so this serves
  /// `tickers: { has: "AAPL" }` — the per-symbol news card, which is the query
  /// `us_stock_news` existed to serve and the one that has to be as fast here
  /// before anything can migrate.
  ///
  /// THE MATCH ALONE IS NOT THE QUERY. The card is
  /// `where {tickers: {has: SYM}} orderBy {publishedAt: desc}`, and two
  /// SINGLE-FIELD indexes cannot serve both halves: Mongo picks one, matches on
  /// it, and then performs a BLOCKING in-memory sort of every article that ever
  /// named that symbol. There is no `allowDiskUse` on a `find`, so that sort is
  /// capped at 32 MB and fails the whole query rather than degrading. The
  /// predecessor `UsStockNews` carries a compound `@@index([symbol, pubDate])`
  /// for exactly this reason, and dropping to two singles on the replacement
  /// was a regression that nothing would surface until a heavily-covered
  /// symbol accumulated enough history.
  ///
  /// MongoDB permits ONE array field per compound index, so `tickers` leading
  /// is legal and `prisma validate` accepts it.
  ///
  /// STATED HONESTLY: this is a HYPOTHESIS, not a measurement. `usNewsArticle`
  /// has exactly one callsite repo-wide today — the poller's upsert — so there
  /// is no reader to profile and no before/after number to quote. It is added
  /// now because an index is cheap on an empty table and a migration is not,
  /// and because the shape of the query is already fixed by the card it is
  /// meant to serve.
  @@index([tickers, publishedAt])
  @@index([clusterKey])
  /// The poller's own cursor query and its lag monitor.
  @@index([crawlDate])
  @@map("us_news_articles")
}

/// Poller watermark for the article feed — MONEY-1309.
///
/// Shaped after `UsEdgarCursor` (keyed, nullable watermarks, free-form `meta`)
/// for the same reason: one row per stream, so a second feed is a new `key`
/// rather than a new table.
///
/// ## The cursor is deliberately NOT a strict `> lastCrawl`
///
/// `crawlDate` is TIINGO'S clock, stamped when Tiingo's crawler reached the
/// article — not ours, and not monotonic with respect to our polling. Articles
/// are crawled LATE and out of order: a story published at 14:00 can be crawled
/// at 14:03 and another published at 13:58 crawled at 14:05. A strict
/// `> lastCrawl` boundary asks for everything after the newest thing it has
/// seen, so anything that lands with a crawlDate BELOW that high-water mark
/// after the cursor moved is never selected again. Not delayed — dropped, once,
/// permanently, with no error and no gap that any count can see.
///
/// So every poll re-asks for an OVERLAP window ending at now and starting at
/// `lastCrawl - overlap`. The overlap is pure waste by construction and that is
/// the trade: at a 2-minute cadence the same articles come back a handful of
/// times, the upsert on `tiingoId` absorbs every repeat at the cost of one
/// no-op write, and the alternative to that waste is silent permanent loss.
/// `planNewsCursor` owns the arithmetic and its default is documented there.
///
/// A NULL `lastCrawlDate` is a first run, not an error: the plan floors at
/// Tiingo's own 90-day cliff, which the client refuses to cross in either
/// direction (a pre-floor request returns HTTP 200 with rows from the floor
/// date, so it cannot be discovered as a failure).
model UsNewsCursor {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// Stream id, e.g. `tiingo-news`. One row per feed.
  key String @unique

  /// Newest `crawlDate` this job has WRITTEN. The overlap is subtracted from
  /// it, never added — see the model comment.
  ///
  /// Advanced only from articles that actually landed. Stamping it from the
  /// window we ASKED for would move the watermark past articles a failed write
  /// never stored, which is the "stamped-never-created" shape MONEY-1235 had to
  /// unpick by hand.
  lastCrawlDate DateTime?
  /// Wall clock of the last completed run, for liveness. A 24x7 poller that
  /// stops is invisible in the article table alone — a quiet market and a dead
  /// job both write nothing.
  lastRunAt     DateTime?

  /// `{articles, written, droppedTickers, windowStart, windowEnd}` — free-form,
  /// same as `UsEdgarCursor.meta`, because each stream watermarks differently.
  meta Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("us_news_cursor")
}

// Stock Profile - Company profile information
model StockProfile {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  instrumentId String            @unique @db.ObjectId
  instrument   InstrumentMapping @relation(fields: [instrumentId], references: [id])
  symbol       String
  exchange     String

  name        String
  sector      String?
  industry    String?
  description String?
  website     String?
  employees   Int?
  marketCap   Float?
  founded     String?

  source    String   @default("YAHOO")
  fetchedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, exchange])
  @@map("stock_profiles")
}

// Stock Document - Financial documents (PDFs, formatted data) stored in GCS for RAG
// System-level (no userId) - shared across all users, per-instrument
model StockDocument {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  instrumentId String            @db.ObjectId
  instrument   InstrumentMapping @relation(fields: [instrumentId], references: [id])
  symbol       String
  exchange     String

  // Document identity
  docType     String // annual_report | quarterly_result | financial_statement | corporate_filing
  period      String // "2024", "Q3-2024", "FY2024-25"
  title       String
  description String?

  // Source
  sourceUrl  String? // Original URL (NSE attachment, etc.)
  sourceType String // NSE | SCREENER | TICKERTAPE

  // Storage
  gcsPath  String // stocks/{SYMBOL}/{docType}/{filename}
  fileSize Int    @default(0)
  mimeType String @default("application/pdf")

  // Processing
  processingStatus String  @default("PENDING") // PENDING | PROCESSING | READY | FAILED | UNSUPPORTED
  textContent      String? // Extracted text (capped ~100KB)
  isEmbedded       Boolean @default(false)
  embeddingCount   Int     @default(0) // Number of chunks embedded

  /// ── The FINANCIALS-PARSE lane — MONEY-1255 ────────────────────────────
  ///
  /// Deliberately SEPARATE from `processingStatus`, which tracks the RAG-text
  /// lane (Document AI / pdf-parse → `textContent` → embeddings). The two are
  /// different jobs with different costs, different failure modes and
  /// different downstream consumers, and a document routinely succeeds at one
  /// while failing the other: a scanned annual report yields fine text for
  /// retrieval and no reliable statement table, and a machine-readable filing
  /// parses to figures whether or not anyone has embedded it. Folding them
  /// into one column would make either state unreadable.
  ///
  /// PENDING | PROCESSING | PARSED | FAILED | FAILED_VALIDATION | UNSUPPORTED
  ///
  /// ## `isSet: false`, NOT null, on all ~43,105 existing rows
  ///
  /// A Mongo `prisma db push` creates INDEXES, never FIELDS. Every row written
  /// before this change carries NO such attribute, and Prisma's Mongo
  /// connector does not treat absent as null — so the selection query
  /// `{ parseStatus: "PENDING" }` matches ZERO of them despite the
  /// `@default`, which applies only to rows Prisma itself creates. The worker
  /// MUST select
  /// `OR: [{ parseStatus: "PENDING" }, { parseStatus: { isSet: false } }]`
  /// (or a one-time raw `$set` backfill must run first). This class has caused
  /// MONEY-1050, MONEY-1205, MONEY-1234 and MONEY-1236; a fifth here would be
  /// invisible, because "no documents to parse" and "the whole backlog is
  /// unreachable" produce the identical log line.
  /// OPTIONAL, and that is load-bearing — MONEY-1256.
  ///
  /// This shipped as `String @default("PENDING")` and the parse job threw
  /// `PrismaClientValidationError` on EVERY run: Prisma's `isSet` filter exists
  /// only on OPTIONAL fields, so the selector this field's own doc comment
  /// mandates — `OR: [{parseStatus:"PENDING"}, {parseStatus:{isSet:false}}]` —
  /// was invalid against a required field. The comment and the declaration
  /// contradicted each other, and the declaration lost silently: the job
  /// returned 200, logged its cohort split, threw, and wrote nothing.
  ///
  /// `@default` applies only to rows PRISMA creates, so the field is genuinely
  /// ABSENT on the 43,233 documents written before it existed. Optional is
  /// therefore the honest declaration: it describes the data as it actually is,
  /// and it is what makes `isSet: false` legal. Backfilling the rows instead
  /// would not have helped — Prisma rejects the query SHAPE before it ever
  /// looks at data.
  parseStatus String?   @default("PENDING")
  parsedAt    DateTime?

  /// Which path produced the extracts on this row — MONEY-1314.
  ///
  /// "markdown" = page-selected markdown through `parseFromMarkdown`;
  /// "pdf" = the whole-PDF vision call, either because the document is
  /// scanned-only or because the markdown attempt failed validation and took
  /// the single retry. Provenance for the pilot report and for judging the
  /// markdown path in production; NEVER a selector — see the isSet note on
  /// `parseStatus`, which applies verbatim to every field in this block.
  parsePath String?

  /// The batch job that carries this row, while `parseStatus` is "BATCHED".
  /// Absent on every pre-existing row, so any selection over it needs the
  /// `{ isSet: false }` arm.
  batchJobId String?

  /// ── The CONVERSION lane — MONEY-1314 ──────────────────────────────────
  ///
  /// PDF → markdown once, on CPU, feeding BOTH the RAG-text lane and the
  /// financials lane. Separate from `processingStatus` and `parseStatus` for
  /// the same reason those two are separate from each other: a document can
  /// convert cleanly and still fail to parse, and a scanned document fails to
  /// convert while remaining perfectly extractable through Document AI.
  ///
  /// PENDING | CONVERTED | SCANNED_ONLY | FAILED
  ///
  /// ## `isSet: false`, NOT null, on all ~79,884 existing rows
  ///
  /// The same trap `parseStatus` documents above, and it is repeated here in
  /// full rather than cross-referenced because the cost of missing it is a
  /// silent empty backlog. A Mongo `prisma db push` creates INDEXES, never
  /// FIELDS. Every row written before this change carries NO such attribute,
  /// Prisma's Mongo connector does not treat absent as null, and `@default`
  /// applies only to rows Prisma itself creates. So
  /// `{ convertStatus: "PENDING" }` matches ZERO of the existing corpus and
  /// the conversion backfill would report "nothing to convert" while 79,884
  /// documents sat unreachable. Every selection MUST carry
  /// `OR: [{ convertStatus: "PENDING" }, { convertStatus: { isSet: false } }]`.
  ///
  /// OPTIONAL is load-bearing, exactly as it is for `parseStatus`: Prisma's
  /// `isSet` filter exists only on optional fields, so declaring this
  /// `String @default(...)` would make the mandated selector a validation
  /// error at query-build time — the MONEY-1256 shape, where the comment and
  /// the declaration contradict each other and the declaration wins silently.
  ///
  /// This class has caused MONEY-1050, MONEY-1205, MONEY-1234 and MONEY-1236.
  convertStatus    String?   @default("PENDING")
  /// `${gcsPath}.md` — the sidecar pattern `.extracted.txt` already uses.
  /// Derived from the STORED path, never recomputed from symbol/docType/period:
  /// `buildFullDocPath`'s filename sanitizer strips `.` and `-` while the
  /// directory sanitizer keeps them, so a recomputed key is not guaranteed to
  /// land beside the object it belongs to.
  markdownGcsPath  String?
  scannedPageCount Int?
  textPageCount    Int?
  convertedAt      DateTime?

  /// Readings produced from this document by the Gemini parse worker — one per
  /// (period, basis), so an annual report typically yields ~4.
  financialExtracts DocumentFinancialExtract[]

  // Staleness
  fetchedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, exchange, docType, period])
  @@index([instrumentId])
  @@index([symbol, exchange])
  @@index([processingStatus])
  /// The parse worker selects on this and orders by `fetchedAt` ASC, so the
  /// compound index is the one that serves the query — a bare index on
  /// `parseStatus` would still leave a blocking in-memory SORT.
  @@index([parseStatus, fetchedAt])
  /// The conversion backfill selects on `convertStatus` and orders by
  /// `fetchedAt` ASC — same reasoning as the `parseStatus` compound above: a
  /// bare index would leave a blocking in-memory sort over ~80k rows.
  @@index([convertStatus, fetchedAt])
  @@index([fetchedAt])
  @@map("stock_documents")
}

/// Figures read out of a filed DOCUMENT (an annual report or results PDF) by
/// the Gemini parse worker — MONEY-1255.
///
/// ## Why this is a separate table and not a write straight to StockFinancials
///
/// `StockFinancials` has NO `source` in its `@@unique`, so one period is ONE
/// row and a write ERASES whatever it replaced. Every lesson from the XBRL
/// programme says the raw reading must survive independently of the canonical
/// cell: it lets the projection be re-run without re-calling the model (a
/// 43,105-document backlog is not something to pay for twice), it lets a
/// disagreement be ADJUDICATED rather than silently resolved, and it is the
/// only place both accounting bases can coexist.
///
/// The shape deliberately mirrors `xbrl_filings` → projection →
/// `stock_financials`. This is the same architecture with a different reader.
///
/// ## Two consumers, two different jobs
///
/// 1. VALIDATION, for companies we already cover. An independent third reading
///    breaks the two-way XBRL-vs-vendor disagreements that left `totalEquity`,
///    `totalAssets` and `totalLiabilities` blocked — with two sources you can
///    only detect a conflict, never resolve it.
/// 2. PRIMARY DATA, for the ~821 symbols with no XBRL filing at all (the whole
///    SME board plus 258 mainboard names — Goodyear, Hawkins, Novartis India).
///    Their annual reports have been sitting in GCS since April 2026 with
///    nothing deriving figures from them.
///
/// ## Units
///
/// Every numeric column is CRORES, normalised at write. Indian filings state
/// their own scale in a header ("₹ in Lakhs", "₹ in Millions") and get it wrong
/// or change it between statements, so the raw label and the factor actually
/// applied are both recorded — a scale error is the single most likely way this
/// pipeline produces a confident wrong number, and it must be auditable after
/// the fact rather than re-derived.
model DocumentFinancialExtract {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  documentId   String            @db.ObjectId
  document     StockDocument     @relation(fields: [documentId], references: [id])
  instrumentId String            @db.ObjectId
  instrument   InstrumentMapping @relation(fields: [instrumentId], references: [id])
  symbol       String
  exchange     String

  /// Free-text label as the document states it ("FY2025", "Q3 FY2024-25").
  /// A LABEL, never a sort key — see `periodEnd`.
  fiscalYear String

  /// UTC end-of-period. REQUIRED, and a row is rejected without one.
  ///
  /// Both readers of `stock_financials` — the Financials tab and the research
  /// agent's DB-first path — sort on this, because `period` is free-form and
  /// mis-orders lexicographically ("Q4-2023" ahead of "Q3-2024", and "TTM" has
  /// no year at all so a label sort files the freshest figure in the oldest
  /// column). A document-derived row with no `periodEnd` would render and
  /// reach the model in the wrong position, which is worse than absent.
  periodEnd  DateTime
  periodType String // ANNUAL | QUARTERLY

  /// CONSOLIDATED | STANDALONE.
  ///
  /// IN the unique key here, unlike on `stock_financials` where including it
  /// would double-count. A company files both for one period and they differ by
  /// a MULTIPLE for any holding company (360ONE FY2025 total assets: 19,768 Cr
  /// consolidated against 7,332 Cr standalone). Keeping both here is what makes
  /// the canonical single-row choice non-destructive.
  basis String

  // ── Income statement (CRORES) ──
  revenue                      Float?
  otherIncome                  Float?
  operatingIncome              Float?
  netIncome                    Float?
  ebitda                       Float?
  revenueFromOperations        Float?
  operatingIncomeExOtherIncome Float?
  ebitdaBeforeExceptionalItems Float?

  // ── Balance sheet (CRORES) ──
  totalAssets      Float?
  totalLiabilities Float?
  totalEquity      Float?
  totalDebt        Float?
  totalCash        Float?

  // ── Cash flow (CRORES) ──
  operatingCashFlow  Float?
  capitalExpenditure Float?
  freeCashFlow       Float?

  /// Per-share and share-count figures. `sharesOutstanding` is what lets the
  /// ratios job compute a market cap for a symbol with no vendor coverage,
  /// which is most of the point of this table for the no-XBRL cohort.
  eps               Float?
  sharesOutstanding Float?
  paidUpCapital     Float?
  faceValue         Float?

  /// The scale the DOCUMENT declared, verbatim ("₹ in Lakhs"), and the factor
  /// actually applied to reach crores. Null factor means the document stated
  /// crores or nothing and none was applied.
  scaleLabel  String?
  scaleFactor Float?

  /// Which model produced this, and under which prompt. Both are required to
  /// interpret a disagreement: a systematic error is a property of the
  /// (model, prompt) pair, and without them a re-parse cannot be compared
  /// against its predecessor.
  model         String
  promptVersion String

  /// The model's own confidence, and the pages it cited. `pageRefs` is what
  /// makes a figure CHECKABLE by a human in seconds rather than by re-reading
  /// a 200-page report — treat a figure without one as weaker evidence.
  confidence Float?
  pageRefs   Json?

  /// Full line-item detail as read, before mapping onto the columns above.
  /// Capped; anything larger spills to a GCS sidecar beside the source PDF.
  /// This is what makes a mapping bug fixable without re-calling the model.
  lines Json?

  /// EXTRACTED | FAILED | FAILED_VALIDATION
  ///
  /// FAILED_VALIDATION is distinct from FAILED on purpose: the model answered
  /// and the answer failed our own arithmetic checks (the balance sheet did not
  /// balance, a scale was impossible). That is a prompt or parser signal and
  /// should never be retried blindly the way a timeout should.
  status String

  /// Verdict from the reconcile pass against the incumbent `stock_financials`
  /// value: MATCH | SCALE_MISMATCH | SIGN_MISMATCH | DISAGREEMENT |
  /// INCOMPARABLE. Null until the reconcile has run.
  ///
  /// INCOMPARABLE is the shruggable verdict and has hidden two broken pipes
  /// before (MONEY-1234), so it is counted and reported, never treated as
  /// "nothing to see".
  reconcileVerdict String?

  /// WHY the gate refused, and what it noticed — MONEY-1340.
  ///
  /// These reasons have always existed, inside the `lines.validation` JSON.
  /// That is where they went to die: answering "what is the dominant failure
  /// on this lane" required an aggregation over a nested document, so nobody
  /// asked, and the answer turned out to be that ONE rule accounts for almost
  /// all of it — 1,821 of 1,885 rejected rows carry UNKNOWN_SCALE (96.6%),
  /// 1,804 of them as the sole reason, measured 2026-09-05. A rejection count
  /// with no queryable cause is not a gate, it is a number.
  ///
  /// `@default([])` and NOT optional. A Mongo `db push` creates indexes and
  /// never fields, so all ~6,868 pre-existing rows carry no attribute at all —
  /// but unlike the `parseStatus` family these are never SELECTED ON by a
  /// worker deciding what to do next, only read and counted, so the
  /// absent-vs-null trap has no purchase here. The backfill
  /// (`scripts/data/backfill-extract-validation-columns.ts`) fills them from
  /// the JSON they were always stored in.
  validationReasons  String[] @default([])
  validationWarnings String[] @default([])

  /// Projection cursor — when this reading was last considered by the writer
  /// that projects into `stock_financials`. Null (or absent) means never.
  ///
  /// This exists because CLAUDE.md's own rule is that **a batch needs a
  /// rotation MARKER, ordered ASC, or it never advances**: MONEY-1211 ordered
  /// by a column that was constant across the population, so the same first N
  /// rows were handed to every run — written once, then skipped nightly, while
  /// 681 of 781 symbols were never selected at all. No error, no alert, no
  /// data. Every other nightly writer here carries such a marker; this one
  /// would have been the exception.
  ///
  /// ## Stamp it only for a reading the writer actually DECIDED
  ///
  /// The XBRL writer stamped `projectedAt` on filings whose CREATE was
  /// suppressed — the decided-set was filled for a whole symbol group BEFORE
  /// any statement was written, and the create branch returned without
  /// recording a failure, so a suppressed filing was marked decided having
  /// produced nothing. Armed, that burns a page of rows per night into
  /// stamped-never-created, and a later deliberate pilot then selects none of
  /// them — recoverable only by a hand `$unset`. Stamp AFTER the write
  /// outcome is known, never before.
  projectedAt DateTime?

  extractedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// One reading per document, per period, per basis. A single annual report
  /// legitimately yields ~4 rows: current and prior year × both bases.
  @@unique([documentId, periodEnd, periodType, basis])
  /// The reconcile joins on this to find the incumbent it must grade against.
  @@index([symbol, exchange, periodEnd, periodType, basis])
  @@index([instrumentId])
  @@index([status])
  @@index([reconcileVerdict])
  /// Serves "what is the dominant rejection reason", which is the question
  /// this lane's tuning turns on. Compound rather than bare on the array:
  /// every such query is scoped to FAILED_VALIDATION.
  @@index([status, validationReasons])
  /// Serves the projection's selector: unprojected first, then SYMBOL-major.
  /// A bare index on `projectedAt` would still leave a blocking in-memory SORT.
  ///
  /// Symbol-major, NOT `periodEnd`-major, and the difference is not cosmetic.
  /// Both bases of a period share a `periodEnd`, and so do hundreds of symbols
  /// with March year-ends — so a page boundary drawn on `periodEnd` falls
  /// inside a date block that spans much of the universe, splitting one
  /// company's readings across runs. A boundary drawn on `symbol` falls inside
  /// a single company and defers the remainder intact, which is what lets the
  /// keyset cursor resume without re-reading or skipping.
  @@index([projectedAt, symbol, periodEnd])
  @@map("document_financial_extracts")
}

// ============== SCREENER ENGINE ==============

// Screener Snapshot - Stores screener results for future backtesting
model ScreenerSnapshot {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  strategyId  String
  runAt       DateTime @default(now())
  resultCount Int      @default(0)
  symbols     Json[] // Array of matched symbol strings
  filters     Json // The filters used

  createdAt DateTime @default(now())

  @@index([strategyId, runAt])
  @@map("screener_snapshots")
}

// ============== INTENT LEARNING ==============

// ClassificationLog - Tracks every chat classification for the learning loop
model ClassificationLog {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  message            String // User query (first 500 chars)
  intent             String? // "screener", "quick_research", etc.
  tier               String // "L1", "L2", "L3"
  persona            String?
  tool               String? // "run_screener", "run_research", etc.
  confidence         Float?
  source             String // "flash", "regex", "fast-path", "screener-safety-net"
  flashFailed        Boolean  @default(false)
  flashError         String?
  userRephrased      Boolean?
  userEscalated      Boolean?
  safetyNetActivated Boolean  @default(false)
  userId             String   @db.ObjectId
  chatId             String?  @db.ObjectId
  pagePath           String?
  requestId          String
  createdAt          DateTime @default(now())

  @@index([createdAt])
  @@index([source, createdAt])
  @@index([flashFailed, createdAt])
  @@map("classification_logs")
}

// LearnedPattern - Auto-generated corrections from classification analysis
model LearnedPattern {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  patternType    String // "flash_example" | "regex_pattern"
  exampleMessage String?
  correctIntent  String?
  correctTier    String?
  correctTool    String?
  correctPersona String?
  regexPattern   String?
  targetTool     String?
  learnedFrom    String[] // Array of ClassificationLog IDs
  generatedBy    String // "worker_analysis"
  status         String   @default("active")
  hitCount       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, patternType])
  @@map("learned_patterns")
}

// ============== CUSTOM STRATEGIES ==============

model CustomStrategy {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId
  name          String
  description   String?
  filters       Json // [{ metric, operator, value }]
  logic         String    @default("AND")
  scanType      String // "fundamental"|"technical"|"combined"
  chartinkQuery String? // Raw Chartink query for technical strategies
  isBuiltIn     Boolean   @default(false)
  isPublic      Boolean   @default(false)
  category      String? // "value"|"momentum"|"income"|"growth"|"quality"|"technical"
  tags          String[]
  usageCount    Int       @default(0)
  lastRunAt     DateTime?
  lastRunCount  Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id])

  @@unique([userId, name])
  @@index([userId])
  @@index([isBuiltIn])
  @@map("custom_strategies")
}

model CustomIndicator {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  name        String
  description String?
  formula     Json // { type: "combined", rules: [{ indicator, period, condition, value }] }
  outputType  String // "signal" | "value" | "overlay"
  isPublic    Boolean  @default(false)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, name])
  @@index([userId])
  @@map("custom_indicators")
}

model ScanResult {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  strategyId   String?  @db.ObjectId
  userId       String   @db.ObjectId
  scanName     String
  results      Json // [{ symbol, name, exchange, price, matchedMetrics }]
  stockCount   Int
  status       String   @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  errorMessage String?
  executedAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId, executedAt])
  @@index([strategyId])
  @@map("scan_results")
}

// ============== GST BILLING ==============
//
// Independent invoice ledger for GST export-of-services compliance under LUT
// (zero-rated, AS-11 FX policy, GSTR-1 Table 6A reporting). DodoPayments is
// our Merchant of Record but their invoices don't satisfy our GST obligations
// - these models are the system of record our CA reconciles against.
//
// Customer-facing invoice numbers use the UMAI brand prefix (e.g.
// `UMAI/EXP/26-27/0001`). Legal entity (DIS Digital LLP) lives in the PDF
// template, not the schema. Linear ticket prefix stays MONEY.
//
// Money columns use Float to match the existing Payment model and because
// Prisma's MongoDB connector does not support the Decimal scalar. Per-invoice
// totals (cgst+sgst+igst → totalTax → total) are recomputed in-app and
// rounded to 2 decimals using banker's rounding (Big.js) at write-time, so
// audit reconciliation stays paise-accurate per document. For multi-invoice
// aggregates (e.g. monthly GSTR-1 totals), the consumer must sum from the
// stored line items rather than from accumulated Float totals to avoid drift.
//
// Invoices are immutable once ISSUED - customer fields are denormalized
// snapshots so a later edit to User / dodoCustomer can't rewrite history.

model GstInvoice {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Numbering - allocated atomically via GstInvoiceCounter per (documentType, FY)
  // documentSubtype distinguishes EXP (export, MONEY-212–217) from DOM
  // (domestic per-user, MONEY-227). They share this table but use separate
  // counters: "INVOICE" for EXP, "INVOICE_DOMESTIC" for DOM.
  invoiceNumber   String             @unique
  financialYear   String
  sequence        Int
  invoiceDate     DateTime
  documentSubtype GstDocumentSubtype @default(EXPORT)

  // Supply classification
  supplyType    GstSupplyType
  placeOfSupply String

  // Customer snapshot (denormalized - invoices are immutable)
  customerName    String
  customerEmail   String
  customerCountry String
  customerState   String?
  customerGstin   String?
  customerAddress String

  // Source links (loose - v1 ingests via CSV, not always tied to a Payment row)
  paymentId      String?  @db.ObjectId
  payment        Payment? @relation(fields: [paymentId], references: [id])
  dodoPaymentId  String?
  dodoCustomerId String?
  userId         String?  @db.ObjectId
  user           User?    @relation(fields: [userId], references: [id])

  // Currency + FX (AS-11: RBI reference rate as of invoice date)
  currencyCode       String
  exchangeRate       Float
  exchangeRateDate   DateTime
  exchangeRateSource String   @default("RBI_REFERENCE_RATE")

  // Amounts - rounded to 2 decimals at write-time (banker's rounding)
  subtotalForeign Float
  subtotalInr     Float
  cgstRate        Float?
  cgstAmountInr   Float?
  sgstRate        Float?
  sgstAmountInr   Float?
  igstRate        Float?
  igstAmountInr   Float?
  totalTaxInr     Float
  totalInr        Float

  // Line items: [{ description, hsnSac, quantity, unitPriceForeign, lineTotalForeign }]
  items Json

  // LUT (export under bond - required on doc per CGST Rule 96A)
  lutNumber     String?
  lutValidUntil DateTime?

  // Lifecycle
  status             GstInvoiceStatus @default(DRAFT)
  issuedAt           DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  // PDF artifact (rendered in MONEY-215, stored in GCS)
  pdfStorageKey  String?
  pdfUrl         String?
  pdfGeneratedAt DateTime?

  // FIRC tracking (MONEY-217) - Foreign Inward Remittance Certificate
  fircStatus              GstFircStatus @default(PENDING)
  fircReceivedAt          DateTime?
  fircStorageKey          String?
  fircBankCreditDate      DateTime?
  fircBankCreditAmountInr Float?
  fircNotes               String?

  // Audit
  generatedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Reverse relations
  creditNotes GstCreditNote[]

  @@index([financialYear, sequence])
  @@index([userId])
  @@index([dodoPaymentId])
  @@index([paymentId])
  @@index([invoiceDate])
  @@index([status])
  @@index([fircStatus])
  @@map("gst_invoices")
}

model GstCreditNote {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Numbering - separate counter from invoices (UMAI/CN/...)
  creditNoteNumber String   @unique
  financialYear    String
  sequence         Int
  creditNoteDate   DateTime

  // Original invoice link.
  // Optional because v1 ingests refund-heavy periods that may not match a
  // single prior invoice (Dodo aggregates many end-customers per payout).
  // The engine populates it when there is an unambiguous original; UI falls
  // back to `originalInvoiceNumber` (denormalised snapshot) when null.
  originalInvoiceId     String?     @db.ObjectId
  originalInvoice       GstInvoice? @relation(fields: [originalInvoiceId], references: [id])
  originalInvoiceNumber String

  reason     GstCreditNoteReason
  supplyType GstSupplyType

  // Customer snapshot (mirrors original at time of CN issuance)
  customerName    String
  customerEmail   String
  customerCountry String
  customerState   String?
  customerGstin   String?
  customerAddress String

  // Refund link
  dodoRefundId String?

  // Currency + FX (AS-11: rate at credit note date, not original invoice date)
  currencyCode       String
  exchangeRate       Float
  exchangeRateDate   DateTime
  exchangeRateSource String   @default("RBI_REFERENCE_RATE")

  // Reversed amounts
  refundAmountForeign Float
  refundAmountInr     Float
  cgstReversedInr     Float?
  sgstReversedInr     Float?
  igstReversedInr     Float?
  totalTaxReversedInr Float
  totalReversedInr    Float

  // Lifecycle (same shape as invoice)
  status             GstInvoiceStatus @default(DRAFT)
  issuedAt           DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  // PDF
  pdfStorageKey  String?
  pdfUrl         String?
  pdfGeneratedAt DateTime?

  // Audit
  generatedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([financialYear, sequence])
  @@index([originalInvoiceId])
  @@index([dodoRefundId])
  @@index([creditNoteDate])
  @@index([status])
  @@map("gst_credit_notes")
}

// Atomic gapless sequencer - Mongo guarantees per-document atomicity for
// `findOneAndUpdate` with `$inc`, which is exactly what GST gapless numbering
// needs. The engine in MONEY-214 calls upsert+increment to allocate the next
// number; sequence starts at 0, first allocation returns 1.
model GstInvoiceCounter {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  documentType  String
  financialYear String
  prefix        String
  sequence      Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([documentType, financialYear])
  @@map("gst_invoice_counters")
}

// DodoPayments wallet ledger row, staged for invoice generation.
// Populated by admin CSV upload (MONEY-213); consumed by the engine in MONEY-214.
// One row per Dodo transaction; grouped at engine time by (billingPeriod × currency).
model DodoPayoutStaging {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Source identity
  csvHash       String // SHA-256 of canonicalised CSV body - idempotency key for re-uploads
  uploadedAt    DateTime @default(now())
  uploadedBy    String? // clerkId of admin who uploaded
  sourceFileKey String? // GCS object key of the original CSV

  // Dodo transaction fields (parsed from CSV row)
  transactionId   String   @unique // Dodo's transaction_id - globally unique
  payoutId        String? // Dodo's payout_id (groups txns into a settlement)
  customerEmail   String?
  customerCountry String? // ISO-2 country code from Dodo
  currency        String // ISO-4217 - "USD", "GBP", "EUR", "INR", ...
  grossAmount     Float // gross charge in native currency
  feesAmount      Float // Dodo platform + processing fees in native
  netAmount       Float // grossAmount - feesAmount; can be negative for refunds
  transactionDate DateTime // when the txn settled in Dodo's books
  rawRow          Json // entire parsed CSV row, kept for audit + future re-derivation

  // Computed billing period (per BILLING_PERIOD_DAYS env, default 15)
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime

  // Lifecycle
  consumedByInvoiceId String?   @db.ObjectId // populated when MONEY-214 emits an invoice
  consumedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([csvHash])
  @@index([billingPeriodStart, billingPeriodEnd, currency])
  @@index([payoutId])
  @@index([consumedByInvoiceId])
  @@map("dodo_payout_staging")
}

enum GstSupplyType {
  EXPORT_LUT
  EXPORT_WITH_IGST
  DOMESTIC
}

enum GstInvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum GstCreditNoteReason {
  REFUND
  CANCELLATION
  ADJUSTMENT
}

enum GstFircStatus {
  PENDING // Default - no FIRC received yet
  RECEIVED // Bank has provided FIRC + funds credited
  NA // INR-denominated invoice - FIRC doesn't apply
}

enum GstDocumentSubtype {
  EXPORT // UMAI/EXP/YY-YY/NNNN - DodoPayments aggregated foreign buyers (MONEY-212–217)
  DOMESTIC // UMAI/DOM/YY-YY/NNNN - individual Indian users via /billing (MONEY-227)
}

// Audit log for every state-change on a GST invoice or credit note. Append-only;
// rows are NEVER deleted (audit retention is 6+ years per the GST Act).
model GstAuditLog {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Subject. `documentId` is optional because cross-document events
  // (GSTR1_EXPORT, BULK_DOWNLOAD) cover many invoices at once and pin to a
  // month label rather than a single ObjectId. Per-invoice events
  // (GENERATE/FINALISE/CANCEL/FIRC_UPDATE) always populate it.
  documentType  String // "INVOICE" | "CREDIT_NOTE"
  documentId    String? @db.ObjectId
  invoiceNumber String // denormalised for fast log scans

  // Action
  action     String // "GENERATE" | "FINALISE" | "CANCEL" | "FIRC_UPDATE" | "BULK_DOWNLOAD" | "GSTR1_EXPORT" | "CSV_UPLOAD"
  beforeJson Json?
  afterJson  Json?

  // Actor + request context
  actorClerkId String? // Clerk user ID of the admin who triggered this
  ipAddress    String?
  userAgent    String?

  at DateTime @default(now())

  @@index([documentId])
  @@index([invoiceNumber])
  @@index([action])
  @@index([at])
  @@map("gst_audit_logs")
}

// ============== SCREENER (MONEY-201) ==============

/// Saved Screen - user-named bundle of screener filters.
///
/// `mode` is one of "stocks" | "mf" | "etf"; `filters` is the JSON
/// shape MONEY-196 emits over `?mode=...&{prefix}.*` URL state. The
/// optional `query` stores the text search alongside the filters
/// so loading a screen restores the full session.
///
/// `name` is unique per (userId, mode) - a user can have a "High ROE
/// compounders" screen in stocks mode AND another with the same name
/// in mf mode without collision.
model SavedScreen {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  mode      String // "stocks" | "mf" | "etf"
  filters   Json
  query     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, mode, name])
  @@index([userId, updatedAt])
  @@map("saved_screens")
}

/// NSE index constituent (MONEY-301).
///
/// One row per (indexId, symbol). The screener Index filter joins on
/// this table once populated; the static + market-cap-rank fallback in
/// `apps/web/lib/screener/index-constituents.ts` covers the period
/// before the first sync and any indices the worker can't resolve.
///
/// `indexId` matches the keys in `INDEX_OPTIONS` ("nifty50", "nifty100",
/// "nifty500", "midcap150", "smallcap250", "banknifty", "niftyit").
/// Weekly Cloud Scheduler trigger Sunday 03:00 IST → Pub/Sub
/// `index-constituent-sync` → worker rewrites the table for each id.
/// Daily close for a market index (NSE `ind_close_all_*`) — MONEY-1085 follow-up.
///
/// The bhavcopy worker fetched ~161 index closes every trading day and threw
/// them away ("no index-history model yet"), so we had no index history at all
/// — nothing to benchmark a portfolio against, and no way to answer "how did
/// Nifty 50 do over this period" without re-fetching from NSE, which only
/// serves a limited window.
///
/// Deliberately NOT keyed to InstrumentMapping: an index is not a tradeable
/// instrument, has no ISIN, and NSE identifies it only by display name. The
/// slug is derived from that name so the key survives NSE's cosmetic renames
/// (e.g. "Nifty 50" vs "NIFTY 50").
model IndexClose {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Normalised index key, e.g. "nifty-50" (see toIndexSlug).
  indexSlug String
  /// Index name exactly as NSE published it, kept for display + audit.
  name      String
  /// Trading date (UTC midnight of the IST calendar day).
  date      DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  prevClose Float?

  // MONEY-1100 P4.2 — valuation columns ind_close_all publishes and the engine
  // used to fetch-and-discard daily (unrecoverable once discarded). All null =
  // NOT REPORTED (`-` in the file), never 0 — dividend-points/rate indices have
  // no basket to value, and a 0 P/E reads as a screaming-cheap index in any
  // screen built on this table.
  pe         Float?
  pb         Float?
  /// Dividend yield in PERCENT (1.25 = 1.25%).
  divYield   Float?
  /// Traded volume (shares) across constituents. Float, not Int: Nifty 500
  /// prints 1.07e9 on an ordinary day — Int32 is one busy session from overflow.
  volume     Float?
  /// Turnover in ₹ CRORE — the file's own unit, stored UNCONVERTED; the field
  /// name carries the unit (cf. delivery.ts converting TURNOVER_LACS because
  /// its target field is bare `turnover`).
  turnoverCr Float?

  source    String   @default("NSE_INDICES")
  createdAt DateTime @default(now())

  @@unique([indexSlug, date])
  @@index([date])
  @@index([indexSlug, date(sort: Desc)])
  @@map("index_closes")
}

model IndexConstituent {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  indexId      String // "nifty50" | "nifty100" | "nifty500" | "midcap150" | "smallcap250" | "banknifty" | "niftyit"
  symbol       String // NSE primary symbol
  /// Free-float weight in basis points (NSE publishes 4-decimal weights
  /// like 8.4321 - store ×10000 as Int to dodge float drift).
  weightBps    Int?
  rank         Int? // 1-based rank by free-float mcap when published
  /// Last successful refresh timestamp - used by the screener fallback
  /// to detect stale rows and route to the mcap-rank derivation.
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([indexId, symbol])
  @@index([indexId])
  @@index([indexId, rank])
  @@map("index_constituents")
}

/// Point-in-time index membership — MONEY-1189 (P4.3's headline benefit).
///
/// `IndexConstituent` above is unique on (indexId, symbol) and rewritten by
/// deleteMany+createMany every sync, so it holds TODAY's membership and cannot
/// answer "who was in NIFTY 50 on 2019-03-14" — the survivorship-bias-free
/// question P4.3 exists for. The dated snapshots were accruing in
/// feeds/NSE/index-constituents/ the whole time; only the latest was read.
///
/// FOUR dates with DIFFERENT epistemic status, and the distinction is the
/// point of the model:
///   firstSeen/lastSeen  always known — the observation window
///   addedOn             set ONLY on an observed join (absent, then present)
///   removedOn           set ONLY on an observed exit (present, then absent)
///
/// `addedOn = null` means "already a member when we started looking", which is
/// a different claim from "joined on firstSeen". Deriving addedOn from
/// firstSeen would tell a backtest that all 50 constituents joined on our
/// earliest snapshot date — a fabricated index-wide rebalance indistinguishable
/// from a real regime change.
///
/// A symbol that leaves and returns gets TWO rows; the second carries a real
/// addedOn. Hence no unique on (indexId, symbol).
model IndexMembership {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  indexId   String
  symbol    String
  firstSeen DateTime
  lastSeen  DateTime
  addedOn   DateTime?
  removedOn DateTime?
  source    String    @default("ARCHIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// One row per stint. Re-deriving is idempotent on this key because a stint
  /// is identified by where it STARTED being observed.
  @@unique([indexId, symbol, firstSeen])
  @@index([indexId, firstSeen])
  @@index([indexId, removedOn])
  @@index([symbol])
  @@map("index_memberships")
}

/// Forensic audit row written when a user account is hard-deleted
/// (MONEY-391). One row per delete; survives the User cascade.
///
/// Stores enough to answer "who was this, what did they have, was
/// billing cancelled" without retaining any portfolio/credential data.
/// DPDP Act 2023 retention: only contact + plan/billing references kept
/// so we can prove cancellation + respond to legal-hold requests.
model DeletedUserAudit {
  id                          String    @id @default(auto()) @map("_id") @db.ObjectId
  // Snapshot of identity at delete time (User row is gone after this writes)
  email                       String
  clerkId                     String?
  name                        String?
  // Portfolio snapshot at delete time — null if user never connected a broker.
  // MONEY-445: split asset values per type so admin can triage without a
  // backup restore. totalAssetsAtDeleteINR remains as a convenience sum.
  // totalTradedValueAtDeleteINR captures lifetime traded volume from the
  // tradebook (sum of trade.price × trade.quantity); stored for future
  // admin/analytics surfaces, not currently rendered anywhere.
  totalAssetsAtDeleteINR      Float?
  stocksValueAtDeleteINR      Float?
  mutualFundsValueAtDeleteINR Float?
  positionsValueAtDeleteINR   Float? // F&O current value at delete time
  totalTradedValueAtDeleteINR Float? // Lifetime tradebook volume
  holdingsCount               Int       @default(0)
  positionsCount              Int       @default(0) // F&O positions
  tradesCount                 Int       @default(0)
  mutualFundsCount            Int       @default(0)
  paperPositionsCount         Int       @default(0)
  brokersConnected            String[] // BrokerType names, e.g. ["ZERODHA", "UPSTOX"]
  // Subscription / billing snapshot
  hadActiveSubscription       Boolean   @default(false)
  planAtDelete                String? // PlanType at delete time
  dodoSubscriptionId          String?
  dodoCustomerId              String?
  dodoCancelledAt             DateTime?
  dodoCancelError             String? // non-null if Dodo cancel API failed; admin must clean up
  // Audit metadata
  deletedAt                   DateTime  @default(now())
  deletedBy                   String    @default("user") // "user" | "admin" | "system"
  adminUserId                 String?   @db.ObjectId // populated when deletedBy = "admin"
  reason                      String?
  ipAddress                   String?
  userAgent                   String?

  // Async cleanup tracking. Lock-then-purge lifecycle (MONEY-144 rework
  // of MONEY-391/445):
  //   Phase 1  clerkLockedAt            - Clerk user LOCKED (not deleted yet);
  //                                       session invalidated, email reserved
  //                                       for 24h.
  //   Phase 2  snapshotCapturedAt       - Portfolio + billing + operational
  //                                       snapshot captured.
  //   Phase 3  dodoCancelledAt          - Dodo subscription cancel attempted.
  //   Phase 4  dbHardDeletedAt          - User row deleted (cascades to
  //                                       all child records via Prisma).
  //   Phase 5  confirmationEmailSentAt  - AccountDeletedEmail dispatched.
  //                                       Status flips to LOCKED here.
  //   Phase 6 (sweep, +24h)
  //            clerkUserDeletedAt       - Cloud Scheduler hourly sweep picks
  //                                       up LOCKED rows whose
  //                                       clerkDeleteScheduledFor <= now and
  //                                       calls Clerk.users.deleteUser.
  //                                       Status flips to COMPLETED.
  // FAILED + deletionError captures the failing phase for admin triage.
  status                  String    @default("COMPLETED") // PENDING | PROCESSING | LOCKED | COMPLETED | FAILED
  snapshotCapturedAt      DateTime?
  clerkLockedAt           DateTime?
  clerkDeleteScheduledFor DateTime? // = clerkLockedAt + 24h; sweep index
  dbHardDeletedAt         DateTime?
  clerkUserDeletedAt      DateTime?
  confirmationEmailSentAt DateTime?
  deletionError           String?
  retryCount              Int       @default(0)

  // Operational engagement snapshot (MONEY-144). Captures how
  // engaged the user was at deletion time — useful for churn analysis,
  // exit-survey correlation, and investor DD.
  chatsCreatedCount      Int @default(0)
  stocksResearchedCount  Int @default(0)
  comparisonsCount       Int @default(0)
  strategiesCount        Int @default(0)
  backtestsRunCount      Int @default(0)
  roastsGeneratedCount   Int @default(0)
  fireScenariosCount     Int @default(0)
  documentsUploadedCount Int @default(0)
  watchlistsCount        Int @default(0)
  researchCreditsSpent   Int @default(0)

  @@index([deletedAt])
  @@index([email])
  @@index([clerkId])
  @@index([status])
  @@index([status, clerkDeleteScheduledFor]) // hot path for the 24h purge sweep
  @@map("deleted_user_audits")
}

// Content Studio generations (MONEY-633) — images (Nano Banana Pro) + reels
// (video-studio/Veo) produced in apps/content. `userId` is the Clerk user id
// (matches apps/content auth()), kept as a plain indexed string rather than a
// User relation to avoid a clerkId->ObjectId lookup on every write. `postId`
// is optional, for attaching a generation to a content Post later.
model StudioGeneration {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String // Clerk user id
  kind      String // "image" | "reel"
  prompt    String? // image prompt or reel title
  url       String // GCS URL of the generated asset
  model     String? // e.g. gemini-3-pro-image-preview / veo-3.0-fast-generate-001
  meta      Json? // freeform: aspect, jobId, durationSec, etc.
  postId    String?  @db.ObjectId // optional: attached content Post
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([postId])
  @@map("studio_generations")
}

// MONEY-1198 (Data Engine) — the EXCHANGE'S OWN top gainers / losers.
//
// ## Why this table exists
//
// Discover's "Top movers — today" panel ranked `latest_quotes` with NO
// freshness predicate, and nothing bulk-refreshes that table intraday
// (price-sync runs 23:00 IST). It showed LAPL at ₹128.29 +36.48% while the
// stock's own detail page showed ₹121.88 −5.00% with PREV CLOSE ₹128.29 —
// ₹128.29 being YESTERDAY's close. The panel was ranking the previous session
// and labelling it "today".
//
// NSE and BSE publish their own ranked lists. This table stores THEIRS, so the
// panel agrees with the exchange instead of re-deriving a worse answer from
// per-symbol quotes.
//
// ## UNBACKFILLABLE
//
// `/api/live-analysis-variations` takes no date parameter and serves only the
// CURRENT snapshot. A poll we miss is a snapshot that never existed for us —
// the SCHEDULE is the only thing that accrues history here, exactly like
// surveillance-sync and institutional-flow-sync.
model MarketMover {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// The instant the EXCHANGE says this snapshot describes, taken from the
  /// payload's own `timestamp` ("14-Aug-2026 11:53:54", IST wall-clock).
  ///
  /// NEVER the fetch time, and this is the whole point of the ticket: a row
  /// written at 11:53 carrying yesterday's prices is indistinguishable from a
  /// fresh one unless the SESSION is what got stored. Every reader MUST filter
  /// on this — see the note on @@unique below.
  snapshotAt DateTime
  /// UTC midnight of the IST session day `snapshotAt` falls in. Derived from
  /// the snapshot, not from "now", so a replayed archive files correctly.
  date       DateTime

  /// "NSE" | "BSE".
  exchange  String
  /// "GAINERS" | "LOSERS" — from WHICH ENDPOINT served the row, never from the
  /// sign of a percent field. NSE ranks by a corporate-action-adjusted figure,
  /// so a row in the gainers list can carry a negative raw perChange
  /// (FEDERALBNK, 14-Aug-2026: perChange −0.01, listed as a GAINER).
  direction String
  /// NIFTY | BANKNIFTY | NIFTYNEXT50 | SecGtr20 | SecLwr20 | FOSec | allSec —
  /// NSE's seven published lists per direction. Part of the identity, not
  /// decoration; see @@unique.
  bucket    String

  symbol       String
  /// EQ | BE | … NSE's series letter. Null on BSE, which does not publish one.
  series       String?
  /// Resolved against InstrumentMapping by the worker. The movers payload
  /// carries NO isin of its own, so this is our join, not the exchange's.
  instrumentId String? @db.ObjectId
  /// Denormalised from InstrumentMapping at write time. ISIN is the durable
  /// company identity (a symbol can be reassigned after a rename, MONEY-1177),
  /// so it is what a dual-listing dedupe collapses on.
  isin         String?

  /// NSE's position within the bucket, as served. Its ranking, preserved —
  /// re-sorting on our side would disagree with nseindia.com because we cannot
  /// reproduce the adjusted base it ranks by.
  rank Int

  open      Float?
  high      Float?
  low       Float?
  ltp       Float
  /// Previous close, UNADJUSTED for a corporate action going ex today.
  prevClose Float

  /// NSE's `perChange` — the RAW percent move against `prevClose`. This is the
  /// field that reconciles with (ltp − prevClose) / prevClose.
  percentChange    Float
  /// NSE's `net_price` — a CORPORATE-ACTION-ADJUSTED percent change, and the
  /// field NSE actually RANKS by.
  ///
  /// TWO traps in one column. (1) The name says "net PRICE" but it is a
  /// PERCENT: BHARTIARTL moved ₹1939.10 → ₹1999.90, a ₹60.80 move, and
  /// net_price was 3.14. Reading it as rupees is wrong by ~20x and looks
  /// plausible. (2) It is NOT a copy of percentChange — on an ex-day NSE
  /// re-bases to a figure it does not publish (APOLLOHOSP: perChange 2.96 vs
  /// net_price 3.08, base 8590 = 8600 − ₹10 dividend), and the two can DISAGREE
  /// ON SIGN. Stored verbatim; never reconstruct one from the other, including
  /// when caExDate is null (TECHNOCRAF: no corporate action, 46.70 vs 9.51).
  adjPercentChange Float?
  /// ltp − prevClose. Rupees — the thing adjPercentChange is not.
  rupeeChange      Float

  tradedQty Float?
  /// NSE publishes turnover in ₹ LAKH on this endpoint. Stored unconverted;
  /// the unit lives here rather than in the field name.
  turnover  Float?

  /// Ex-date of a corporate action. NSE's absent-sentinel is the literal "-",
  /// which is normalised to null — storing the dash would make every ordinary
  /// row look like it had an action.
  caExDate  String?
  caPurpose String?

  /// Provenance — MARKET_MOVER_SOURCES, e.g. "NSE_LIVE_VARIATIONS".
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// THE idempotency key, and note `bucket` is IN it.
  ///
  /// Without that field this repeats the MarketPositioning bug exactly. The
  /// same symbol appears in SEVERAL buckets at one instant — measured on the
  /// live 2026-08-14 response, 35 of 85 symbols did, e.g. BHARTIARTL in both
  /// NIFTY and FOSec and GALAXYSURF in both SecGtr20 and allSec. Keyed without
  /// `bucket`, those rows collide and whichever is written second silently
  /// overwrites the first: the table looks full and is missing NSE's
  /// index-level lists entirely.
  ///
  /// `date` rather than `snapshotAt` so an intraday poll UPDATES the day's row
  /// instead of appending one row per poll (~125 polls x 7 buckets x 2
  /// directions would be ~35k rows/day for no reader). Freshness is carried by
  /// the `snapshotAt` COLUMN, and the worker additionally prunes rows left
  /// behind by an earlier snapshot — so a stale row cannot be read even by a
  /// consumer that forgets the predicate, which is what went wrong in the first
  /// place.
  @@unique([exchange, direction, bucket, symbol, date])
  /// Hot read: "today's top movers for this bucket, freshest first" — the
  /// Discover panel's actual query.
  @@index([date, exchange, direction, bucket, rank])
  /// Freshness sweeps and the stale-row prune.
  @@index([snapshotAt])
  /// Per-symbol history: "when was this stock last a top mover?"
  @@index([symbol, date(sort: Desc)])
  @@map("market_movers")
}

// MONEY-1198 — NSE's live whole-market index snapshot (`/api/allIndices`).
//
// DISTINCT FROM `IndexClose` (index_closes), which is the EOD bhavcopy series
// written by bhavcopy-sync from `ind_close_all_DDMMYYYY.csv`. That one is one
// settled row per index per day; this one is an intraday reading that moves
// through the session and carries the live P/E, P/B, dividend yield and
// constituent breadth the EOD file does not have. Merging them would put
// unsettled intraday values into the historical close series.
//
// UNBACKFILLABLE for the same reason as MarketMover: no date parameter, current
// snapshot only.
model IndexLiveSnapshot {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// From the payload's own top-level `timestamp`, which on THIS endpoint has
  /// MINUTE precision ("14-Aug-2026 11:56") while the movers endpoint's has
  /// seconds. Never the fetch time.
  snapshotAt DateTime
  /// UTC midnight of the IST session day.
  date       DateTime

  /// NSE's `indexSymbol`, e.g. "NIFTY 50".
  indexSymbol String
  /// NSE's `index` display name.
  indexName   String
  /// NSE's `key` grouping, e.g. "BROAD MARKET INDICES", "SECTORAL INDICES".
  category    String?

  last          Float
  open          Float?
  high          Float?
  low           Float?
  previousClose Float?
  /// `variation` — the POINTS move. Unlike MarketMover.adjPercentChange, this
  /// one genuinely is an absolute move and not a percentage.
  pointsChange  Float?
  percentChange Float?
  yearHigh      Float?
  yearLow       Float?

  /// Valuation ratios. NSE serves these as STRINGS and uses "0" — not "-", not
  /// null — as its NOT-APPLICABLE sentinel: 19 of the 139 live indices carry
  /// pe/pb/dy of "0" (INDIA VIX, the strategy and debt indices). Those are
  /// normalised to null, because rendering a P/E of 0.00 asserts a valuation
  /// that does not exist.
  pe            Float?
  pb            Float?
  dividendYield Float?

  /// Constituent breadth WITHIN this index. Null when NSE omits the keys
  /// entirely, which it does for INDIA VIX — they are ABSENT from the record
  /// rather than present-and-zero, so index rows are ragged. Note a 0 here IS
  /// real and is preserved; the "0 means absent" rule applies to the ratios
  /// above and nowhere else.
  advances  Int?
  declines  Int?
  unchanged Int?

  /// Provenance — "NSE_ALL_INDICES".
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per index per session day, updated as the session moves. Same
  /// reasoning as MarketMover: the poll UPDATES rather than appends, and
  /// `snapshotAt` carries the freshness.
  @@unique([indexSymbol, date])
  /// Hot read: every index as of today, for the market-overview strip.
  @@index([date, category])
  @@index([snapshotAt])
  @@map("index_live_snapshots")
}

// REMOVED 2026-08-19 (MONEY-1212): seven models that never had a writer in any
// commit — `git log -S "prisma.<model>."` over all history returns nothing for
// each, and prod held 0 rows for all seven:
//
//   NewsFeed          (news_feeds)           GlossaryTerm and the rest of the
//   ScreenerValidation(screener_validations) dead set are NOT here: they have
//   DailyJournal      (DailyJournal)         live READERS (see below).
//   LearningModule    (learning_modules)
//   Lesson            (lessons)
//   LessonProgress    (lesson_progress)
//   ContentGeneration (content_generations)
//
// `news_feeds` is the instructive one: news IS a shipped feature, but
// `packages/services/src/news.service.ts` contains no `prisma.` call at all —
// news is fetched live. Do NOT "fix" its absence by wiring a writer.
//
// The LIVE learning set is Course / CourseLesson / CourseLessonProgress /
// Enrollment, which have admin writers and stay. The four removed here are an
// earlier, abandoned shape with confusingly similar names.
//
// DELIBERATELY KEPT, despite also having no writer: GlossaryTerm,
// StudioGeneration, AnalysisReport, Order, CustomIndicator. Each has live
// READ or DELETE call sites — `learning.service.ts:325`, `studio.ts:26`,
// `indexer.ts:450`, `broker-connection.service.ts:181,569`, and
// `account-deletion.service.ts:632,1105`. That last one is the GDPR erasure
// cascade; removing a model out from under it is a compliance change, not a
// cleanup, and needs its own ticket.

// ─────────────────────────────────────────────────────────────────────────────
// US instrument master — MONEY-980
//
// SEPARATE FROM `instrument_mappings`, and the rule that decided it is written
// in packages/database/CLAUDE.md: share one table between markets only when the
// market discriminator is part of the row's UNIQUE KEY and every reader carries
// it. Neither half held. India's key is `(symbol, exchange)` + `yahooSymbol`;
// the US's is an occupancy window. 37 India-facing readers carry no venue
// clause at all.
//
// The key is what forced it. `instrument_mappings` is unique on `yahooSymbol`,
// which is one row per ticker — so loading Tiingo's master into it meant
// DROPPING 2,196 repeated tickers, including every delisted security whose
// ticker a live one now uses. `DOW` could hold Dow Inc. or Dow Chemical, never
// both. Here the unique is `listingId`, so both windows are rows and the
// delisted tail — the 10,287 issues this backbone exists to hold — survives.
// ─────────────────────────────────────────────────────────────────────────────

/// One US listing: a security's occupancy of a ticker on a venue.
///
/// NOT one per ticker. `(symbol, exchange)` is INDEXED BUT NOT UNIQUE, which is
/// the whole point of the model — Tiingo's master carries two `DOW` rows on
/// NYSE (1972-2017 Dow Chemical, 2019- Dow Inc.), identical in every field a
/// naive key would use and differing only by window.
model UsInstrument {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// `{symbol}:{exchange}:{listingStartDate}`. The security identity, and the
  /// only unique on this model. `Candle.listingId` points here.
  listingId String

  symbol    String // Tiingo ticker, dashes not periods: BRK-A, SPG-P-J
  exchange  String // NASDAQ | NYSE | AMEX | NYSE ARCA | BATS | NYSE MKT | NYSE NAT | NMFQS
  assetType String // Stock | ETF | Mutual Fund

  /// Company name. NOT in `supported_tickers.zip` — that file carries only
  /// ticker/exchange/assetType/currency/dates — so it is filled by a separate
  /// paced leg reading `/tiingo/daily/<ticker>`, and is `null` until that leg
  /// reaches the row rather than defaulted to the symbol.
  ///
  /// Load-bearing, not cosmetic: delisted rows are user-visible in search, and
  /// a result reading `LEH` with no name is not findable by anyone who does not
  /// already know the answer. A row whose name is null is a row search should
  /// rank last, which is a distinction `name = symbol` would erase.
  name String?

  listingStatus    String // ACTIVE | DELISTED
  listingStartDate DateTime?
  listingEndDate   DateTime?

  /// Tiingo's durable security id, from `/tiingo/utilities/search`. The join key
  /// for the corporate-actions feed, whose rows carry permaTicker and not our
  /// symbol.
  ///
  /// It is NOT an identity fix for ticker recycling and must never be used as
  /// one: search resolves only the CURRENT occupant of a ticker, so `DOW`
  /// returns Dow Inc. and `BRKL` returns "Corgi BRKB 2x Daily ETF" rather than
  /// Brookline Bancorp. An identifier that cannot name a delisted predecessor
  /// cannot disambiguate one from its successor. That is `listingId`'s job.
  permaTicker       String?
  openFIGIComposite String?
  /// SEC Central Index Key, from EDGAR's `company_tickers.json`.
  cik               String?

  /// ── Rotation markers ──
  /// One per job, never shared. A shared "lastTouched" lets one job reset
  /// another's rotation, so each would see a population that looks freshly
  /// synced for work it never did.
  ///
  /// Read in `orderBy` ONLY, never in `where`: on a Mongo `db push` these
  /// attributes are ABSENT rather than null on pre-existing rows, so
  /// `{usEodSyncedAt: null}` returns ZERO. Mongo sorts a missing field lowest,
  /// so `asc` leads with the never-synced rows — which is the order every one
  /// of these jobs wants.
  usEodSyncedAt  DateTime?
  searchSyncedAt DateTime?
  nameSyncedAt   DateTime?

  /// ── Cold-storage reference (GCS) ──
  /// Which shard years exist for this listing at
  /// `candles/US/{timeframe}/{symbol}/{year}`. Stamped by the backfill on every
  /// symbol it archives.
  ///
  /// Stored rather than derived because the alternative is a GCS LIST per read,
  /// and `listFiles` in @usemoney/storage FAILS OPEN to `[]` on an auth or
  /// network error (MONEY-941) — so a derived answer would report "this
  /// security has no history" for a credentials problem. Two integers cannot do
  /// that.
  coldYearsFrom Int?
  coldYearsTo   Int?

  /// ── Hot-load ledger ──
  /// Which cold years have been pulled back into Mongo on request, and when the
  /// most recent pull happened. `Candle.tier`/`hotLoadedAt` carry the same fact
  /// per row; this is the per-listing summary a UI can read without touching
  /// the candle table, and what the eviction job clears when a load ages out.
  hotLoadedYears Int[]     @default([])
  lastHotLoadAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId])
  /// Deliberately NOT unique — a recycled ticker is two rows on one venue.
  @@index([symbol, exchange])
  @@index([listingStatus, usEodSyncedAt])
  /// The three enrichment legs each rotate on their OWN marker, so each needs
  /// its own index. Not a nicety: every leg pages ~74k rows ordered by a
  /// marker, and an unindexed sort is a BLOCKING sort that Mongo performs in
  /// memory against a hard 32 MB ceiling. ~74k documents is ~18 MB — under the
  /// limit today, over it after roughly a third more growth — and a blown sort
  /// THROWS rather than degrading, so the leg would stop dead rather than slow
  /// down. Cheap to add now, an incident to diagnose later.
  @@index([nameSyncedAt])
  @@index([listingStatus, searchSyncedAt])
  @@index([permaTicker])
  @@index([cik])
  @@index([assetType, listingStatus])
  @@map("us_instruments")
}

/// US fund NAVs — MONEY-980.
///
/// NOT `Candle`, and the separation is what makes the hot window affordable. A
/// NAV is one daily point, not OHLCV: no open/high/low, no volume, no
/// adjustment inputs, so four of `Candle`'s columns would be null and two would
/// be lies. Measured 2026-08-28 against Tiingo's master, funds are 49,414 of
/// the 72,685 US listings and 72% of the bars in EVERY hot-window depth —
/// 105.9M rows for a 10-year window with them, 33.8M without.
///
/// Keyed on `permaTicker` rather than symbol for the reason `UsCorporateAction`
/// is: fund tickers recycle like any other, and permaTicker's failure mode is
/// zero rows rather than a wrong join.
model UsFundNav {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  permaTicker String
  symbol      String
  date        DateTime // The session the NAV describes, UTC midnight
  nav         Float

  /// Distribution paid on this session, in fund currency. MEASURED, not
  /// assumed: across 22,096 fund bars probed with the live key (VFIAX 6,484
  /// rows back to 2000, FXAIX 3,852, VWELX 11,760 back to 1979), open == high
  /// == low == close in 22,096 of 22,096 and volume == 0 in all of them — which
  /// is why a fund is not a `Candle` — but `divCash` is NON-ZERO on 320 of
  /// them, real quarterly distributions (VFIAX pays 0.305 against a 106.16 NAV
  /// on 2001-03-16).
  ///
  /// Without this column the distribution AMOUNT is dropped at persistence and
  /// a TOTAL-RETURN NAV series cannot be rebuilt from this table — which for a
  /// fund is most of the return. `splitFactor` is deliberately absent: it was 1
  /// in all 22,096 rows, and a column that has never varied is a column whose
  /// writer nobody checks.
  ///
  /// Nullable, and it must be read as such: absent means "this row predates the
  /// column", ZERO means "measured, no distribution". A Mongo `db push` creates
  /// indexes and not fields, so `{divCash: null}` matches neither — select
  /// positively or spell it `OR: [{divCash: null}, {divCash: {isSet: false}}]`.
  divCash Float?

  /// Split factor on this session, WRITTEN ONLY WHEN IT IS NOT 1.
  ///
  /// This column previously did not exist, on the stated grounds that
  /// `splitFactor` was 1 in all 22,096 bars probed and "a column that has never
  /// varied is a column whose writer nobody checks". That measurement was
  /// under-powered and the conclusion was wrong. Widened to 13 funds / 95,597
  /// bars, fund NAV splits are real:
  ///
  ///     SWPPX  2025-08-15   NAV 100.05 ->  16.63   x6
  ///     DODGX  2025-10-27   NAV 282.70 ->  17.78   x16
  ///     FCNTX  2018-08-10   NAV 138.17 ->  13.73   x10
  ///     FSPTX  2018-08-10   NAV 186.45 ->  18.52   x10
  ///
  /// Four in 95,597 is 0.004% — and two of them are inside the last four
  /// months, and each is an 83-94% apparent ONE-DAY COLLAPSE in an unadjusted
  /// series. That is the failure shape this repo keeps meeting: not an error, a
  /// plausible number.
  ///
  /// They ARE recoverable by joining `UsCorporateAction` on
  /// `(permaTicker, "SPLIT", exDate)` — the same key this table uses. Stored
  /// anyway, because that join is only ever as complete as the corporate-actions
  /// day-walk backfill has been run, and a reader cannot tell "no split" from
  /// "the walk has not covered 2018 yet". The correction rides free on bytes we
  /// already fetched.
  ///
  /// SPARSE ON PURPOSE. Mongo stores an absent field in zero bytes, so at
  /// 0.004% incidence this column costs essentially nothing across ~73.5M rows,
  /// where writing 1.0 on every row would cost ~1.5 GB to say "nothing
  /// happened". Absent therefore means EXACTLY "no split", which is the one
  /// place in this model where absent is a real answer rather than an
  /// unmeasured one.
  ///
  /// TWO RULES THE WRITER MUST FOLLOW, both of which are easy to get wrong and
  /// both of which were got wrong first:
  ///
  ///   1. "Not 1" is NOT `f !== 1`. Upstream stores split factors as inexact
  ///      floats — AAPL's 2014 seven-for-one arrives as 7.000007000007001 and
  ///      UNTY's as 1.09999989 — so an equality test against 1 is wrong against
  ///      the live data. Use `Math.abs(f - 1) > SPLIT_EPSILON`, declared ONCE
  ///      and shared, never re-spelled per call site.
  ///   2. On UPDATE, a real "no split" must `{ unset: true }`, not omit the
  ///      key. Omitting leaves whatever is already stored, so a row written
  ///      when the vendor reported a split it LATER CORRECTS to 1 keeps a
  ///      phantom split for ever — an 83-94% cliff on a date where nothing
  ///      happened, indistinguishable from a real one. `unset` is the only
  ///      spelling that preserves the absent-means-no-split contract.
  splitFactor Float?

  source String @default("TIINGO")

  createdAt DateTime @default(now())

  @@unique([permaTicker, date])
  @@index([symbol, date])
  @@index([date])
  @@map("us_fund_nav")
}

// ─────────────────────────────────────────────────────────────────────────────
// US price backbone — MONEY-980 (Tiingo)
//
// WHY A NEW MODEL AND NOT `DailyPrice`. MONEY-1043 is decided as COEXISTENCE:
// `Candle` is the quant warehouse, `DailyPrice`/`IntradayBar` stay the legacy
// India app reads and are not touched. The two differ in more than scale —
// `DailyPrice` keys on `instrumentId` and therefore cannot hold a bar for a
// security that has no `InstrumentMapping` row, which is most of the 10,287
// delisted US issues we backfill.
//
// SIZE IS THE DESIGN CONSTRAINT, not the fetch. Measured 2026-08-28 against
// Tiingo's own master: 24,328 US securities (Stock/ETF, USD, on
// NASDAQ/NYSE/AMEX/ARCA/BATS/MKT/NAT) spanning 231,825 symbol-years back to
// 1962. Every prior job in this repo fits in Atlas because India's universe is
// ~2k symbols x 8y. This one does not, which is why Mongo holds a HOT WINDOW
// and GCS parquet holds the cold tail, merged behind `CandleRepository`.
// ─────────────────────────────────────────────────────────────────────────────

/// One OHLCV bar. Mongo holds the hot window (active symbols, recent years);
/// the cold tail lives in GCS at `candles/{market}/{timeframe}/{symbol}/{year}`
/// and is merged transparently on read. Nothing outside `CandleRepository` may
/// know which of the two answered — that seam is what lets a future feed be a
/// new `source` value plus one sync job, with zero downstream changes.
model Candle {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  symbol    String // Tiingo/exchange ticker, dashes not periods: BRK-A, SPG-P-J
  exchange  String // NASDAQ | NYSE | AMEX | NYSE ARCA | BATS | NYSE MKT | NYSE NAT
  timeframe String // D1 today. M1 | M5 | M15 | H1 | W1 reserved (prompt-01).
  ts        DateTime // Bar OPEN, UTC. For D1 this is UTC midnight of the session.

  /// WHICH SECURITY THIS BAR BELONGS TO — the field that stops two companies
  /// becoming one series.
  ///
  /// A ticker is NOT a security identity. Tiingo's master carries two rows for
  /// `DOW` on NYSE, identical in exchange, assetType and currency, differing
  /// only by window:
  ///     DOW,NYSE,Stock,USD,1972-06-01,2017-08-31   <- Dow Chemical
  ///     DOW,NYSE,Stock,USD,2019-03-20,2026-08-27   <- Dow Inc.
  /// Measured 2026-08-28: 2,196 tickers appear more than once, 928 on a
  /// DIFFERENT exchange, 244 under a different assetType, and 834 delisted US
  /// rows share a ticker with a live one.
  ///
  /// The `@@unique` below cannot catch this, and that is not an oversight: the
  /// two occupancy windows never overlap in time, so there is no key collision
  /// to detect. The corruption is purely SEMANTIC — a full-range read would
  /// return Dow Chemical's bars followed by Dow Inc.'s as one continuous
  /// series, with nothing on the row saying otherwise. Exactly the "one rule,
  /// stated twice, disagreeing" shape as MONEY-1255.
  ///
  /// Format `{symbol}:{exchange}:{listingStartDate}`. `CandleRepository`
  /// resolves a bare ticker to the CURRENT listing by default and takes an
  /// explicit listing only when a caller genuinely wants the historical one.
  ///
  /// `permaTicker` does NOT replace this, and the reason is worth stating
  /// because it looks like it should. It IS obtainable — not from the metadata
  /// endpoint (which carries only ticker/name/description/startDate/endDate/
  /// exchangeCode) but from `/tiingo/utilities/search`, and it is stored on
  /// `InstrumentMapping.permaTicker`.
  ///
  /// It cannot serve as the identity here because search resolves only the
  /// CURRENT occupant of a ticker: `DOW` returns Dow Inc., never Dow Chemical;
  /// `BRKL` returns "Corgi BRKB 2x Daily ETF", never Brookline Bancorp. An
  /// identifier that cannot name a delisted predecessor cannot disambiguate one
  /// from its successor, which is the entire job of this field.
  listingId String

  open   Float
  high   Float
  low    Float
  close  Float
  volume BigInt @default(0) // BigInt, not Int: US mega-cap composite volume clears Int32.

  /// RAW prices above; the adjustment INPUTS here. The adjusted series is
  /// computed at READ time (CRSP methodology, cumulative factors back from the
  /// latest bar) rather than stored.
  ///
  /// Storing adjusted closes instead would mean every new dividend or split
  /// restates the entire history of that symbol — a rewrite of up to 11,517
  /// rows (AAPL, measured) per corporate action. Computing on read makes the
  /// same event a cache invalidation. It also keeps this table honest about
  /// what the exchange actually printed, which is the MONEY-1175 lesson:
  /// Yahoo's stored `close` is split-ADJUSTED while bhavcopy's is RAW, and
  /// mixing the two in one series drew a cliff at every corporate action.
  divCash     Float @default(0)
  splitFactor Float @default(1)

  /// Provenance, ranked by `PRICE_SOURCE_AUTHORITY`. A bar is never overwritten
  /// by an equal-or-weaker source, so a re-parse is idempotent and a historical
  /// replay cannot clobber the nightly.
  source String @default("TIINGO")

  /// WHICH TIER PUT THIS ROW HERE — the column that lets eviction tell a
  /// windowed bar from one a reader pulled back out of cold storage.
  ///
  ///   WINDOW — inside the rolling hot window (equities + ETFs, the last
  ///            HOT_WINDOW_YEARS). Written by the nightly and by the backfill's
  ///            hot leg. Evicted only when the window itself rolls past the
  ///            year, which happens once a year.
  ///   LOADED — read out of a GCS cold shard because someone asked for it: a
  ///            delisted security, or a pre-window year on a live one. Written
  ///            back so the next read is hot. Evicted 30 days after
  ///            `hotLoadedAt`.
  ///
  /// One column, because the two rules disagree about the same row. Without it
  /// eviction cannot distinguish "2015 AAPL, outside the window, delete" from
  /// "2015 AAPL, a user is reading it right now, keep" — and a wall-clock TTL
  /// index (which Prisma cannot declare, and which `db push` would drop) would
  /// delete both.
  tier String @default("WINDOW") // WINDOW | LOADED

  /// When a LOADED row was pulled from cold storage. Absent on WINDOW rows.
  ///
  /// The eviction job MUST select on `tier` positively —
  /// `{tier: "LOADED", hotLoadedAt: {lt: cutoff}}` — and must never test this
  /// for null to find window rows: a Mongo `db push` creates indexes and not
  /// fields, so on every row predating this column the attribute is ABSENT and
  /// both `{hotLoadedAt: null}` and `{hotLoadedAt: {not: null}}` return ZERO.
  /// That class has caused MONEY-1050, MONEY-1205, MONEY-1234 and MONEY-1235.
  hotLoadedAt DateTime?

  createdAt DateTime @default(now())

  /// The physical key stays the natural one so the hot-window read is a single
  /// bounded index scan and no consumer pays for a join. `listingId` is carried
  /// on the row and indexed separately for the history case.
  @@unique([symbol, exchange, timeframe, ts])
  @@index([listingId, timeframe, ts])
  /// NOT a duplicate of the `@@unique` above, however much it looks like one.
  ///
  /// The field ORDER is identical and only the `ts` direction differs, which is
  /// exactly the shape someone tidies away to reclaim 480 MB on a cache-bound
  /// cluster. MEASURED on prod 2026-09-08 with `$indexStats`, and it is the
  /// other way round:
  ///
  ///     …_ts_idx  (ts DESC, 480 MB)   74,281 ops   <- the hot read path
  ///     …_ts_key  (ts ASC,  786 MB)        0 ops   <- constraint only
  ///
  /// Every reader asks for the NEWEST bars of one series — equality on
  /// symbol+exchange+timeframe, `sort({ts:-1})`, `limit(n)` — and `explain()`
  /// picks this index and REJECTS the unique for that query. The unique's zero
  /// is not evidence it is idle: `$indexStats` counts query plans, and
  /// enforcing uniqueness on insert is not a query. So neither index is
  /// droppable — one serves the reads, the other guards the writes.
  ///
  /// The real saving is to make the UNIQUE itself descending and delete this
  /// line, since uniqueness is direction-independent. That is a drop-and-
  /// recreate of a unique index on a 20M-row live collection, with a window in
  /// which nothing enforces the constraint — a deliberate operator step, not a
  /// schema tidy-up. Tracked on MONEY-1385.
  @@index([symbol, exchange, timeframe, ts(sort: Desc)])
  @@index([ts])
  /// Eviction reads exactly this pair; see `tier` above.
  @@index([tier, hotLoadedAt])
  /// MONEY-1373 — the INTRADAY eviction arm, which the pair above cannot serve.
  /// It selects `{tier:"WINDOW", timeframe:{in:[...intraday]}, ts:{lt}}`: a
  /// WINDOW row has no `hotLoadedAt` at all, so `[tier, hotLoadedAt]` degenerates
  /// to a `tier` scan and the `ts` bound is applied in memory. Mongo's blocking
  /// in-memory sort ceiling is 32 MB and it THROWS on breach rather than
  /// degrading — so on a `candles` collection large enough to matter the arm
  /// does not get slow, it stops working, and the failure arrives only once the
  /// table has grown past the threshold.
  @@index([tier, timeframe, ts])
  @@map("candles")
}

/// Daily FX, stamped with the moment the rate was observed rather than the day
/// it belongs to. `asOf` is not decoration: a USDINR "close" fetched at 03:00
/// IST on day D+1 describes day D, and reporting it as D+1's rate silently
/// shifts every converted portfolio value by a day.
model FxRate {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  pair   String // "USDINR"
  date   DateTime // The trading day the rate describes (UTC midnight)
  rate   Float
  source String // YAHOO | RBI
  asOf   DateTime // When the value was actually observed upstream

  createdAt DateTime @default(now())

  @@unique([pair, date])
  @@index([pair, date(sort: Desc)])
  @@map("fx_rates")
}

/// Resumable checkpoint for a long backfill, one row per work item.
///
/// A checkpoint table needs justifying in this repo — `scripts/jobs/xbrl-backfill.ts`
/// deliberately has none, on the sound argument that the written rows ARE the
/// checkpoint at exactly the granularity that matters, and MONEY-1189 is a
/// catalogue of checkpoints that recorded DONE for work that never happened.
///
/// That argument does not hold here, because the outcomes that MUST be
/// remembered are precisely the ones that write NO ROWS. All three are real and
/// were measured against our live token on 2026-08-28:
///   - `ENE` (Enron)  -> HTTP 404. No metadata, no bars.
///   - `LEH` (Lehman) -> HTTP 200 with an EMPTY array and null start/end dates.
///   - a recycled ticker -> 200 with the SUCCESSOR's bars, which must be
///     refused rather than filed under the delisted security's identity.
/// With rows as the only checkpoint, each of these is indistinguishable from
/// "never attempted" and would be re-fetched on every run, forever.
///
/// Statuses. DONE = bars written. EMPTY / NOT_FOUND = upstream genuinely has
/// nothing; terminal for a run but re-checkable by age, never promoted to "this
/// security does not exist". RECYCLED = the response described a different
/// security than the one asked for (fetched first bar postdates the master's
/// listing end) and was deliberately not written. ERROR = transport or parse
/// failure, always retried.
///
/// `EMPTY` is kept distinct from `NOT_FOUND` for the MONEY-1169 reason: a
/// status that conflates "answered with nothing" and "was not there" is the
/// shape in which failure wears the DONE label.
model BackfillCheckpoint {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  jobKey String // e.g. "tiingo-us-eod" — namespaces one backfill from another

  /// The work item this row checkpoints, as the JOB defines it. A symbol for
  /// the EOD backfill; an ex-DATE for the corporate-actions day-walk.
  ///
  /// Named generically because it IS generic, which the columns it replaces
  /// were not. They were `symbol` and `exchange`, and the corp-actions backfill
  /// stored `symbol: exDate, exchange: route` in them — a date in a column
  /// called symbol, a route in one called exchange. Both jobs worked; the
  /// schema said something false about both. A name that has to be read as a
  /// lie at every call site is a name that will eventually be believed.
  itemKey String
  /// Optional second dimension: exchange for a symbol, feed route for a date.
  scope   String

  status String // DONE | EMPTY | NOT_FOUND | RECYCLED | ERROR
  /// Bars from this response that are IN THE TABLE: created + upgraded +
  /// preserved. Not `created + upgraded` — on a repair re-run the bars a
  /// previous run already stored come back as `preserved`, and strict counting
  /// would checkpoint `rows: 100` for a symbol holding 11,517. Not
  /// `bars.length` either, which is what it used to be: both sides of the
  /// "reconcile against the archive" check then came from one parse, making the
  /// reconcile vacuous by construction. `dupInBatch` and `droppedNonFinite` are
  /// excluded so `rows < fetched` stays a real signal.
  rows   Int    @default(0)
  bytes  Int    @default(0) // Raw response size, for bandwidth accounting

  firstTs DateTime? // Earliest bar seen — compared against the master to detect recycling
  lastTs  DateTime? // Latest bar seen
  detail  String? // Error text / HTTP status, for triage

  at DateTime @default(now())

  /// Compound unique makes the checkpoint write an idempotent upsert, so a run
  /// killed mid-symbol and restarted cannot double-count.
  @@unique([jobKey, itemKey, scope])
  @@index([jobKey, status])
  @@map("backfill_checkpoints")
}

/// One Databento batch job — MONEY-1373.
///
/// THIS ROW IS THREE THINGS AT ONCE, and it is one table rather than three
/// because they are three readings of a single fact and a second copy of that
/// fact is a second thing to drift:
///
///   1. THE DOWNLOAD INVENTORY. `files[]` carries what the job produced and
///      what we did with each file, so a resumed download knows what already
///      landed and a load knows what it has already read.
///   2. THE MONTHLY BUDGET LEDGER. Databento bills per job, and the only place
///      the spend is recorded is here.
///   3. THE APPEND'S HIGH-WATER MARK. `databento-append` asks "what is the
///      latest `end` this manifest entry has DONE?" and starts there. So a
///      forgotten row is not a missing record — it is a re-harvest of a range
///      we already paid for.
///
/// `costUsdQuoted` EXISTS BECAUSE `costUsd` IS NULL AT SUBMISSION. Databento
/// fills the actual cost only once the job is PROCESSED, which can be hours
/// later; a ledger that summed `costUsd` alone would therefore read ~0 for
/// everything currently in flight — exactly when a budget check is worth
/// running. `metadata.get_cost` is taken BEFORE submission and stored here, and
/// the ledger sums `costUsd ?? costUsdQuoted`: the real figure when it exists,
/// the quote as the standing estimate until then. Never one column that gets
/// overwritten — the quote is also what a PROBE or COST_MODEL run is checked
/// against, and losing it would make an over-billed job undetectable.
///
/// `end` IS EXCLUSIVE, because Databento's own range parameters are. Storing it
/// inclusive here would make this row disagree with the request that created it
/// by one day, silently, in the field the append reads to decide where to
/// resume — so every append would either re-buy a day or skip one, forever, and
/// both look like ordinary data.
model DatabentoBatchJob {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// Databento's own job id. OPTIONAL, and that is load-bearing: the budget
  /// guard creates this row in `QUOTED` BEFORE `batch.submit_job` runs, so that
  /// a crash between the two leaves a visible row rather than spend nobody can
  /// find. A required column would make that ordering impossible to express.
  jobId String?

  /// WHY this job was submitted, which is not derivable from what it fetched.
  /// HARVEST is the bulk history buy; APPEND the nightly extension; PROBE a
  /// cheap entitlement/shape check; COST_MODEL the spread sample the builder
  /// consumes. Distinguishing them is what lets the budget ledger report what
  /// the money went ON rather than only how much.
  purpose String // HARVEST | APPEND | PROBE | COST_MODEL

  dataset String // EQUS.MINI
  schema  String // ohlcv-1m | ohlcv-1h | ohlcv-1s | bbo-1m | tbbo | definition | statistics

  /// The manifest entry this job fulfils, e.g. `ohlcv-1m-baseline`. The append
  /// resumes per ENTRY, not per schema: two entries can share a schema and
  /// differ in symbol set, and merging their high-water marks would have one
  /// entry's progress silence the other's.
  entryId String

  /// Human-readable name of the symbol population, e.g. `MASTER:3/8`. A LABEL,
  /// never the identity — see `symbolsHash`.
  symbolSet String

  /// sha256 of the sorted OUR-notation symbol list, which IS the identity of
  /// what was bought. `symbolSet` is a label an operator chose and two different
  /// populations can wear the same one; a shard boundary that moves leaves the
  /// label untouched. Sorted before hashing so request order cannot make one
  /// population hash two ways. OUR notation (not the vendor's) because that is
  /// the spelling every reader on this side joins on.
  symbolsHash String
  symbolCount Int

  start DateTime // inclusive UTC
  end   DateTime // EXCLUSIVE UTC — Databento's own convention; see the model note

  costUsdQuoted Float // metadata.get_cost, taken BEFORE submission
  costUsd       Float? // from the job response; NULL until the job is processed

  state String // QUOTED | SUBMITTED | PROCESSING | DONE | DOWNLOADED | LOADED | EXPIRED | FAILED

  /// THE SPLIT SHAPE THIS JOB WAS ACTUALLY BOUGHT WITH — MONEY-1382.
  ///
  /// Deliberately NOT in the `@@unique`: it is not part of a window's
  /// identity, and adding it would let the same window be bought twice in two
  /// shapes. It is recorded because the shape is otherwise knowable only at
  /// the vendor, and a reader that needs it had to guess from the MANIFEST —
  /// which describes what the entry would be bought as TODAY, not what this
  /// row holds. The first harvest was bought `split_symbols=false,
  /// split_duration=day` and the manifest was then corrected to `true`/`year`,
  /// so a manifest-based check answered "symbol-split" about a day-split job
  /// and a sharded load would have silently lost rows.
  ///
  /// NULL on every row predating this column, and null is the SAFE reading:
  /// "unknown shape" refuses a sharded load, and the rows with an unknown
  /// shape are exactly the legacy ones that are dangerous.
  splitSymbols  Boolean?
  splitDuration String?

  recordCount BigInt?
  /// Bytes billed. BigInt, not Int: a 1h MASTER job clears Int32 on its own,
  /// and an overflowed size would understate the very ledger this row keeps.
  billedSize  BigInt?

  /// `[{filename,size,sha256,archiveKey,verified,loadedRows,loadedAt}]` — the
  /// per-file inventory. Json rather than a child table because nothing ever
  /// queries a file except through its job, and a relation would buy a join for
  /// no reader.
  files Json

  /// MONEY-1472 (B1) — has this job's inventory reached `lake_bronze_PROD.source_object`?
  ///
  /// PROD IS THE ONLY WRITER, and the flag must be read as a PROD fact even on
  /// a QA row. Databento is a paid metered vendor: its schedulers are prod-only
  /// (`setup_databento_schedulers` skips-and-deletes on non-prod) because "a QA
  /// trigger would spend real money to produce rows the next restore deletes",
  /// and `databento_batch_jobs` is a REFERENCE_COLLECTION — QA receives these
  /// rows BY COPY from prod.
  ///
  /// So a QA row arrives carrying `ledgerBacked: true` while `lake_bronze_qa`
  /// is empty, and that is CORRECT rather than drift: the inventory it refers
  /// to is prod's. Do not "fix" it by running the backfill against QA — that
  /// would write a ledger for objects QA's own jobs never acquired, and the
  /// next sync-prod-to-qa restore would overwrite the flag anyway.
  ///
  /// The ledger is the new source of truth and `files` is kept only until B5
  /// finishes. This flag is what makes the transition SELF-HEALING: it is set
  /// only when the ledger write SUCCEEDED, so `ledger-backfill-databento`
  /// re-selects anything a harvest could not mirror — a BigQuery blip after the
  /// vendor has already been PAID must not lose the inventory, and must not be
  /// silently forgotten either.
  ///
  /// SELECT IT IN RAW MONGO. NO PRISMA PREDICATE WORKS.
  ///
  /// A `db push` creates indexes and not fields, so every pre-existing row has
  /// this ABSENT. This comment used to say `{ not: true }` matches absent and
  /// `{ equals: false }` does not. MEASURED on prod 2026-09-17, 69 rows, field
  /// absent on all 69:
  ///
  ///     raw    { ledgerBacked: { $ne: true } }      69
  ///     raw    { ledgerBacked: { $exists: false } } 69
  ///     prisma { ledgerBacked: { not: true } }       0
  ///     prisma { ledgerBacked: false }               0
  ///
  /// Prisma compiles `not` to `$and:[{$ne:[f,true]},{$ne:[f,"$$REMOVE"]}]`, and
  /// the second clause EXCLUDES every absent field. The job shipped with
  /// `{ not: true }`, selected nothing, printed "Nothing to do." and exited 0
  /// with an empty ledger — the MONEY-1050/1234/1235 class again, from the
  /// other side, inside the comment warning about it.
  ///
  /// A `@default(false)` does NOT fix it: Prisma applies defaults at CREATE, so
  /// these 69 rows stay absent for ever. Use `$runCommandRaw`.
  ledgerBacked Boolean?

  submittedAt  DateTime?
  /// When Databento stops serving the output. Past this, the ONLY way back to
  /// the bytes is to buy the range again, so it is stored rather than inferred.
  tsExpiration DateTime?
  downloadedAt DateTime?
  loadedAt     DateTime?
  loadedRows   Int       @default(0)

  detail String? // Error text / HTTP status / skip reason, for triage

  env String // prod | qa

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// THE IDENTITY OF A PURCHASE, and the structural half of "a window is never
  /// bought twice". `withDatabentoBudget` looks a window up on exactly these
  /// six fields before it quotes; this makes a second row impossible rather
  /// than merely unlikely, which matters because the failure mode is a
  /// duplicate SPEND and not a duplicate read.
  @@unique([purpose, entryId, schema, symbolsHash, start, end], name: "databento_window")
  /// NOT `@@unique`, deliberately. MongoDB's unique indexes are not sparse:
  /// a missing field indexes as null, and null collides with null — so a unique
  /// index over an optional `jobId` would admit exactly ONE un-submitted
  /// `QUOTED` row in the whole collection and reject every later one with a
  /// duplicate-key error that names a field the operator never set.
  @@index([jobId])
  /// The append's resume query: latest DONE `end` for one entry and purpose.
  @@index([purpose, entryId, state, end])
  /// The budget ledger's window scan.
  @@index([submittedAt])
  @@map("databento_batch_jobs")
}

/// One BUILD of the US transaction-cost model — MONEY-1373.
///
/// Versioned, and read version-PINNED, because a backtest must stay
/// re-runnable. A backtest run in March against March's spreads and re-run in
/// September against September's would produce two different P&Ls from
/// identical strategy code, with nothing in either result naming the
/// difference — the costs moved underneath it. Every backtest and ForwardRun
/// therefore records the `modelVersion` it used and reads only that one; a new
/// build is an ADDITIONAL version, never an edit of the incumbent.
///
/// `status` exists so a half-written build cannot be selected: rows are
/// inserted under BUILDING and the version flips to READY only once the whole
/// row set has landed. Without it "the newest version" would name a partial
/// model whose missing (listingId, todBucket) cells read as "no cost".
///
/// CONSUMED BY THE PYTHON QUANT-ENGINE OVER MONGO, BY COLLECTION NAME. There is
/// no import across that boundary in either direction — the seam is the
/// database, exactly as it is for the EDGAR service — so the `@@map` names here
/// are a published interface, and renaming one is a breaking change on a side
/// that TypeScript cannot see.
model UsCostModelVersion {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  modelVersion Int

  /// The sample WINDOW the model was fitted over, which is not when it was
  /// built: a rebuild triggered late still describes its own window, and
  /// judging a model's staleness from `builtAt` would call a backfilled build
  /// fresh.
  builtFrom DateTime
  builtTo   DateTime
  builtAt   DateTime

  trigger String // MONTHLY | MANUAL

  /// The `DatabentoBatchJob.jobId`s the sample came from. Stored so a version
  /// can be traced back to the bytes it was fitted on — and so a job found to
  /// be bad names the versions that have to be rebuilt.
  sourceJobIds String[]

  rowCount    Int
  symbolCount Int

  /// The window the EFFECTIVE-spread sample came from — MONEY-1373 D1.
  ///
  /// SEPARATE from `builtFrom`/`builtTo` on purpose. The quoted spread is
  /// sampled over the 365 days those describe; the effective spread comes from
  /// the archived `tbbo` entry, which is `append: false` — bought once, never
  /// topped up — so its window is anchored at the ARCHIVE and stops moving the
  /// day the harvest finishes. In year three a version whose `builtFrom` reads
  /// `now-365d` carries an effective column sampled from a fixed 92 days two
  /// years earlier, and without these three columns nothing in either
  /// collection says so. The quant engine is PYTHON and reads these
  /// collections directly, so a caveat that lives in a TypeScript comment does
  /// not reach it.
  ///
  /// Absent on every row written before this shipped, and on any build whose
  /// trade leg found no file. NEVER filter on `{ effectiveFrom: null }` — a
  /// Mongo `db push` creates indexes and not fields, so both `null` and
  /// `{ not: null }` return zero on pre-existing rows (MONEY-1050 / 1234 /
  /// 1235). Test for presence in application code.
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  effectiveFileCount Int?

  status String // BUILDING | READY | FAILED
  detail String?

  createdAt DateTime @default(now())

  @@unique([modelVersion])
  @@map("us_cost_model_versions")
}

/// One (version, listing, time-of-day) cost cell — MONEY-1373.
///
/// Keyed on `listingId` rather than `symbol` for the reason `Candle` is: a
/// ticker is not a security, and Tiingo's master carries two `DOW` rows on
/// NYSE. Pricing a backtest of Dow Chemical with Dow Inc.'s spreads is wrong in
/// a way no number on the row could reveal. `symbol` rides along for reading
/// and is never the join key.
///
/// The TOD bucket is part of the key because the spread is not one number per
/// day: an open-auction fill and a mid-session fill differ by a multiple on the
/// same name, and collapsing them would under-cost exactly the aggressive
/// entries a strategy is most likely to be wrong about.
///
/// Read VERSION-PINNED, always — see `UsCostModelVersion`. Consumed by the
/// Python quant-engine over Mongo by collection name, never by import.
model UsCostModelRow {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  modelVersion Int
  listingId    String
  symbol       String

  liquidityTier String // T1 | T2 | T3
  todBucket     String // PRE | OPEN30 | MID | CLOSE30 | POST

  medianSpreadBps Float
  /// The tail, kept beside the median because a strategy sized on the median
  /// alone is priced on its best half. A cell whose p75 is a multiple of its
  /// median is a name whose cost is a distribution, not a constant.
  p75SpreadBps    Float
  /// How many observations the two figures above were computed from. A cell
  /// fitted on three quotes is not a measurement, and without this column it is
  /// indistinguishable from one fitted on three thousand.
  sampleCount     Int

  /// QUOTED-size and EFFECTIVE-spread columns, nullable because they come from
  /// a richer schema (tbbo) than the baseline sample and are simply ABSENT for
  /// a cell built from bbo alone. Null here means "this build could not measure
  /// it", never "it is zero" — a zero effective spread would price a fill as
  /// free.
  medianQuotedSizeShares Float?
  effectiveSpreadBps     Float?
  effectiveSampleCount   Int?

  createdAt DateTime @default(now())

  @@unique([modelVersion, listingId, todBucket])
  @@index([modelVersion, liquidityTier])
  @@map("us_cost_model_rows")
}

/// US corporate actions from Tiingo — MONEY-1263.
///
/// ## Why this is NOT `corporate_actions`
///
/// That table's readers scope by SYMBOL and deliberately not by exchange.
/// `udf/marks/route.ts` says so outright — "NOT scoped to one exchange, because
/// a corporate action belongs to the company rather than a listing" — and
/// `pairing.ts` selects `{ OR: [{symbol in ...}, {isin in ...}] }` with no
/// exchange term at all, feeding FIFO COST BASIS.
///
/// That reasoning is correct for India, where a symbol names one company. It
/// becomes false the moment US rows share the table: measured 2026-08-28, 214
/// active Indian symbols collide with a US ticker — ACC, BABA, AUTO, BBOX among
/// them. A US split filed under `ACC` would mis-adjust the cost basis of a real
/// ACC Cement holding, and a US dividend would draw a glyph on its chart.
/// Nothing would error, and the number that came out would look ordinary.
///
/// Scoping every consumer is a change to everything that inherits their
/// assumption. A separate table is contained, and it is the same seam the US
/// price backbone already uses.
///
/// ## Why the key is permaTicker and not the ticker
///
/// The market-wide batch form returns TWO rows both labelled `ticker: "reax"`
/// for 2026-08-25 — identical 10->1 splits, DIFFERENT `permaTicker`s, because
/// they are two different companies (Real REMAX Group and The Real Brokerage).
/// The per-ticker form returns only one of them. A ticker-keyed unique would
/// silently collapse them into one action.
///
/// `permaTicker` is 100% populated ON ROWS THAT EXIST — its failure mode is
/// zero rows, never a null field — which is exactly what a key needs.
model UsCorporateAction {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// Tiingo's durable security id, e.g. "US000000000038". The key.
  permaTicker String
  /// The ticker as filed. Informational: it is NOT an identity (see above).
  symbol      String
  /// Occupancy window this action belongs to, when resolvable from our master.
  /// Nullable because a corporate action can arrive for a security we do not
  /// carry — that is a real record, and requiring the join would discard
  /// exactly the rows that reveal a coverage gap.
  listingId   String?

  type   String // DIVIDEND | SPLIT
  exDate DateTime

  /// ── DIVIDEND ──────────────────────────────────────────────────────────
  /// Per-share cash, gross, in the listing currency. NOT annualised.
  ///
  /// Filter `> 0`, never `!= null`: three genuine 0.0 rows exist in the live
  /// data (AAPL 2022-12-23 among them, fully date-populated), so zero is a
  /// real value rather than a placeholder.
  ///
  /// Special and irregular dividends arrive as SEPARATE rows, not merged —
  /// COST's 2023-12-27 $15.00 sits beside its $1.02 quarterlies. There is NO
  /// field distinguishing return-of-capital or stock dividends from ordinary
  /// income; the API carries no character marker at all.
  distribution          Float?
  /// w|bm|m|tm|q|sa|a|ir|f|u|c. Only `q` and `ir` were ever observed live.
  distributionFrequency String?

  /// ── SPLIT ─────────────────────────────────────────────────────────────
  /// Share multiplier = splitTo / splitFrom, so a REVERSE split is < 1
  /// (GE 2021-08-02 is 0.125, a 1-for-8).
  ///
  /// NEVER equality-test this. AAPL's 2014 7-for-1 is stored upstream as
  /// 7.000007000007001, and UNTY's as 1.09999989.
  splitFactor Float?
  /// The human ratio ("7-for-1"). Populated on 2 of 67 live rows, both 2024 or
  /// later — for any historical split only `splitFactor` exists.
  splitFrom   Float?
  splitTo     Float?

  /// ── Announcement dates ────────────────────────────────────────────────
  /// Added upstream 2024-01-04 and backfilled only to 2020, so these are ~17%
  /// populated overall and ~90% from 2024. The nulls are a time cliff, not
  /// noise — do not read a null as "no payment date exists".
  paymentDate     DateTime?
  recordDate      DateTime?
  declarationDate DateTime?

  /// USD today. Explicit because every existing dividend consumer hardcodes a
  /// rupee symbol, and a currency-less amount is how that becomes wrong.
  currency String @default("USD")
  source   String @default("TIINGO")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([permaTicker, type, exDate])
  @@index([symbol, exDate])
  @@index([listingId, exDate])
  /// The nightly leg and the day-walk backfill both select one ex-date across
  /// the whole market.
  @@index([exDate])
  @@map("us_corporate_actions")
}

// ============================================================================
// US FILING INSIGHTS — MONEY-1324 (P17)
// ============================================================================
//
// ⚠️ THIS MODEL IS DELIBERATELY ABOVE THE MONEY-979 MARKER, and moving it below
// breaks the build. `schema-parity.test.ts` slices `schema.prisma` at the
// banner comment that opens the next section and matches EVERY model
// from there to END OF FILE against the ELEVEN the Python service writes. A
// twelfth model in that slice is not a one-file change — it needs a row model
// and a MODELS entry in `services/us-fundamentals/app/store/models.py`, a
// `@@map` in that service's `collections.py`, a regenerated
// `tests/_schema_snapshot.json` and a sync-plan entry.
//
// None of that applies here, because PYTHON DOES NOT WRITE THIS TABLE. Sitting
// above the marker is the STRUCTURAL statement of that fact, in the one place
// a test can check it, and `us-filing-insight-isset-arms.test.ts` pins the
// placement so a tidy-minded move fails loudly instead of at `yarn test`.
//
// ── WHO WRITES IT, AND WHY THAT ANSWERS P2032 ──────────────────────────────
//
// SOLE WRITER: `workers/src/processors/us-filing-insight.ts`, through PRISMA.
// The analysis is a Gemini call and Gemini lives on the TypeScript side, so
// there is no pymongo path to this collection and none is wanted.
//
// That is what makes `ingestedAt @default(now())` and `updatedAt @updatedAt`
// SAFE here, and the distinction is not academic — it is MONEY-1317, which
// measured 785,352 unreadable rows across SEVEN collections on prod
// 2026-09-01. Both attributes are applied by the PRISMA CLIENT, not by
// MongoDB. A pymongo writer that does not supply them stores the column ABSENT,
// and every later Prisma read of that row raises:
//
//     PrismaClientKnownRequestError  P2032
//     Error converting field "ingestedAt" of expected non-nullable type
//
// Prisma writes them on every create and update here, so the columns can never
// be absent. IF A PYTHON WRITER IS EVER ADDED, it must route through
// `_with_storage_timestamps` in `services/us-fundamentals/app/store/writers.py`
// (`$setOnInsert` for `ingestedAt`, `$set` for a DECLARED `updatedAt`) and this
// model must move into the MONEY-979 block with all five coordinated changes.
//
/// One analysed filing document -> one insight. MONEY-1324 (P17).
///
/// The text this reads has existed since MONEY-979; what had never run is the
/// ANALYSIS. `us_filing_documents` holds the extracted text in GCS at
/// `edgar/text/{cik10}/{accession}/{seq}.txt` with `textPath` / `textBytes` /
/// `textHash` on the row.
///
/// ── THE UNIQUE KEY, AND THE THREE COLUMNS DELIBERATELY OUTSIDE IT ─────────
///
/// `@@unique([accession, sequence])` — the SAME key as `UsFilingDocument`,
/// because an insight IS one document's reading and the two tables are 1:1.
/// A re-analysis is therefore an UPDATE, never a duplicate row.
///
/// `model`, `promptVersion` and `sourceTextHash` are PROVENANCE and are
/// deliberately NOT in the key. Adding any of them would make each model
/// revision a SEPARATE ROW for one document, which every reader — a stock
/// page, a research tool, a count — would silently double-count while looking
/// entirely normal. That is precisely the reasoning already written down for
/// `StockFinancials.basis` in CLAUDE.md, and the mistake it warns against.
///
/// The cost of keeping them out is that the PREVIOUS reading is destroyed on
/// re-analysis. Accepted, and named rather than discovered: `sourceTextHash`
/// records WHICH bytes produced the row that survives, so a re-extraction that
/// changed the text is DETECTABLE (hash differs -> re-analyse) and a re-run
/// over identical text is a provable no-op (hash equal -> write nothing).
/// Keeping history would need a separate append-only table; it is deferred
/// until a reader wants it rather than built on spec.
///
/// ── NO PRISMA RELATION, ON PURPOSE ────────────────────────────────────────
///
/// `documentId` is a plain String holding `UsFilingDocument.id`, NOT an
/// `@relation`. A REQUIRED relation whose target is missing does not read null
/// — it THROWS, and the throw kills the whole query, so ONE orphaned row blanks
/// every result the caller asked for (MONEY-1216). The natural key above is
/// already sufficient to find the document; the id is for tracing only.
model UsFilingInsight {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// Together the unique key. Mirrors `UsFilingDocument` exactly.
  accession String
  sequence  Int

  /// `UsFilingDocument.id` as a plain string — see the NO-RELATION note above.
  documentId String

  /// Denormalised from the document so a reader needs no second query, and so
  /// the rotation index below can exist at all.
  cik10        String
  symbol       String?
  form         String
  documentType String
  filedAt      DateTime

  /// ── THE DISCRIMINATOR ─────────────────────────────────────────────────
  ///
  /// EARNINGS_RELEASE | FINANCIAL_STATEMENTS | PRESS_RELEASE |
  /// PROXY_OR_MEETING | BUSINESS_DESCRIPTION | OTHER | UNCLASSIFIED
  ///
  /// The first six are `FILING_DOCUMENT_CLASSES` in
  /// `packages/core/src/market-data/filing-insight-logic.ts` — the list the
  /// model is CONSTRAINED TO by its own `responseSchema`, and therefore the
  /// only list that can be true about this column. The sweep IMPORTS it rather
  /// than restating it; `us-filing-insight-isset-arms.test.ts` pins this
  /// comment against that constant, because a doc comment cannot fail a build
  /// on its own and this enumeration was already wrong once.
  ///
  /// `UNCLASSIFIED` is the SWEEP's sentinel and is deliberately absent from
  /// the model's schema: it marks a FAILED or SKIPPED row, which is an attempt
  /// with no reading behind it. Letting the model emit it too would make "the
  /// model could not classify this" indistinguishable from "nothing read it".
  ///
  /// ONE SHAPE AND ONE DISCRIMINATOR, not one table per class, because the
  /// cohort is MEASURABLY heterogeneous. The EX-99.1 read while designing this
  /// (Hornbeck Offshore, accession 0001193125-26-378529 seq 11) is AUDITED
  /// CONSOLIDATED FINANCIAL STATEMENTS attached to a merger 8-K carrying items
  /// 1.01/2.01/5.01 — not an earnings release, which is what an EX-99.1 is
  /// usually assumed to be.
  ///
  /// So a new class must not need a migration, and a MISCLASSIFIED document
  /// must degrade to FEWER FIELDS rather than fail: every field below is
  /// optional, an empty `facts` list is a legal reading, and `UNCLASSIFIED`
  /// is a legal, writable answer.
  documentClass String

  /// ── THE READING ───────────────────────────────────────────────────────
  ///
  /// THESE COLUMNS MIRROR `FilingInsight`
  /// (`packages/core/src/market-data/filing-insight-logic.ts`) FIELD FOR
  /// FIELD, AND THAT IS THE POINT. Do not "improve" them back into typed
  /// per-class blocks — that is what they were, and it is what could not be
  /// checked.
  ///
  /// The analyser runs two validators before this row is ever written, and
  /// BOTH operate on these exact shapes: `checkFactsGrounded` (every figure
  /// must appear in the text the model was actually shown) and
  /// `checkTotalsCrossFoot` (a printed total must equal the components
  /// printed under it). Storing a RE-SHAPED copy — `earnings` / `guidance` /
  /// `statements` / `transaction`, which is what these columns were until
  /// MONEY-1324's integration — would mean the row a reader trusts is not the
  /// object either check ever looked at. The validation would then protect
  /// nothing while looking like it protected everything, which is strictly
  /// worse than no validation, because it is not visible from either side.
  /// Nothing had been written to this table yet, so the alignment was free.
  /// It is not free once rows exist.
  ///
  /// PRESENT ON A READING, ABSENT ON AN ATTEMPT. A READY row always carries
  /// all three — `[]` is the zero of a list and is queryable, and a proxy
  /// circular genuinely has no `statementTotals`. A FAILED or SKIPPED row
  /// omits them entirely, because there is no reading behind it. NEVER null
  /// in either case: on Mongo `{f: null}` and `{f: {not: null}}` BOTH return
  /// zero rows, so a null is unqueryable in both directions
  /// (MONEY-1050/1205/1234/1235/1236).
  ///
  /// `facts`           FilingFact[]  {label, value, periodLabel,
  ///                                  statementType, sourceLine}
  /// `statementTotals` FilingTotal[] a printed total + the components the
  ///                                 DOCUMENT prints under it
  /// `events`          FilingEvent[] {kind, description, date}
  facts           Json?
  statementTotals Json?
  events          Json?

  /// ── THE UNITS, STATED ONCE ────────────────────────────────────────────
  ///
  /// Figures are stored AS PRINTED and the scale is deliberately NOT applied:
  /// a model that multiplies can multiply wrongly, and a silently scaled
  /// figure can no longer be found in the source text, which would defeat the
  /// grounding check on every value at once.
  ///
  /// `FilingFact` therefore carries NO per-value currency or scale — the
  /// document states them once, in its own units header, and so do these two
  /// columns. A `facts` array stored WITHOUT them is a column of numbers that
  /// may be off by 1,000x with nothing on the row to reveal it, which is the
  /// currency-less-amount defect this schema's own MONEY-979 rule 3 names.
  ///
  /// UNITS | THOUSANDS | MILLIONS | BILLIONS | UNKNOWN.
  unitScale String?
  /// ISO 4217. Absent when the document does not say — never assumed USD.
  reportingCurrency String?

  /// HIGH | MEDIUM | LOW. LOW is a signal to a human, not an error, and it
  /// includes the DEGRADED low `normaliseFilingInsight` stamps when the model
  /// named a class the response schema does not offer — the model's own
  /// confidence referred to a class we did not accept.
  classConfidence String?

  registrant String?
  /// The period AS PRINTED, e.g. "Year ended December 31, 2025".
  periodLabel String?
  /// ISO 8601 `YYYY-MM-DD`, as a STRING and only when the document states one
  /// unambiguously. Not a DateTime: materialising it would invent a timezone
  /// the filing never gave — the reason `UsFiler.fiscalYearEnd` stores "0930"
  /// as text rather than as a date.
  periodEndDate String?

  summary String?
  /// Empty list, never null — a list has a natural zero and `[]` is queryable.
  keyPoints String[]

  /// NO `headline` AND NO `tickersMentioned`. Both were here, and NOTHING
  /// produces either: the analyser's response schema has no headline field,
  /// and it never resolves a ticker (that is a join against `us_instruments`,
  /// not a reading of the text). A column its only writer cannot fill is a
  /// permanent null that reads as "this document mentioned no tickers".

  /// ── PROVENANCE ────────────────────────────────────────────────────────
  ///
  /// PENDING | READY | FAILED | SKIPPED. `SKIPPED` is terminal-by-content (the
  /// document carries nothing analysable) and is DISTINCT from `FAILED`, which
  /// is transient and re-selectable — collapsing the two makes a permanent
  /// no-op burn a model call on every sweep forever.
  insightStatus String @default("PENDING")
  /// Populated only alongside FAILED/SKIPPED. Operator-facing.
  failureReason String?

  /// Which model produced this row. Null until the analysis has run.
  model String?
  /// The prompt + parser revision, so a prompt change is a detectable cause of
  /// a changed reading. Bumping it does NOT create a row — see the key note.
  promptVersion String?
  /// `UsFilingDocument.textHash` AT THE TIME OF ANALYSIS. The idempotency key:
  /// equal means the bytes are unchanged and a re-run writes NOTHING.
  sourceTextHash String?
  /// Bytes actually handed to the model, which is not `textBytes` when the
  /// section selector trims — so cost is attributable to what was SENT.
  analysedBytes Int?
  analysedAt    DateTime?

  promptTokens Int?
  cachedTokens Int?
  outputTokens Int?

  source String @default("SEC_EDGAR")

  /// Prisma-applied. See the P2032 note above before adding any other writer.
  ingestedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([accession, sequence])
  /// THE ROTATION INDEX, ordered ASC by the sweep. `us_filing_documents` GROWS
  /// DAILY, so a `desc` sweep pushes the oldest rows further down every cycle
  /// and never reaches them — measured as a real defect twice (MONEY-1211:
  /// 681 of 781 symbols never selected; MONEY-1255: a newest-first queue with
  /// ~2 years of undrainable backlog).
  @@index([filedAt])
  @@index([insightStatus, filedAt])
  @@index([symbol, filedAt])
  @@index([documentClass, filedAt])
  @@map("us_filing_insights")
}

// ============================================================================
// INSTRUMENT EVENTS — the unified event stream (MONEY-1507, data-platform C1)
// ============================================================================
//
// DELIBERATELY ABOVE the MONEY-979 block. `services/us-fundamentals`'s
// `tests/test_store_models.py` parses EVERY `model X {}` from that header to the
// end of this file and asserts it finds exactly the eleven the Python row models
// mirror; a twelfth declared after it fails that test and its TypeScript twin
// `schema-parity.test.ts`. This model has no Python writer, so it belongs
// outside that block rather than inside it with an exemption.

/// The serving copy of `lake_silver.instrument_event` — MONEY-1507 (C1).
///
/// The LAKE is the permanent record; this is a bounded hot window with a stated
/// eviction rule, which is what lake-layout.md §8 demands of anything landing in
/// Mongo at all ("no new history defaults to Mongo"). 90 days (MONEY-1521) is
/// the longest-lived reader's need: C4's evaluator reads `observedAt > last
/// run` (minutes), the events tab and `/discover/news?entity=` show 30–90 days.
/// Anything older is a lake query.
///
/// ## `expiresAt` IS WRITTEN BY THE LAKE SINK AND BY NOTHING ELSE — MONEY-1521
///
/// Mongo's TTL monitor deletes on `{expireAfterSeconds: 0}` against a DATE
/// column, and SKIPS a document whose indexed field is absent or not a date.
/// That skip is the design. `publishEvents` never writes the field, so a row is
/// born un-expirable; `scripts/jobs/event-lake-sink.ts` stamps `observedAt +
/// 90d` only AFTER its silver INSERT has returned, and only while the row still
/// matches the key silver holds. A sink that is broken, unscheduled or behind
/// therefore makes Mongo GROW — visible, alertable — instead of deleting rows
/// the lake never took. The previous design (every upsert stamped
/// `observedAt + 30d`) was a timer with no knowledge of the lake.
///
/// So the field is OPTIONAL and has NO `@default`, deliberately: a required
/// field or a default would stamp every create and restore the timer. A test in
/// packages/services pins both.
///
/// The index is created by `ensureInstrumentEventIndexes()` in
/// `packages/services/src/events.service.ts`. Prisma's `db push` creates no TTL
/// index — and DROPS this one (measured 2026-09-23, read-only `prisma migrate
/// diff` against prod) — and an `@@index([expiresAt])` here would create a PLAIN
/// one that deletes nothing while looking exactly like the TTL it is not.
///
/// ## EVERY OPTIONAL FIELD HERE IS ABSENT, NOT NULL, ON A ROW THAT PREDATES IT
///
/// A Mongo `db push` creates INDEXES, not FIELDS. So `{listingId: null}` and
/// `{listingId: {not: null}}` both return ZERO against rows written before the
/// column existed — the class that has now caused MONEY-1050, 1205, 1234 and
/// 1236. Filter POSITIVELY (`{listingId: "AAPL:NASDAQ:1980-12-12"}`,
/// `{market: "US"}`), never on the absence of one of these.
model InstrumentEvent {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// sha1(source NUL sourceRecordKey), lowercase hex. DERIVED by
  /// `buildEventId()` in packages/core/src/events/event-types.ts, never chosen:
  /// four EDGAR detectors converge on one filing and the upsert on this key is
  /// what collapses them into one row.
  eventId String

  /// US | IN. A COLUMN, never a second collection.
  market String

  /// `{symbol}:{venue}:{listingStartDate}` — the SAME spelling `Candle.listingId`
  /// and `UsInstrument.listingId` use. NULL when the filer is not mapped to a
  /// security; the event is still true about the FILER and `confidence` says so.
  listingId String?

  /// The FILER: `cik10` for SEC, a scrip code / ISIN for India. At least one of
  /// `listingId` / `entityId` is always present — enforced by the zod contract.
  entityId String?

  /// FILING_8K | FILING_10Q | FILING_10K | FILING_13F | FILING_OTHER |
  /// INSIDER_TXN | OWNERSHIP_13D_G | NEWS | CORP_ACTION | RESULT.
  ///
  /// A `String`, not a Prisma enum: the vocabulary's one source of truth is
  /// `EVENT_TYPES` in event-types.ts, which the zod schema refuses against on
  /// write. An enum here would be a second declaration that can disagree.
  eventType String

  /// 0 informational | 1 notable | 2 material (C4's alert floor) | 3 critical.
  severity Int

  title       String
  summary     String?
  evidenceUri String?

  source          String
  /// The source's OWN key, verbatim — an SEC accession, `{articleId}NUL{listingId}`.
  sourceRecordKey String

  /// The SOURCE's clock (EDGAR acceptance, the wire timestamp). NOT the ordering
  /// key: a filing accepted at 21:53 ET is DATED the next business day.
  publishedAt DateTime?
  /// When WE FIRST saw it. The only clock a point-in-time query may use.
  ///
  /// CREATE-ONLY (MONEY-1531): `publishEvents` writes it on the create and never
  /// on an update. It used to rewrite it on every re-emission, and on prod
  /// 11,871 of 11,976 rows carried a re-emission's instant, median 4.8 h after
  /// their own `ingestedAt` — repaired by
  /// `scripts/data/repair-instrument-event-clocks.ts`.
  observedAt  DateTime

  linkerVersion String
  confidence    Float
  tags          String[]

  /// Set on a correction. The superseded row is kept in the LAKE; here the
  /// upsert replaces it, because this copy serves "what is true now".
  supersedesEventId String?
  /// When a later pass (the 8-K insight sweep) added the summary.
  enrichedAt        DateTime?

  /// TTL anchor, stamped ONLY by the lake sink — see the model comment. ABSENT
  /// means "the lake has not confirmed this row", which is also how the sink
  /// finds it again (`isSet: false`, never `null`).
  expiresAt  DateTime?
  /// Written once, by the create — the floor the MONEY-1531 repair restores
  /// `observedAt` to.
  ingestedAt DateTime @default(now())
  /// OUR write clock, and the one the lake sink selects on. The sink's stamp is
  /// a RAW command precisely so it does not move this.
  updatedAt  DateTime @updatedAt

  @@unique([eventId])
  /// The two reads C4 makes: one listing's recent events, and the whole
  /// market's since the last evaluator run.
  @@index([listingId, observedAt(sort: Desc)])
  @@index([market, observedAt(sort: Desc)])
  @@map("instrument_events")
}

// ============================================================================
// US FUNDAMENTALS — SEC EDGAR (MONEY-979)
// ============================================================================
//
// Written by `services/us-fundamentals/` (Python, edgartools 5.53.0 pinned).
// This schema is the CONTRACT: the Python writers emit these exact field names
// and `packages/core/__tests__/us-fundamentals/schema-parity.test.ts` fails the
// build when the two drift. Prisma is the schema of record even though no
// TypeScript writer exists — a Mongo collection with two independent notions of
// its own shape is how MONEY-1234/1235 happened.
//
// THREE RULES INHERITED FROM THE INDIA + TIINGO TABLES, restated because every
// one of them has already cost a release here:
//
//   1. A Mongo `db push` creates INDEXES, not FIELDS. Every attribute added
//      later is ABSENT on pre-existing rows, so `{f: null}` and
//      `{f: {not: null}}` both return ZERO. Filter POSITIVELY, or spell it
//      `OR: [{f: null}, {f: {isSet: false}}]`. Rotation markers are read in
//      `orderBy` only, never in `where`.
//   2. Provenance is not optional. Every row carries `source`, the `accession`
//      it came from, the `filedAt` that makes it point-in-time, and the
//      `parserVersion` that produced it — so a bad parse is identifiable and
//      re-runnable rather than indistinguishable from the truth.
//   3. Amounts are USD. Explicitly, in a column, because every existing
//      financial consumer in this repo hardcodes a rupee symbol and a
//      currency-less amount is exactly how that becomes wrong (MONEY-979
//      decision 10; dual-denomination UI is MONEY-982).

/// One SEC filer, from the nightly `submissions.zip`.
///
/// SEPARATE FROM `UsInstrument` on purpose: a filer is ONE entity and a listing
/// is MANY rows. Measured on prod 2026-08-29, 7,111 active US stock listings
/// carry a CIK but they collapse to 5,695 distinct filers — BAC has 16 tickers
/// (common + 15 preferreds), PSA has 17. Writing filer-level facts onto the
/// listing table would store one company's SIC code seventeen times and leave
/// no place to record "this filer has five fiscal years on file".
model UsFiler {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// Zero-padded to 10 digits — the form every EDGAR URL, bulk filename and API
  /// path uses (`CIK0000320193.json`). Stored padded so a join never has to
  /// guess which spelling it is looking at.
  cik10 String
  name  String

  sic            String?
  sicDescription String?
  /// `MMDD` as SEC publishes it ("0930"), not a date — it is a recurring
  /// annual boundary, and materialising it as a DateTime would invent a year.
  fiscalYearEnd  String?
  entityType     String?
  stateOfInc     String?
  /// `[{name, from, to}]` as filed. Kept because a company that renamed is the
  /// commonest reason a name-based lookup fails on historical filings.
  formerNames    Json[]

  /// Tickers/exchanges AS THE FILER DECLARES THEM, which is NOT our universe
  /// and must never be treated as one — SEC lists what the filer wrote, we list
  /// what Tiingo's security master carries. Divergence is information (a
  /// delisting we have not seen yet), so it is stored rather than reconciled
  /// away.
  tickersAsFiled   String[]
  exchangesAsFiled String[]

  firstFilingAt DateTime?
  latestFiledAt DateTime?

  /// True when this CIK appears on at least one ACTIVE `us_instruments` row.
  /// The statements backfill's universe — 5,695 filers, not SEC's ~15,000.
  inUniverse Boolean @default(false)

  /// Distinct fiscal years with a 10-K / 20-F / 40-F on file, and whether that
  /// reaches five.
  ///
  /// THIS IS THE COVERAGE DENOMINATOR, and it exists so that decision 5 —
  /// "for anything less than 5 years like a SPAC or a new listing, store
  /// everything, and do not fail" — is expressible as a MEASUREMENT rather than
  /// as an exception. A gate that reads "95% of filers have 5+ years" is a gate
  /// that fails every quarter a batch of SPACs lists. A gate that reads "95% of
  /// filers WHO HAVE 5+ YEARS AT SEC have 5+ years here" measures us instead of
  /// measuring the market.
  fiscalYearsOnFile   Int     @default(0)
  eligibleForCoverage Boolean @default(false)

  source      String   @default("SEC_EDGAR")
  ingestedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([cik10])
  @@index([inUniverse, eligibleForCoverage])
  @@index([sic])
  @@index([latestFiledAt])
  @@map("us_filers")
}

/// Every filing we have seen, from any of the four detection sources.
///
/// The unique `accession` is the FAN-OUT GUARD, not a tidy-up: detection
/// inserts before it publishes, so a duplicate-key error is how a second
/// detector learns the filing is already claimed. Two pollers, a redelivery and
/// the nightly ledger all converge on one row and one Pub/Sub message.
model UsFiling {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// Dashed form, `0000320193-26-000106`.
  accession String
  cik10     String
  form      String

  /// `filedAt` is the FILING DATE (a calendar day at SEC). `acceptedAt` is the
  /// acceptance TIMESTAMP, and only the second one can measure latency — the
  /// detection histogram is `now - acceptedAt`. A filing accepted at 21:53 ET
  /// is dated the next business day when it lands after the 17:30/22:00 ET
  /// cutoffs, so subtracting `filedAt` would report a NEGATIVE latency roughly
  /// every evening.
  filedAt        DateTime
  acceptedAt     DateTime?
  periodOfReport DateTime?

  /// 8-K item numbers ("2.02"), as EFTS and the daily index carry them.
  items String[]

  primaryDocument String?
  isXbrl          Boolean @default(false)
  isInlineXbrl    Boolean @default(false)
  sizeBytes       Int?

  /// Which parser owns this filing: OWNERSHIP | THIRTEENF | SCHEDULE13 |
  /// EIGHTK | FINANCIALS | OTHER. Decided at detection from the form string,
  /// which is why the classifier accepts BOTH 13D spellings — filings before
  /// the Dec-2024 XML mandate are `SC 13D`, after it `SCHEDULE 13D`.
  parseClass String

  /// DETECTED | INDEXED | ARCHIVED | PARSED | FAILED | UNSUPPORTED |
  /// NO_PARSER | WITHDRAWN.
  ///
  /// DETECTED is IN FLIGHT and means exactly one thing: claimed, published to a
  /// parse topic, waiting for a parser. That is what makes a growing DETECTED
  /// count readable as a backed-up parse queue.
  ///
  /// NO_PARSER is TERMINAL and is written at detection time when the filing's
  /// `parseClass` routes to no topic — today exactly `OTHER`, which is a real
  /// answer rather than a gap (`{parseClass: "OTHER"}` lists every form we have
  /// chosen not to parse). These rows were stored DETECTED until MONEY-1303, so
  /// one status meant both "awaiting a parser" and "will never be parsed": 933
  /// permanent rows on prod that a genuinely stalled queue could hide behind.
  /// It is NOT UNSUPPORTED — that is stamped by a parser that RAN and found
  /// nothing to extract (a 13F-NT notice carries no information table), whereas
  /// NO_PARSER means no parser was ever asked.
  ///
  /// INDEXED means the nightly `submissions.zip` ledger knows about it but no
  /// detector saw it live — the gap that proves the detection loop missed
  /// something. WITHDRAWN is set by the weekly full-index reconcile: SEC's
  /// DAILY index files are never corrected, and post-acceptance deletions
  /// appear only in the Saturday full-index rebuild.
  ///
  /// A `String`, not a Prisma enum, and deliberately so — the writer is pymongo
  /// on the Python side and Prisma never validates what it reads back, so an
  /// enum here would buy checking on the half that does not write. The
  /// vocabulary's one source of truth is `app/store/models.py`; this comment
  /// mirrors it, and `schema-parity.test.ts` grades FIELDS, not values.
  status String @default("DETECTED")

  /// GCS key of the archived full-submission bundle. Raw-first: the bytes are
  /// stored BEFORE they are parsed, so a mapping change or an edgartools
  /// upgrade is a reparse from our own bucket and never a second trip to SEC.
  rawPath String?

  detectedAt    DateTime?
  parsedAt      DateTime?
  error         String?
  parserVersion String?

  source     String   @default("SEC_EDGAR")
  ingestedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([accession])
  @@index([cik10, filedAt])
  @@index([form, filedAt])
  @@index([status, parseClass])
  /// Detection reads the newest acceptance to advance its cursor.
  @@index([acceptedAt])
  @@index([parseClass, status, filedAt])
  @@map("us_filings")
}

/// Standardized + as-reported financial statements, POINT-IN-TIME.
///
/// `accession` IS IN THE UNIQUE KEY, and that is the whole design. Restatements
/// are not corrections to be applied over the old value — they are a second
/// true statement about the same period, made later. A backtest asking "what
/// did the market know on 2024-05-01" must see the number as filed THEN, which
/// is impossible once a writer has overwritten it. `StockFinancials` (India)
/// has no `source` in its key and therefore destroys the value it replaces;
/// this table keeps both and marks the current one with `isLatest`.
model UsFundamentals {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  cik10 String
  /// The filer's primary listing at ingest time, denormalised so the common
  /// read (one symbol's income statement) needs no join. NULLABLE and
  /// non-authoritative: a filer with no active listing still gets rows.
  symbol String?

  /// INCOME | BALANCE_SHEET | CASH_FLOW
  statementType String
  /// ANNUAL | QUARTERLY
  periodType String

  periodStart DateTime?
  periodEnd   DateTime
  fiscalYear  Int
  /// FY | Q1 | Q2 | Q3 | Q4 as SEC's `fp` carries it.
  fiscalPeriod String

  accession   String
  form        String
  filedAt     DateTime
  isAmendment Boolean @default(false)

  /// True for exactly one row per (cik10, statementType, periodType, periodEnd).
  /// Latest `filedAt` wins; a 10-K beats a 10-Q on a tie; an amendment loses to
  /// a non-amendment filed at the same instant. Recomputed on every write for
  /// the affected group — never assumed from insertion order.
  isLatest Boolean @default(false)

  currency String @default("USD")

  /// `{ Revenue: 391035000000, NetIncome: ..., _fallbacks: {...} }` — keyed by
  /// edgartools' standard concept names (~95 concepts from 2,923 tags).
  /// `_fallbacks` records where a chain fired: `SalesRevenueNet` was deprecated
  /// 2018-01-31 and `RevenueFromContractWithCustomerExcludingAssessedTax`
  /// replaced it, while `Revenues` remains the sanctioned total for banks and
  /// insurers — so "revenue" is a per-filing decision and the decision is
  /// stored, not just its result.
  standardized Json

  /// `[{concept, label, value, unit, dimensions?}]` exactly as the filer tagged
  /// it. Kept beside the standardized view because ~5% of tags fall outside the
  /// map and company extension concepts fall outside it by definition — and
  /// because a standardized number nobody can trace back to a filed label is a
  /// number nobody can defend.
  asReported Json

  /// COMPANYFACTS (entity-wide bulk facts) | FILING_XBRL (the per-filing
  /// instance, which alone carries segments and extension concepts).
  /// FILING_XBRL outranks COMPANYFACTS for the same period.
  mappingSource String @default("FILING_XBRL")
  /// Bumped when our mapping rules change, so a reparse is identifiable.
  mappingVersion String
  parserVersion  String

  source     String   @default("SEC_EDGAR")
  ingestedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([cik10, statementType, periodType, periodEnd, accession])
  @@index([cik10, statementType, periodType, periodEnd])
  /// The point-in-time read: everything this filer had filed as of a date.
  @@index([cik10, filedAt])
  @@index([cik10, isLatest])
  @@index([symbol, statementType, periodType])
  @@map("us_fundamentals")
}

/// One row per (filer, taxonomy, concept, unit) holding EVERY reported value as
/// a time series — the hot half of `companyfacts.zip`.
///
/// Shaped as one document with a `values[]` array rather than one row per fact
/// because the read is always "this concept's history", never "this single
/// fact": ~15,000 filers x ~500 mapped concepts is 7.5M documents, while one
/// row per fact would be hundreds of millions for the same answers.
///
/// The FULL fact set — every taxonomy, every concept, including the `frame`
/// field edgartools drops — lives in the cold GCS shard
/// `edgar/facts/{cik10}/{taxonomy}`. This table is the subset a request path
/// touches.
model UsCompanyFact {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  cik10 String
  /// us-gaap | ifrs-full | dei | srt. `companyfacts.zip` carries NO company
  /// extension concepts and no dimensional facts at all — those exist only in
  /// the per-filing XBRL, which is why this table can never be the sole source
  /// for a statement.
  taxonomy String
  concept  String
  /// USD | shares | USD-per-shares | pure. Part of the key because the same
  /// concept is legitimately reported in more than one unit.
  unit String

  label String?

  /// `[{start?, end, val, accn, fy, fp, form, filed, frame?}]`, ascending by
  /// `end` then `filed`.
  ///
  /// SEVERAL ENTRIES SHARE ONE PERIOD and that is not corruption: a later
  /// filing restates, and every 10-K carries comparative columns for prior
  /// years. `frame` (`CY2024Q1I`) is SEC's own answer to which fact best fits a
  /// calendar period and is present only when the reporting window aligns —
  /// it is preserved here because it is the one de-duplication signal SEC
  /// itself publishes, and edgartools discards it.
  values Json[]

  lastFiledAt DateTime?

  source     String   @default("SEC_EDGAR")
  ingestedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([cik10, taxonomy, concept, unit])
  @@index([cik10, lastFiledAt])
  @@index([concept])
  @@map("us_company_facts")
}

/// Forms 3/4/5 — insider transactions and holdings, one row per table line.
model UsInsiderTransaction {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  accession String
  /// Position within the filing's combined non-derivative + derivative tables.
  /// Part of the key because a Form 4 legitimately reports the same security,
  /// code, date, share count and price twice (two lots, two footnotes) — any
  /// "natural" key over the economics would silently collapse them.
  rowIndex Int

  issuerCik10  String
  issuerName   String
  issuerTicker String?
  /// Resolved against ACTIVE `us_instruments`. SEC spells share classes with a
  /// slash (`BRK/B`) and Tiingo with a dash (`BRK-B`); the resolver normalises
  /// and records nothing when it cannot decide, because a wrong symbol attaches
  /// one company's insider activity to another.
  symbol String?

  ownerCik10     String
  ownerName      String
  isDirector     Boolean @default(false)
  isOfficer      Boolean @default(false)
  isTenPctOwner  Boolean @default(false)
  isOther        Boolean @default(false)
  officerTitle   String?

  form            String
  transactionDate DateTime?
  reportingPeriod DateTime?
  filedAt         DateTime
  acceptedAt      DateTime?

  securityTitle String
  isDerivative  Boolean @default(false)
  /// True for a HOLDING row (a position disclosed without a transaction).
  /// Holdings have no code, no price and no acquired/disposed flag, and
  /// counting them as trades overstates insider activity — Form 3 is holdings
  /// almost entirely.
  isHolding Boolean @default(false)

  /// The single letter, and its meaning from SEC's own `TransCodeList` — not
  /// the library's table, which is missing K and L.
  transactionCode String?
  codeMeaning     String?
  /// E (early) | L (late) | null (on time), from `transactionTimeliness`.
  /// This is where the printed form's "V" went; there is no V code in the XML.
  timeliness String?
  /// EDGAR appends "K" to a displayed code when this is set. Stored as the flag
  /// it actually is, so the code column stays the code SEC published.
  equitySwap Boolean @default(false)

  /// A (acquired) | D (disposed).
  acquiredDisposed String?
  shares           Float?
  price            Float?
  /// shares x price when both exist. Absent, not zero, when either is missing —
  /// a gift (code G) has no price and a zero would read as a free transfer of
  /// nothing rather than an untold value.
  value            Float?
  sharesOwnedAfter Float?

  /// D (direct) | I (indirect). `natureOfOwnership` is MANDATORY when I and
  /// forbidden when D, per the spec's own rule.
  directIndirect    String?
  natureOfOwnership String?

  underlyingSecurity String?
  underlyingShares   Float?
  exercisePrice      Float?
  exerciseDate       DateTime?
  expirationDate     DateTime?

  footnotes   String[]
  isAmendment Boolean @default(false)

  source        String   @default("SEC_EDGAR")
  parserVersion String
  ingestedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([accession, rowIndex])
  @@index([issuerCik10, transactionDate])
  @@index([symbol, transactionDate])
  @@index([ownerCik10, transactionDate])
  @@index([filedAt])
  @@map("us_insider_transactions")
}

/// One 13F-HR (or amendment) cover page.
model UsThirteenFFiling {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  accession String
  /// The 13F COVER PAGE CARRIES NO MANAGER CIK — only a name and address — so
  /// this is the FILING's CIK. A name-keyed join would merge every "Capital
  /// Management LLC" in the country.
  managerCik10 String
  managerName  String

  periodOfReport DateTime
  filedAt        DateTime
  form           String

  isAmendment     Boolean @default(false)
  /// RESTATEMENT replaces the original's holdings; NEW HOLDINGS adds to them.
  /// Applying the wrong one either doubles a portfolio or erases most of it.
  amendmentType   String?
  amendmentNumber Int?

  totalValueUsd      Float @default(0)
  totalHoldings      Int   @default(0)
  otherManagersCount Int   @default(0)

  /// HOT (rows live in `us_13f_holdings`) | COLD (rows live in the GCS shard at
  /// `coldPath`). The hot window is the two most recent report periods; older
  /// quarters are archived, RE-READ, and only then deleted.
  tier     String  @default("HOT")
  coldPath String?

  /// Which rule decided the value unit, and what edgartools' heuristic thought.
  ///
  /// Release 34-95148 moved 13F from THOUSANDS to WHOLE DOLLARS for every
  /// report FILED on or after 2023-01-03 — keyed on the filing date, not the
  /// period, so a 2023-filed amendment of a 2022 quarter is in dollars while
  /// the original was in thousands. We apply that rule. The library instead
  /// infers the unit from implied price, and its verdict is recorded so a
  /// disagreement is visible rather than silently resolved: a 1000x error here
  /// is a plausible-looking portfolio, not a crash.
  valueUnitRule       String
  libraryUnitVerdict  String?

  source        String   @default("SEC_EDGAR")
  parserVersion String
  ingestedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([accession])
  @@index([managerCik10, periodOfReport])
  @@index([periodOfReport, tier])
  @@index([filedAt])
  @@map("us_13f_filings")
}

/// One 13F information-table row. Hot window only — see `UsThirteenFFiling.tier`.
model UsThirteenFHolding {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  accession String
  rowIndex  Int

  managerCik10   String
  periodOfReport DateTime
  filedAt        DateTime

  cusip String
  /// Added to the form by EDGAR Release 22.4.1 (Jan 2023), so it is present on
  /// recent filings only. Where it exists it joins straight to
  /// `UsInstrument.openFIGIComposite` — verified identical for AAPL
  /// (BBG000B9XRY4) and BRK-B (BBG000DWG505) — which is the cheapest tier of
  /// the CUSIP map and needs no third party at all.
  figi         String?
  issuerName   String
  titleOfClass String

  /// ALWAYS whole US dollars in this column, whatever the filing said. The
  /// conversion happens once, at parse, under `valueUnitRule`.
  valueUsd Float
  shares   Float
  /// SH (shares) | PRN (principal amount). A PRN row is a bond position and its
  /// "shares" are dollars of face value — summing the two as one quantity is
  /// meaningless.
  sharesType String

  /// Put | Call | null. An options position is not a share position and must
  /// not be aggregated into one when computing a holder's stake.
  putCall              String?
  investmentDiscretion String
  otherManagers        String[]

  votingSole   Float @default(0)
  votingShared Float @default(0)
  votingNone   Float @default(0)

  symbol      String?
  issuerCik10 String?
  /// Which tier of the CUSIP map resolved this row: SEC_13DG | TIINGO_FIGI |
  /// SEC_FTD | OPENFIGI | null. Provenance, so an unresolved row is visibly
  /// unresolved rather than looking like a company with no ticker.
  resolvedBy String?

  source        String   @default("SEC_EDGAR")
  parserVersion String
  ingestedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([accession, rowIndex])
  @@index([cusip, periodOfReport])
  @@index([symbol, periodOfReport])
  @@index([managerCik10, periodOfReport])
  @@index([filedAt])
  @@map("us_13f_holdings")
}

/// Schedules 13D and 13G — beneficial ownership above 5%, one row per reporting
/// person.
model UsBeneficialOwnership {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  accession String
  rowIndex  Int

  /// 13D | 13G — the SCHEDULE, normalised. `form` keeps the string as filed,
  /// which changed spelling with the Dec-2024 XML mandate (`SC 13D` became
  /// `SCHEDULE 13D`); a classifier that knows only one spelling silently drops
  /// half the history.
  schedule        String
  form            String
  isAmendment     Boolean @default(false)
  amendmentNumber Int?

  subjectCik10 String
  subjectName  String
  /// The subject's CUSIP, straight from the cover page. This is the FIRST tier
  /// of the CUSIP map and the only one that is primary-source: a CUSIP and a
  /// CIK, published together by the filer, joining to a company we already know.
  cusip  String?
  symbol String?

  filerCik10 String?
  filerName  String

  percentOfClass   Float?
  sharesOwned      Float?
  soleVoting       Float?
  sharedVoting     Float?
  soleDispositive  Float?
  sharedDispositive Float?
  /// IN | CO | PN | IA | BD ... — SEC's reporting-person taxonomy.
  typeOfReportingPerson String?

  eventDate DateTime?
  filedAt   DateTime

  /// 13D Item 4. The reason a stake exists — activist intent versus passive
  /// investment — and the only field here that a 13G structurally cannot have.
  purposeText String?

  /// FALSE for every filing before 2024-12-18, when structured XML became
  /// mandatory. Older filings are HTML and yield identities only, so a null
  /// `percentOfClass` on a 2019 filing means "not machine-readable", not "zero".
  /// Without this flag those two are indistinguishable.
  hasStructuredData Boolean @default(false)

  source        String   @default("SEC_EDGAR")
  parserVersion String
  ingestedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([accession, rowIndex])
  @@index([subjectCik10, filedAt])
  @@index([symbol, filedAt])
  @@index([filerCik10, filedAt])
  @@index([cusip])
  @@map("us_beneficial_ownership")
}

/// Filing documents and exhibits — today the 8-K press-release queue.
///
/// The TEXT lives in GCS; this table holds the pointer, the hash and the
/// extraction state. `extractionStatus` describes THE TEXT and nothing else:
/// READY (text extracted, `textPath` points at it) or FAILED (extraction
/// produced nothing — a refillable gap, since a later parser version can turn
/// one into a READY on the next reparse). It is NOT a claim about the LLM
/// extraction of KPIs and guidance, which remains out of scope.
///
/// The `@default("PENDING")` below is the NEVER-PROCESSED value and no writer
/// stamps it. It read PENDING on 100% of 5,377 rows until MONEY-1351, 3,296 of
/// which already held text — one value over a whole population measures
/// nothing. `services/us-fundamentals/scripts/backfill_extraction_status.py`
/// clears the legacy rows.
model UsFilingDocument {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  accession String
  /// EDGAR's own document sequence number within the submission.
  sequence Int

  cik10  String
  symbol String?
  form   String
  filedAt DateTime
  /// The 8-K items this document belongs to. Item 2.02 is the earnings release.
  items String[]

  /// EX-99.1 | EX-10.1 | 8-K (the primary document) ...
  documentType String
  description  String?
  filename     String

  textPath  String?
  textBytes Int?
  /// sha256 of the extracted text, so a reparse that changes nothing writes
  /// nothing, and a reparse that changes something is visible.
  textHash String?

  /// PENDING | READY | FAILED | UNSUPPORTED
  extractionStatus String @default("PENDING")

  source        String   @default("SEC_EDGAR")
  parserVersion String
  ingestedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([accession, sequence])
  @@index([cik10, filedAt])
  @@index([form, filedAt])
  @@index([extractionStatus])
  @@map("us_filing_documents")
}

/// CUSIP -> ticker, which no official SEC file provides.
///
/// 13F reports positions by CUSIP and nothing else; without this table a
/// holdings row cannot be shown next to a price. Resolution is LAYERED, and the
/// order is deliberate — three primary/in-house tiers before any third party:
///
///   SEC_13DG    a 13D/G cover page publishes CUSIP and subject CIK together
///   TIINGO_FIGI the 13F `figi` column equals `UsInstrument.openFIGIComposite`
///   SEC_FTD     SEC's Fails-to-Deliver files pair CUSIP with SYMBOL directly,
///               but only for securities with an open fail, so coverage is
///               partial and rolling
///   OPENFIGI    Bloomberg's free mapping API; the FIGI identifiers are a
///               public-domain dedication, storable and redistributable
///
/// `source` records which tier answered, so a wrong mapping is traceable to the
/// mechanism that produced it rather than to "the CUSIP map".
model UsCusipMap {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  cusip         String
  symbol        String?
  cik10         String?
  compositeFigi String?
  issuerName    String?

  /// SEC_13DG | TIINGO_FIGI | SEC_FTD | OPENFIGI | UNRESOLVED
  source String

  /// 1.0 for the primary-source tiers; lower where a name or exchange had to be
  /// matched. Never used to pick between tiers — the ORDER does that — only to
  /// flag a row for review.
  confidence Float @default(1)

  /// Failed lookups are rows too, with a count. An unresolved CUSIP that is not
  /// recorded is one the nightly sweep retries forever; recorded, it is retried
  /// weekly and reported as a coverage number.
  attempts   Int       @default(0)
  resolvedAt DateTime?
  lastTriedAt DateTime?

  ingestedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([cusip])
  @@index([symbol])
  @@index([cik10])
  @@index([source])
  @@map("us_cusip_map")
}

/// Detection cursors and bulk-file watermarks.
///
/// One row per named stream (`getcurrent`, `efts`, `bulk:companyfacts`,
/// `bulk:submissions`, `daily-index`). The bulk rows hold the upstream
/// `Last-Modified`/ETag so a nightly run that finds an unchanged file exits as
/// NOT_YET_PUBLISHED — a named, non-failing outcome — instead of re-processing
/// 1.4 GB or, worse, reporting success having done nothing.
model UsEdgarCursor {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  key String

  lastAccession  String?
  lastAcceptedAt DateTime?
  lastRunAt      DateTime?
  /// `{lastModified, etag, sha256, members, changedMembers}` — free-form
  /// because each stream watermarks differently.
  meta Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key])
  @@map("us_edgar_cursor")
}
