generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id                      String    @id @default(auto()) @map("_id") @db.ObjectId
  clerkId                 String?   @unique // Clerk user ID for webhook sync
  email                   String    @unique
  name                    String?
  passwordHash            String?
  isActive                Boolean   @default(true) // Soft delete flag
  emailPreferences        Json?
  preferredCurrency       String    @default("INR")
  termsAcceptedAt         DateTime? // When user accepted T&C + privacy + risk disclosure
  // Per-user GST details for domestic invoice generation (MONEY-227).
  // Shape: { gstin?, legalName, address, stateCode, pan?, registeredAt }
  gstProfile              Json?
  // Per-feature user preferences (MONEY-219). Json blob namespaced by feature
  // so a future feature can add its own bucket without a schema migration.
  // Current shape:
  //   { research: { researchStyle: "auto"|"quick"|"deep"|"custom",
  //                 customSkills: string[], researchFocus?: string,
  //                 updatedAt: ISO8601 } }
  preferences             Json?
  // Walkthrough tour versions the user has seen (MONEY-387). Empty array = unseen.
  // Append a version ("v1-core", "v2-roast", ...) when the user completes or
  // skips that tour. Stays queryable for funnel analytics.
  walkthroughVersionsSeen String[]  @default([])
  // MONEY-144 - differential Resend audience sync state. Set after a
  // successful per-user sync in workers/src/processors/resend-contact-sync.ts.
  // The cron skips users whose User.updatedAt AND Subscription.updatedAt
  // are both <= lastResendSyncAt - no Resend API calls for unchanged
  // users. resendAudienceTier remembers the tier audience (free/paid/
  // downgraded) we last placed the user in, so we only DELETE from the
  // old audience when the tier actually changes (previous implementation
  // issued 3 unconditional DELETEs per user per run).
  lastResendSyncAt        DateTime?
  resendAudienceTier      String?
  // MONEY-NEW: welcome-email idempotency, claimed atomically BEFORE sending so
  // the email goes out exactly once — decoupled from lastResendSyncAt (which is
  // segment-gated and deliberately left null on segment failure for the weekly
  // backfill). A user.created + user.updated race, Svix retries, AND duplicate
  // processing across shared-DB envs (local+QA share Clerk/DB/Resend) all settle
  // on this single claim.
  welcomeEmailSentAt      DateTime?
  createdAt               DateTime  @default(now())
  // MONEY-877: fixed, resettable broker-trial expiry. The 30-day broker trial ends
  // at (brokerTrialEndsAt ?? createdAt + 30d). Null = createdAt-based (unchanged for
  // everyone); stamping it sets a concrete end date (joining + 30d, or a goodwill
  // reset to today + 30d) — never touches the real signup date.
  brokerTrialEndsAt       DateTime?
  updatedAt               DateTime  @updatedAt

  // Relations
  brokerConnections      BrokerConnection[]
  trades                 Trade[]
  holdings               Holding[]
  positions              Position[]
  orders                 Order[]
  mutualFunds            MutualFund[]
  paperPortfolio         PaperPosition[]
  paperPortfolioObj      PaperPortfolio?
  paperOrders            PaperOrder[]
  analysisReports        AnalysisReport[]
  fireScenarios          FireScenario[]
  syncLogs               SyncLog[]
  consentRecords         ConsentRecord[]
  subscription           Subscription?
  payments               Payment[]
  chatHistory            ChatHistory[]
  documentEmbeddings     DocumentEmbedding[]
  documentEmbeddingsV2   DocumentEmbeddingV2[]
  watchLists             WatchList[]
  enrollments            Enrollment[]
  courseLessonProgress   CourseLessonProgress[]
  portfolioRoasts        PortfolioRoast[]
  comparisonSessions     ComparisonSession[]
  userDocuments          UserDocument[]
  customStrategies       CustomStrategy[]
  customIndicators       CustomIndicator[]
  scanResults            ScanResult[]
  gstInvoices            GstInvoice[]
  savedScreens           SavedScreen[]
  aiLogs                 AIGenerationLog[]
  investorProfile        InvestorProfile?
  conceptMastery         ConceptMastery[]
  userEvents             UserEvent[]
  portfolioBehaviorSnaps PortfolioBehaviorSnapshot[]
  portfolioInsights      PortfolioInsight[]
}

// ============== SUBSCRIPTION & PAYMENTS ==============

model Subscription {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId        PlanType           @default(FREE)
  billingPeriod String? // "monthly" or "annual" for PREMIUM plans
  status        SubscriptionStatus @default(ACTIVE)

  // Billing cycle
  startDate   DateTime  @default(now())
  endDate     DateTime?
  cancelledAt DateTime?

  // AI Query tracking - Legacy (deprecated, use fast/slow queries)
  aiQueriesUsed    Int       @default(0)
  aiQueriesLimit   Int       @default(0)
  aiQueriesResetAt DateTime?

  // Fast query tracking
  fastQueriesUsed  Int @default(0)
  fastQueriesLimit Int @default(0)

  // Advanced query tracking
  advancedQueriesUsed  Int @default(0)
  advancedQueriesLimit Int @default(0)

  // Query Pack tracking (when QUERY_PACK is active)
  queryPackActive               Boolean   @default(false)
  queryPackFastQueriesUsed      Int       @default(0)
  queryPackFastQueriesLimit     Int       @default(0)
  queryPackAdvancedQueriesUsed  Int       @default(0)
  queryPackAdvancedQueriesLimit Int       @default(0)
  queryPackStartDate            DateTime?
  queryPackEndDate              DateTime?

  // Add-ons (stored as array of addon plan IDs)
  addons String[]

  // Free roast tracking (1 free per month for all users)
  freeRoastsUsedThisMonth Int       @default(0)
  freeRoastsResetAt       DateTime?

  // Comprehensive analysis credits (L3) - legacy, use unified credits
  comprehensiveCreditsUsed  Int @default(0)
  comprehensiveCreditsLimit Int @default(0)

  // ── Unified Credit System ──
  // Single credit pool that replaces fast/advanced/comprehensive pools
  creditsUsed    Int       @default(0)
  creditsLimit   Int       @default(5) // Plan monthly allocation (FREE=5, PRO=50, etc.)
  creditsResetAt DateTime?

  // Credit pack (add-on, doesn't reset monthly)
  packCreditsUsed  Int       @default(0)
  packCreditsLimit Int       @default(0)
  packPurchasedAt  DateTime?

  // PRO entitlement - preserved across plan changes
  proEntitlementType      String? // "lifetime" | "annual" | "monthly" | null
  proEntitlementStartDate DateTime?
  proEntitlementEndDate   DateTime? // null for lifetime (10yr cap computed at read), actual expiry for annual/monthly

  // Next billing date (from Dodo webhook)
  nextBillingDate DateTime?

  // MONEY-482: scheduled plan change. When the user requests a downgrade
  // or a cancel, we keep the current cycle active and stamp these fields
  // so a cron flips the plan at term end. Cleared once applied (or undone).
  //   scheduledPlanId         — target plan ("FREE" for cancel)
  //   scheduledBillingPeriod  — target cycle ("monthly" | "annual" | null for FREE)
  //   scheduledEffectiveAt    — when the cron should apply this (usually currentPeriodEnd)
  scheduledPlanId        String?
  scheduledBillingPeriod String?
  scheduledEffectiveAt   DateTime?

  // Payment reference
  dodoCustomerId     String?
  dodoSubscriptionId String?

  // Metadata
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status])
}

model Payment {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Payment details
  dodoPaymentId String?       @unique
  amount        Float
  currency      String        @default("INR")
  status        PaymentStatus @default(PENDING)

  // Plan info
  planId   PlanType
  planName String
  period   String // one-time, monthly, annual

  // Payment method
  paymentMethod     String?
  paymentMethodType String? // "upi_intent", "credit", "debit", etc.
  cardLastFour      String? // Last 4 digits
  cardNetwork       String? // "mastercard", "visa", "rupay"
  cardType          String? // "credit", "debit"

  // Invoice
  invoiceUrl String? // Dodo-generated invoice link
  invoiceId  String? // Dodo invoice ID

  // Dodo references
  dodoSubscriptionId String? // Link to subscription
  dodoCustomerId     String? // Dodo customer ID

  // Settlement
  settlementAmount    Float? // Amount settled (in settlement currency)
  settlementCurrency  String? // "USD" — what the MERCHANT receives; may differ from presentment under adaptive pricing
  // MONEY-877: the currency the CUSTOMER was charged in (Dodo `data.currency`).
  // totalAmount is denominated in THIS currency, so the billing row + receipt must
  // label totalAmount with presentmentCurrency, NOT settlementCurrency.
  presentmentCurrency String?
  taxAmount           Float? // Tax charged
  totalAmount         Float? // Total including tax (in presentmentCurrency)

  // Timestamps
  paidAt DateTime?

  // Fulfillment idempotency (MONEY-594): set exactly once when the
  // subscription/credit grant for this payment is applied. Activation is
  // gated behind a conditional claim (updateMany where appliedAt: null) so a
  // replayed callback URL or a retried webhook can never re-apply the grant.
  appliedAt DateTime?

  // Error tracking
  errorMessage String?

  // Metadata from payment provider
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Reverse relations
  gstInvoices GstInvoice[]

  @@index([userId])
  @@index([status])
}

enum PlanType {
  FREE
  PRO
  PREMIUM
  ULTIMATE
  QUERY_PACK
  AI_ADDON
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

// ============== COUPONS & DISCOUNTS ==============

model Coupon {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  code            String    @unique
  dodoDiscountId  String?   @unique
  name            String?
  // MONEY-865: discountType selects how the discount is computed.
  //   "percent" -> use discountPercent (legacy default, back-compatible)
  //   "flat"    -> use discountAmount (rupees) as a fixed ₹-off
  discountType    String    @default("percent")
  discountPercent Float     @default(0)
  discountAmount  Float? // rupees; only meaningful when discountType = "flat"
  maxUsage        Int?
  currentUsage    Int       @default(0)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)

  // MONEY-NEW: target-plan scope. The plan(s) this coupon may be applied to at
  // checkout (e.g. ["PRO"], ["PREMIUM"], or ["PRO","PREMIUM"]). EMPTY = valid
  // for ANY plan (generic). The grant lasts the billing period chosen at
  // checkout (monthly/annual); a fully-covered coupon then auto-downgrades to
  // FREE at term end via the MONEY-482 scheduled-change cron.
  applicablePlans String[] @default([])

  // MONEY-865: billing-cycle scope. The billing period(s) this coupon may be
  // applied to at checkout — values are "monthly" and/or "annual". EMPTY = valid
  // for BOTH cycles (back-compatible: existing coupons stay valid for either).
  // Enforced app-side in validateCoupon(); Dodo discounts have no cycle concept.
  applicableBillingPeriods String[] @default([])

  // User-specific fields
  isUserSpecific  Boolean @default(false)
  targetUserEmail String?
  targetUserId    String? @db.ObjectId

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions CouponRedemption[]

  @@index([isActive])
  @@index([targetUserEmail])
}

model CouponRedemption {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  couponId   String   @db.ObjectId
  coupon     Coupon   @relation(fields: [couponId], references: [id])
  userId     String   @db.ObjectId
  userEmail  String
  paymentId  String?  @db.ObjectId
  redeemedAt DateTime @default(now())

  @@unique([couponId, userId])
  @@index([couponId])
  @@index([userId])
}

// ============== ADMIN AUDIT ==============

// MONEY-867: append-only ledger of every admin write action (coupon create/
// deactivate, plan switch/extend, manual payment-complete, soft-delete, etc.).
// Written via recordAdminAction() in @usemoney/services. Viewer UI = MONEY-417.
model AdminAuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  actorEmail String
  action     String // e.g. "coupon.create", "subscription.switchPlan", "user.softDelete"
  targetType String // e.g. "Coupon", "User", "Payment", "Subscription"
  targetId   String? // id / code / email of the target (not always an ObjectId)
  diff       Json? // params or before/after snapshot
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorEmail])
  @@index([createdAt])
}

// Dodo Product Model - Synced from Dodo Payments API
model DodoProduct {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  productId   String  @unique // Dodo's product_id (pdt_xxx)
  businessId  String
  name        String
  description String?
  price       Float
  currency    String  @default("INR")
  isRecurring Boolean @default(false)
  taxCategory String?
  image       String?
  metadata    Json? // Store additional Dodo metadata

  // Our mapping
  planType      String // Maps to: PRO, QUERY_PACK, PREMIUM
  billingPeriod String? // "monthly" or "annual" for PREMIUM

  // Sync tracking
  archived     Boolean  @default(false)
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([planType])
  @@index([planType, billingPeriod])
  @@index([archived])
  @@map("dodo_products")
}

// Platform-wide configuration (key-value store)
model PlatformConfig {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("platform_config")
}

// Invite tokens for shareable signup/upgrade links
model InviteToken {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  token        String    @unique
  planId       PlanType
  discountId   String? // Dodo discount ID if attached
  discountCode String? // Dodo discount code for checkout
  maxUses      Int // -1 = unlimited
  usedCount    Int       @default(0)
  usedBy       String[] // user IDs who redeemed
  assignedTo   String? // specific email (null = anyone)
  expiresAt    DateTime?
  createdBy    String // admin user ID
  isActive     Boolean   @default(true)
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive])
  @@map("invite_tokens")
}

// ============== BROKER INTEGRATION ==============

// Broker Connection Model - Enhanced for multi-broker support
model BrokerConnection {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Broker identification
  broker       BrokerType
  brokerUserId String? // Broker's user/client ID (e.g., Zerodha client ID)
  accountName  String? // Custom name for this account (user-defined or auto from broker userName)
  status       ConnectionStatus @default(DISCONNECTED)

  // Encrypted credentials (AES-256-GCM encrypted JSON string)
  encryptedCreds String? // Stores: { apiKey, apiSecret, accessToken, refreshToken, etc. }
  iv             String? // Initialization vector for decryption
  authTag        String? // Authentication tag for GCM mode

  // Legacy fields (for migration)
  accessToken  String? // Deprecated - use encryptedCreds
  refreshToken String? // Deprecated - use encryptedCreds
  apiKey       String? // Deprecated - use encryptedCreds
  apiSecret    String? // Deprecated - use encryptedCreds

  // Token management
  tokenExpiry     DateTime?
  lastSync        DateTime?
  autoRefresh     Boolean         @default(false)
  refreshStrategy RefreshStrategy @default(NONE)

  // Connection metadata
  connectedAt       DateTime?
  lastRefreshedAt   DateTime?
  errorMessage      String?
  reconnectAttempts Int       @default(0)

  // Broker-specific metadata (flexible JSON)
  brokerMetadata Json? // Stores: { userId, userName, allowedSegments, etc. }

  // Sync settings
  syncHoldings    Boolean @default(true)
  syncPositions   Boolean @default(true)
  syncOrders      Boolean @default(true)
  syncMutualFunds Boolean @default(false)

  // Sync frequency for auto-refresh brokers
  syncFrequency SyncFrequency @default(MANUAL)

  // MONEY-841: stable shard = hash(userId) % SYNC_BUCKET_COUNT, set on connect +
  // backfilled. The daily cron fans out one Pub/Sub message per bucket so
  // connections sync in parallel shards instead of one worker serial-looping
  // every connection (the ~1-2k-connection scaling cliff).
  syncBucket Int?

  // Legacy fields
  brokerId    String? // Deprecated
  brokerName  String? // Deprecated - use broker enum
  connected   Boolean  @default(false) // Deprecated - use status
  accountInfo Json? // Deprecated - use brokerMetadata
  permissions String[] // Deprecated

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, broker, brokerUserId])
  @@index([userId])
  @@index([userId, broker])
  @@index([userId, status])
  @@index([status])
  @@index([tokenExpiry])
  @@index([syncBucket, status])
}

// Trade model - Enhanced with broker tracking
model Trade {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  broker        BrokerType?
  brokerUserId  String? // Broker's user/client ID to identify which account
  brokerTradeId String? // Broker's trade ID
  brokerOrderId String? // Reference to broker order

  // Legacy fields
  brokerId   String?
  brokerName String?

  // Trade details
  symbol        String
  tradingSymbol String?
  isin          String? // ISIN for matching across symbol name changes (e.g., MF names change)
  exchange      String  @default("NSE")
  segment       String  @default("EQUITY")
  tradeType     String // BUY, SELL
  positionType  String  @default("LONG")
  orderType     String  @default("MARKET")
  productType   String  @default("CNC")

  // Pricing
  quantity     Float
  price        Float
  exitPrice    Float?
  averagePrice Float?
  tradeValue   Float?

  // Charges
  brokerage      Float  @default(20)
  exchangeFee    Float  @default(0)
  gst            Float  @default(0)
  sebiCharges    Float  @default(0)
  stampDuty      Float  @default(0)
  transactionTax Float  @default(0)
  totalCharges   Float  @default(0)
  taxes          Float  @default(0)
  netAmount      Float?

  // P&L
  realizedPnL Float?
  status      String @default("OPEN")

  // Timestamps
  tradeDate      DateTime
  tradeTime      DateTime?
  exitDate       DateTime?
  settlementDate DateTime?

  // Trade source tracking (for sync vs import vs manual)
  sourceType    TradeSource @default(SYNCED)
  linkedTradeId String?     @db.ObjectId // Link to closing/paired trade
  isEditable    Boolean     @default(false) // Synced = false, Manual/Imported = true
  importBatchId String? // Group imported trades together

  // Enhanced duplicate detection
  duplicateHash     String? // Hash of symbol+date+type+qty+price for content matching
  linkedUpdatedAt   DateTime? // When broker linking was changed
  linkedUpdatedFrom String? // Previous broker type (for audit trail)

  // Buy/Sell pairing
  pairedStatus   PairedStatus @default(UNPAIRED)
  pairedQuantity Float        @default(0)
  remainingQty   Float? // Remaining unpaired quantity
  needsRepairing Boolean      @default(true) // Flag for pairing worker to process

  // Additional info
  tags      String[]
  notes     String?
  aiInsight Json?
  comments  Json[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, broker, brokerUserId, brokerTradeId])
  @@index([userId])
  @@index([userId, broker])
  @@index([userId, broker, brokerUserId])
  @@index([userId, broker, symbol])
  @@index([userId, status])
  @@index([userId, tradeDate])
  @@index([userId, sourceType])
  @@index([userId, duplicateHash])
  @@index([userId, needsRepairing])
  @@index([importBatchId])
  @@index([symbol])
  @@index([isin])
}

// Holding model - Enhanced
model Holding {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  broker       BrokerType?
  brokerUserId String? // Broker's user/client ID to identify which account

  // Legacy fields
  brokerId   String?
  brokerName String?

  // Security details
  symbol          String
  tradingSymbol   String?
  name            String?
  isin            String?
  exchange        String  @default("NSE")
  sector          String?
  instrumentToken Int? // Broker's instrument token for WebSocket subscriptions

  // Quantity details
  quantity        Float
  totalQuantity   Float?
  freeQuantity    Float?
  t1Quantity      Float  @default(0)
  pledgedQuantity Float  @default(0)
  collateralQty   Float  @default(0)

  // Price details
  averagePrice Float
  currentPrice Float
  lastPrice    Float?
  closePrice   Float?

  // P&L calculations
  investedValue Float
  currentValue  Float
  unrealizedPnL Float
  pnl           Float?
  pnlPercentage Float
  dayChange     Float  @default(0)
  dayChangePerc Float  @default(0)

  // Product type
  product     String? // CNC, NRML, etc.
  holdingType String  @default("STOCK")

  // MTF (Margin Trading Facility) data
  mtfQuantity      Float? // MTF quantity
  mtfUsedQuantity  Float? // Used MTF quantity
  mtfAveragePrice  Float? // MTF average price
  mtfValue         Float? // MTF value
  mtfInitialMargin Float? // Initial margin for MTF

  // Metadata
  lastUpdated DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, broker, brokerUserId, symbol, exchange])
  @@index([userId])
  @@index([userId, broker])
  @@index([userId, broker, brokerUserId])
  @@index([userId, sector])
  @@index([userId, exchange])
  @@index([symbol])
}

// Position model - New for intraday/F&O positions
model Position {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  broker       BrokerType?
  brokerUserId String? // Broker's user/client ID to identify which account

  // Security details
  symbol          String
  tradingSymbol   String?
  exchange        String
  segment         String // CASH, FO, etc.
  instrumentToken Int? // Broker's instrument token

  // Position type
  positionType PositionType @default(NET)
  productType  String // MIS, CNC, NRML

  // User-friendly labels (for display)
  segmentLabel      String? // "Equity", "Futures & Options"
  productTypeLabel  String? // "Cash & Carry", "Intraday"
  positionTypeLabel String? // "Intraday", "Carry Forward"

  // Quantity details
  buyQuantity       Float
  sellQuantity      Float
  netQuantity       Float
  overnightQuantity Float @default(0) // Overnight positions carried forward

  // Price details
  buyPrice     Float
  sellPrice    Float
  averagePrice Float
  lastPrice    Float
  closePrice   Float? // Previous day close price

  // Day-specific values
  dayBuyQuantity  Float @default(0)
  dayBuyPrice     Float @default(0)
  dayBuyValue     Float @default(0)
  daySellQuantity Float @default(0)
  daySellPrice    Float @default(0)
  daySellValue    Float @default(0)

  // Value calculations
  buyValue  Float
  sellValue Float
  netValue  Float

  // P&L
  realizedPnl   Float
  unrealizedPnl Float
  totalPnl      Float
  pnlPercentage Float
  m2m           Float? // Mark to market P&L

  // Overnight positions (legacy, use overnightQuantity)
  overnightQty Float @default(0)

  // For F&O
  expiryDate  DateTime?
  strikePrice Float?
  optionType  String? // CE, PE
  lotSize     Int?
  multiplier  Float?

  // Metadata
  tradeDate   DateTime
  lastUpdated DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, broker, brokerUserId, symbol, exchange, positionType])
  @@index([userId])
  @@index([userId, broker])
  @@index([userId, broker, brokerUserId])
  @@index([tradeDate])
}

// Order model - New for order tracking
model Order {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  broker       BrokerType?
  brokerUserId String? // Broker's user/client ID to identify which account
  orderId      String // Broker's order ID

  // Security details
  symbol        String
  tradingSymbol String?
  exchange      String
  segment       String

  // Order details
  orderType       OrderType
  transactionType TransactionType
  productType     String // MIS, CNC, NRML
  variety         String // regular, amo, co, bo

  // Quantity & Price
  quantity        Float
  filledQuantity  Float @default(0)
  pendingQuantity Float

  price        Float @default(0)
  triggerPrice Float @default(0)
  averagePrice Float @default(0)

  // Order status
  status        OrderStatus
  statusMessage String?

  // Validity
  validity String // DAY, IOC

  // Timestamps
  orderTime    DateTime
  updateTime   DateTime?
  exchangeTime DateTime?

