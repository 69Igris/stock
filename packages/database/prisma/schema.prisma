// Corporate actions (splits, bonuses, dividends, demergers, buybacks) — a
// market-wide reference table (NOT per-user) used to (a) adjust FIFO open-lot
// cost basis BEFORE pairing and (b) keep the holdings<->pairing reconciliation
// tolerant of quantity changes that happen with no trade. Sourced from
// screener.in + NSE/BSE, archived to GCS, populated by the corporate-actions-sync
// worker. Cost-basis adjustment uses `ratio` (DIVIDEND rows are informational).
// (MONEY-840 / MONEY-844)
model CorporateAction {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  symbol           String
  isin             String?
  exchange         String
  type             String // SPLIT | BONUS | BUYBACK | DEMERGER | MERGER | DIVIDEND
  exDate           DateTime
  recordDate       DateTime?
  // Post:pre share ratio for qty-changing actions (split 1:5 -> 5, bonus 1:1 ->
  // 2). Null for actions that don't change quantity (e.g. DIVIDEND).
  ratio            Float?
  oldFaceValue     Float?
  newFaceValue     Float?
  dividendPerShare Float? // DIVIDEND only; informational, not cost-basis
  source           String? // SCREENER | NSE | BSE | SEED | MANUAL
  details          Json?
  gcsPath          String? // archived snapshot location
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([symbol, exchange, type, exDate]) // dedupe across sources
  @@index([isin])
  @@index([symbol, exchange])
  @@index([exDate])
  @@map("corporate_actions")
}

