// Paired Trade View - Persisted view of matched buy/sell trades with row splitting
model PairedTradeView {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId

  // Source trade references
  sourceTradeIds String[] @db.ObjectId
  entryTradeId   String?  @db.ObjectId
  exitTradeId    String?  @db.ObjectId

  // Display fields (denormalized for fast queries)
  symbol       String
  isin         String? // ISIN for matching across symbol name changes (e.g., MF names change over time)
  exchange     String
  segment      String
  broker       BrokerType?
  brokerUserId String?

  // Entry details
  entryDate     DateTime
  entryPrice    Float
  entryQuantity Float

  // Exit details (null if OPEN)
  exitDate  DateTime?
  exitPrice Float?

  // Calculated fields
  quantity      Float
  realizedPnL   Float?
  pnlPercentage Float?

  // Status
  status PairedTradeStatus @default(OPEN)

  // Metadata
  pairingBatchId String
  computedAt     DateTime    @default(now())
  positionType   String      @default("LONG")
  productType    String      @default("CNC")
  sourceType     TradeSource @default(SYNCED)

  // Additional display fields
  tradeType        String? // BUY/SELL for entry
  segmentLabel     String?
  productTypeLabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, symbol])
  @@index([userId, isin]) // Index for ISIN-based queries
  @@index([userId, entryDate])
  @@index([userId, broker, brokerUserId])
  @@index([pairingBatchId])
  // MONEY-1129 - multikey index over the `sourceTradeIds` array. Serves the
  // `hasSome` predicate in packages/services/src/trades.service.ts (per-page
  // paired-view lookup on every tradebook load) and the standalone
  // `deleteMany({ userId, sourceTradeIds: { hasSome: ids } })` in
  // packages/services/src/trade-import.service.ts (import rollback).
  @@index([sourceTradeIds])
  // MONEY-1129 - these two exist to make the index above actually reachable.
  // The tradebook lookup is `{ userId, OR: [ sourceTradeIds hasSome,
  // entryTradeId in, exitTradeId in ] }`, and Mongo only index-serves an $or
  // when EVERY branch is indexed; with either sibling unindexed the planner
  // drops to a `userId`-prefix scan of ALL of that user's lots and filters the
  // $or in memory, leaving the sourceTradeIds index unused. Indexed together,
  // the three branches index-union and the scan is bounded by the page size.
  @@index([entryTradeId])
  @@index([exitTradeId])
  @@map("paired_trade_views")
}

enum PairedTradeStatus {
  OPEN
  CLOSED
  PARTIAL
}

