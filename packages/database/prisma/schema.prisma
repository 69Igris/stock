// Document Embedding Model (for RAG vector search)
model DocumentEmbedding {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Document identification
  docType String // "holdings", "trades", "fire_scenario", "analysis", "user_preferences"
  docId   String? // Reference to source document ID (e.g., FireScenario ID)

  // Content
  content String // Text content that was embedded
  chunkId Int    @default(0) // For chunked documents, which chunk this is

  // Vector embedding (768 dimensions)
  // Note: MongoDB Atlas Vector Search indexes this field
  embedding Float[]

  // Which model produced this vector (MONEY-619 Phase 5). Lets a re-embed /
  // retrieval distinguish embedding spaces: "text-embedding-004" (legacy) vs
  // "gemini-embedding-001" (env-gated by USE_GEMINI_EMBEDDING_001). A single
  // Atlas vector index must NOT mix spaces, so flipping the flag requires a
  // full re-embed backfill; this tag is how we tell which rows are current.
  embeddingModel String @default("text-embedding-004")

  // Metadata for filtering and context
  metadata Json? // Additional context like { symbol, broker, category }

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, docType, docId, chunkId])
  @@index([userId])
  @@index([userId, docType])
  @@index([docType])
  @@map("document_embeddings")
}

/// MONEY-1499 (data-platform B8) — the int8 half of `document_embeddings`.
///
/// Same keys, same `content` (INLINE — see below), one field changed: the
/// vector is BSON BinData int8 instead of 768 float64s. B0
/// (docs/reference/embeddings-decision-2026-09.md §2) measured the split as
/// 33.56 GiB of VECTOR against 10.68 GiB of TEXT, so quantizing the vector is
/// 29.4 GiB of the 39.0 GiB available and moving the text out is 9.6 GiB.
/// §5 took the first and DEFERRED the second: `content` staying here is a
/// decision, not an omission. Re-adding a `contentRef` costs a GCS round trip
/// on a path that runs inside a chat turn under a p95 budget.
///
/// ## `embedding` IS DELIBERATELY NOT DECLARED HERE
///
/// Prisma's `Bytes` scalar writes BSON binary subtype 0 (generic). Atlas
/// Vector Search requires subtype 9 (Vector) — a subtype-0 value is not a
/// vector to `mongot` and would simply not be indexed, with no error anywhere.
/// So the field is written and read as extended JSON through
/// `$runCommandRaw`, exactly like the `$vectorSearch` stage it feeds, and
/// declaring it would be a schema that lies about the BSON on disk AND would
/// make a plain `findMany({ select: { embedding: true } })` a live landmine.
/// `packages/core/src/embeddings-int8-logic.ts` owns the encoding;
/// `packages/core/__tests__/database/embeddings-v2-schema.test.ts` fails if
/// this field ever reappears — and also fails if a new writer calls
/// `prisma.documentEmbedding.upsert` without reaching v2, because after v1 is
/// renamed away that write does not error: MongoDB creates a fresh empty
/// `document_embeddings` and fills it, for ever.
model DocumentEmbeddingV2 {
  /// Copied VERBATIM from the v1 row it was migrated from, so the two
  /// collections join on `_id`, the resumable cursor is the same ordering, and
  /// a re-run of the backfill collides on the primary key instead of
  /// duplicating. Rows created new by the dual-write path get a fresh id in
  /// each collection; the business key below still dedups those.
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  docType String
  docId   String?

  content String
  chunkId Int     @default(0)

  /// sha256 of `content`. Two jobs: the duplication census B0 §6 requires
  /// (its `$group` blew a 120s ceiling on v1 and runs here instead), and
  /// evidence that a re-run wrote the same bytes.
  contentSha Bytes

  embeddingModel String @default("text-embedding-004")

  /// Constant 768 by construction — a row of any other width is REFUSED to
  /// the manifest rather than stored. Carried anyway because it is what tells
  /// a future re-embed which space a row is in, alongside `embeddingModel`.
  dims Int @default(768)

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, docType, docId, chunkId])
  @@index([userId])
  @@index([userId, docType])
  @@index([docType])
  @@map("document_embeddings_v2")
}

// ============== LEARNING CONTENT ==============

enum ContentStatus {
  PENDING // Content not generated yet
  GENERATING // Content being generated
  READY // Content ready for viewing
  FAILED // Generation failed
  UPDATING // Being updated/regenerated
}

enum GenerationType {
  SLIDES // PPT/Slide generation
  INFOGRAPHIC // Image infographic
  VIDEO // Veo 3 video generation
  AUDIO // ElevenLabs audio generation
}

enum GenerationStatus {
  PENDING // Queued for generation
  PROCESSING // Currently generating
  COMPLETED // Successfully completed
  FAILED // Generation failed
  CANCELLED // Cancelled by user
}

// ============== COURSE-BASED LEARNING ==============

// Course - Structured learning courses
model Course {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  slug        String       @unique
  title       String
  description String
  image       String?
  level       String // BEGINNER, INTERMEDIATE, ADVANCED
  duration    String
  topics      String[]
  published   Boolean      @default(false)
  order       Int          @default(0)
  chapters    Chapter[]
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([published])
  @@index([level])
  @@map("courses")
}

// Chapter - Groups lessons within a course
model Chapter {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  courseId  String         @db.ObjectId
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int            @default(0)
  lessons   CourseLesson[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([courseId])
  @@map("chapters")
}

// CourseLesson - Individual lesson within a chapter
model CourseLesson {
  id        String                 @id @default(auto()) @map("_id") @db.ObjectId
  chapterId String                 @db.ObjectId
  chapter   Chapter                @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title     String
  content   String
  type      String                 @default("TEXT") // TEXT, VIDEO, INTERACTIVE
  videoUrl  String?
  duration  String?
  order     Int                    @default(0)
  quizzes   Quiz[]
  progress  CourseLessonProgress[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([chapterId])
  @@map("course_lessons")
}

// Quiz - Quiz questions for a lesson
model Quiz {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  lessonId      String       @db.ObjectId
  lesson        CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question      String
  options       String[]
  correctAnswer Int
  explanation   String?
  order         Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([lessonId])
  @@map("quizzes")
}

// Enrollment - User enrollment in a course
model Enrollment {
  id             String                 @id @default(auto()) @map("_id") @db.ObjectId
  userId         String                 @db.ObjectId
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String                 @db.ObjectId
  course         Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress       Float                  @default(0)
  completedAt    DateTime?
  lessonProgress CourseLessonProgress[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

// CourseLessonProgress - Tracks user progress through course lessons
model CourseLessonProgress {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  enrollmentId String       @db.ObjectId
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  userId       String       @db.ObjectId
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String       @db.ObjectId
  lesson       CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed    Boolean      @default(false)
  quizScore    Float?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([enrollmentId, lessonId])
  @@index([userId])
  @@index([enrollmentId])
  @@map("course_lesson_progress")
}

// GlossaryTerm - Financial glossary terms
model GlossaryTerm {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  term       String   @unique
  definition String
  category   String?
  related    String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
  @@map("glossary_terms")
}

// ============== MARKET DATA ==============

// Instrument Mapping - Maps symbols between Yahoo Finance and brokers
model InstrumentMapping {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Symbol identifiers
  symbol        String // Base symbol (e.g., RELIANCE)
  exchange      String // NSE, BSE, NFO, BFO, MCX
  yahooSymbol   String // Yahoo Finance symbol (e.g., RELIANCE.NS)
  tradingSymbol String? // Broker trading symbol (e.g., NIFTY24JANFUT for F&O)

  // Broker-specific identifiers
  zerodhaToken    Int? // Zerodha instrument token
  upstoxKey       String? // Upstox instrument key (e.g., NSE_EQ|INE002A01018)
  angelToken      String? // Angel One token
  fyersSymbol     String? // Fyers symbol
  dhanSecurityId  String? // Dhan security ID
  growwSchemeCode String? // Groww mutual fund scheme code

  // Security details
  isin            String? // ISIN code
  // MONEY-1177 — exchange symbols this instrument traded under BEFORE a rename
  // or demerger. Needed because `syncInstruments` upserts on (symbol, exchange),
  // so a rename creates a NEW row rather than renaming the old one, and the
  // retired ticker then matches nothing at all: searching ZOMATO (now ETERNAL)
  // or TATAMOTORS (now TMCV + TMPV) returns zero results, not a degraded one.
  //
  // ISIN is the durable identity — it is what let `resolveInstrumentId` reattach
  // Zomato-era price history to ETERNAL during the MONEY-1175 re-parse — but ISIN
  // is not what a user types. This is the searchable projection of that identity's
  // label history. Backfilled from the dated (symbol, ISIN) pairs in the archived
  // bhavcopies; maintained forward by instrument-sync's rename detection.
  previousSymbols String[] @default([])
  name            String // Full company name
  sector          String?
  industry        String?
  description     String? // AI-generated company description
  series          String? // EQ, BE, etc.

  // Instrument type
  instrumentType String @default("EQUITY") // EQUITY, INDEX, FUTURES, OPTIONS, ETF, MF

  // For F&O
  expiryDate  DateTime?
  strikePrice Float?
  optionType  String? // CE, PE
  lotSize     Int?

  // Additional instrument details
  tickSize    Float? // Minimum price movement
  segmentCode String? // Exchange segment (e.g., NSE_EQ, NSE_FO)

  // Status
  isActive     Boolean   @default(true)
  lastUpdated  DateTime  @default(now())
  lastSyncedAt DateTime? // Last time this instrument was synced from broker dump

  // Sync tracking for persistent market data
  tickertapeSid      String? // Tickertape security ID for API calls
  financialsSyncedAt DateTime? // Last financials sync
  ratiosSyncedAt     DateTime? // Last ratios sync
  lastAnalyzedAt     DateTime? // Last AI analysis
  /// AMFI scheme code for an ETF/MF instrument, resolved ONCE from the ISIN
  /// rather than re-joined per request. Three surfaces used to derive fund
  /// identity independently and disagree (MONEY-1207): the ETF page rendered a
  /// title-cased ticker prefix as the AMC while `mutual_fund_masters` held the
  /// real name one ISIN join away.
  amfiSchemeCode     String?

  analysisCount Int @default(0) // Times analyzed by users

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Document sync tracking
  documentsSyncedAt DateTime? // Last stock document sync
  /// MONEY-1215 — rotation markers for `news-sync` and `filings-sync`.
  ///
  /// Both jobs discover a batch of 50 from a population of ~102 (holdings +
  /// watchlist), so WHICH 50 is not cosmetic — without a per-job recency marker
  /// the sort is constant and the same half is processed forever. That is
  /// exactly what `orderBy: { analysisCount: "desc" }` did over a population
  /// where every row's analysisCount is 0.
  ///
  /// Separate fields per job on purpose: a shared "lastTouched" would let the
  /// news run reset the filings rotation and vice versa, so each job would see
  /// a population that looks freshly synced for work it never did.
  newsSyncedAt      DateTime?
  filingsSyncedAt   DateTime?
  /// MONEY-1217 — the same rotation marker for `events-sync`.
  ///
  /// That job's Yahoo fallback was scoped to `alerts ∪ holdings ∪ watchlist`
  /// (~102 large caps) while the surface reading `UpcomingEvent` asks by SECTOR
  /// CONSTITUENT (238 names for Financial Services), so the two populations
  /// barely intersected. Widening it to the WARM tier (~781) made the per-run
  /// cap load-bearing: without a per-job recency marker the sort over that
  /// population is constant and the same 200 symbols are fetched forever.
  ///
  /// A third field rather than a shared "lastTouched", for the reason stated
  /// above: one job's run must not reset another's rotation.
  eventsSyncedAt    DateTime?

  /// ── Screener identity, for the companies NSE cannot reach — MONEY-1255 ──
  ///
  /// 2,389 real companies are listed on BSE with NO NSE row. Every
  /// financial-document producer we have is NSE-keyed, so those companies can
  /// never receive an annual report, quarterly result or financial statement —
  /// measured coverage 46.7% of 5,523 real companies, and the rotation fix
  /// alone ceilings at 56.8% for exactly this reason.
  ///
  /// screener.in can reach all of them. Probed 2026-08-27: 24 of 24 sampled
  /// BSE-only companies resolve through `/api/company/search/?q=<symbol>` on
  /// our own symbol, and 11 of 12 carry 8-13 years of annual reports. The slug
  /// it returns is USUALLY THE BSE SCRIP CODE (`/company/511122/`), which is
  /// why `bseScripCode` is derived here rather than fetched separately — we
  /// hold zero scrip codes today, and the XBRL bridge needs them.
  ///
  /// ## `null` here is a FINDING, not a failure — and never permanent
  ///
  /// `screenerSlug: null` WITH a fresh `screenerSlugCheckedAt` means "we asked
  /// and screener has no page for this company", which is a real, useful,
  /// re-checkable state. It is deliberately NOT the same as never-asked
  /// (`screenerSlugCheckedAt` absent). Re-checked after a TTL because new
  /// listings appear: a company that had no page in March may have one in
  /// December, and a cached "no" that never expires is a fail-open default
  /// frozen into the database.
  ///
  /// ## ABSENT, not null, on every existing row
  ///
  /// A Mongo `prisma db push` creates INDEXES, never FIELDS. All ~20,804
  /// existing rows carry no such attribute, and Prisma's Mongo connector does
  /// not treat absent as null — BOTH `{screenerSlug: null}` and
  /// `{screenerSlug: {not: null}}` return ZERO. Any selection must spell it
  /// `OR: [{f: null}, {f: {isSet: false}}]`, or resolve lazily in code from a
  /// row already in hand (which is what the sync does, so no query filters on
  /// these at all). This class has caused MONEY-1050, MONEY-1205, MONEY-1234
  /// and MONEY-1236.
  ///
  /// ## Wrong is worse than missing
  ///
  /// A slug is a claim that a screener page BELONGS to this company. Accepting
  /// a near-match would attach another company's annual reports to this
  /// symbol — silently, and indistinguishably from correct data. The resolver
  /// therefore validates strictly and stores `null` plus a counted
  /// `slugAmbiguous` rather than guessing.
  screenerSlug          String?
  screenerSlugCheckedAt DateTime?
  /// BSE scrip code, derived when the resolved screener slug is numeric.
  /// Also the join key a BSE XBRL ingest needs: a BSE-filed instance may
  /// identify its issuer ONLY by scrip code, and `XbrlFiling.symbol` is
  /// required — so the bridge must resolve before the write, never after.
  bseScripCode          String?

  /// US securities do NOT live in this table — see `UsInstrument`.
  ///
  /// They did, briefly, on this branch, and the audit that moved them is worth
  /// stating because the pull to put them back will recur. `instrument_mappings`
  /// has 143 read sites; 37 are India-facing and carry NO venue clause, and a
  /// structural guard written to catch them covered 8. Three of the 37 are
  /// nightly jobs — `refreshAllQuotes`, `runHistoricalBackfill`, `peers-sync` —
  /// that select `{isActive: true}` across the whole table and would have swept
  /// ~23k US tickers into Yahoo, writing a SECOND US price series beside
  /// `candles`. None of that is a bug in those readers: they were correct for
  /// every row this table held for two years.
  ///
  /// The deciding argument is `deactivateStaleInstruments`, whose scope is
  /// `exchangeFilter?.length ? {exchange: {in}} : {}` — one forgotten argument
  /// deactivates the other market's entire universe, and the only backstop is a
  /// 10% ratio breaker. With two collections that call cannot see a US row at
  /// all. Safe by construction beats safe by remembering.

  // Relations
  dailyPrices               DailyPrice[]
  intradayBars              IntradayBar[]
  latestQuote               LatestQuote?
  stockFinancials           StockFinancials[]
  stockRatios               StockRatios?
  stockPeers                StockPeers?
  stockShareholding         StockShareholding[]
  stockNews                 StockNews[]
  stockProfile              StockProfile?
  stockDocuments            StockDocument[]
  documentFinancialExtracts DocumentFinancialExtract[]
  // MONEY-1113 P10 F1 / MONEY-1105 P8a. Both sides are OPTIONAL on the child:
  // a filing whose issuer is not (yet) in this table, and a fund holding whose
  // ISIN did not resolve, are still real records. Requiring the join here would
  // silently discard exactly the rows that reveal a mapping gap.
  xbrlFilings               XbrlFiling[]
  mfHoldings                MfPortfolioHolding[]

  @@unique([symbol, exchange])
  @@unique([yahooSymbol])
  @@index([zerodhaToken])
  @@index([upstoxKey])
  @@index([isin])
  // MONEY-1177. Required, not optional: the regex search fallback ORs this
  // branch with symbol/name, and Mongo only index-serves an $or when EVERY
  // branch has an index — an un-indexed previousSymbols would degrade the whole
  // OR to a collection scan, which is exactly the MONEY-1129 regression noted
  // on @@index([name]) below.
  @@index([previousSymbols])
  @@index([instrumentType])
  @@index([isActive])
  @@index([amfiSchemeCode])
  @@index([tradingSymbol])
  @@index([isActive, instrumentType, exchange])
  @@index([isActive, instrumentType, sector])
  @@index([tickertapeSid])
  @@index([analysisCount])
  // MONEY-1129 - the regex search fallback in apps/web/lib/market/symbol-mapper.ts
  // filters `OR: [{ symbol: { startsWith } }, { name: { startsWith } }]`. Mongo
  // only index-serves an $or when EVERY branch has an index; `symbol` had one
  // (via @@unique([symbol, exchange])) but `name` did not, so the whole OR - the
  // cheap symbol-prefix branch included - degraded to a collection scan. This is
  // the permanent search path in QA/dev and the prod path whenever Atlas Search
  // falls back. NOTE the name branch uses `mode: "insensitive"`, which compiles
  // to a case-insensitive regex and therefore cannot take tight prefix bounds -
  // the win here is index-union + scanning index keys instead of fetching every
  // document, not a bounded seek.
  @@index([name])
  @@map("instrument_mappings")
}

// Daily Price - Historical OHLCV data cached from Yahoo Finance
// FeedBackfillProgress - per (family, date) checkpoint for the historical
// feed backfill (MONEY-941 / Data Engine P3).
//
// A SEPARATE COLLECTION rather than MarketDataSyncLog.metadata, deliberately.
// The backfill walks tens of thousands of (family, date) pairs and its whole
// design is resumability: every restart asks "which days of this family are
// already done?". As a JSON blob on a log row that question is a full document
// scan and a client-side filter; as a collection with a compound unique it is
// an indexed lookup. MarketDataSyncLog stays what it is — one row per RUN.
//
// `status` carries the distinction that matters most here:
//   DONE     bytes fetched (and archived when the archive is armed)
//   MISSING  a 404 — the day is a GAP, not the end of history. NSE's archive is
//            sparse (1994-11-03 present, 11-04 absent, 12-01 present), and
//            pre-2000 holiday calendars are unavailable to us, so a 404 can
//            never be promoted to "this range is over". Only K consecutive
//            weekday misses past the floor end a range.
//   ERROR    a real failure (5xx, network, payload rejected) — retryable, and
//            counted against the per-day stop-loss.
// DerivativeSummary - one underlying's whole F&O chain reduced to one day
// (MONEY-1100 / P4.4). Derived, not sourced: every field is recomputable from
// derivative_eod, so this table is a cache of an expensive fold, and the job
// that writes it must be idempotent per (symbol, exchange, date).
//
// Keyed WITH exchange, matching DerivativeEOD's own unique. NSE and BSE run
// separate F&O segments (BSE's SENSEX/BANKEX weeklies are a real book), so the
// two chains for a same-named underlying are disjoint universes — summing them
// would double-count OI and produce a PCR for a book nobody holds.
//
// OI/volume aggregates are BigInt, not Int: ABCAPITAL — a mid-cap, on a quiet
// day — prints 40,148,100 futures OI, and an index chain aggregated across all
// strikes and live expiries runs two orders of magnitude higher. Same call the
// repo already made for DailyPrice.deliveryQty.
// MONEY-1098 (P5.6) — NSE public issues (IPO). Fed by workers/src/processors/ipo-sync.ts
// from /api/all-upcoming-issues?category=ipo + /api/ipo-current-issue + /api/public-past-issues.
// EVERY date and price field is nullable: issues get postponed, bands get revised and
// windows get EXTENDED mid-issue, so the only honest default is "not known yet".
model UpcomingIpo {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  symbol      String
  companyName String?
  series      String? // EQ (mainboard) | SME | ST
  isSme       Boolean @default(false)

  issueStart  DateTime? // bid open — half the unique key; no-start rows are counted skips
  issueEnd    DateTime?
  listingDate DateTime?

  priceMin  Float?
  priceMax  Float?
  issueSize Float? // AS PRINTED by NSE — unit not normalised (shares vs crore)
  lotSize   Int?

  status String @default("UPCOMING") // UPCOMING | OPEN | CLOSED | LISTED
  source String // current | upcoming | past — which endpoint won the merge
  raw    Json? // the raw upstream row, for replay when the shape is falsified

  firstSeenAt DateTime @default(now()) // create-only: how long it has been forthcoming
  fetchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([symbol, issueStart])
  @@index([status, issueStart])
  @@index([issueStart])
  @@map("upcoming_ipos")
}

// MONEY-1098 P5.4 — quarterly shareholding pattern per symbol, from NSE's
// /api/corporate-share-holdings-master. UNVERIFIED SHAPE: every column is filled
// by an alias-driven parser (research/data-sources/ownership-logic.ts) whose
// guessed keys are falsified by the first prod run's `keyHits` counters in
// MarketDataSyncLog.metadata.legStats — not by anything in this block.
model ShareholdingPattern {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  /// NSE trading symbol, bare (no .NS suffix), upper-cased.
  symbol            String
  exchange          String   @default("NSE")
  /// Canonical quarter label — `YYYY-MM` of the quarter END when the source
  /// value parsed as a date, else the verbatim upper-cased label (capped at 32
  /// chars). normalizeQuarter() is what makes `31-Mar-2026`, `2026-03-31` and
  /// `31/03/2026` ONE key instead of three, which is the only reason the unique
  /// below holds.
  quarter           String
  /// EVERY percentage is nullable and is NEVER defaulted to 0. `-` or blank in
  /// an NSE table means NOT REPORTED, and `Number("")` is 0 — that coercion is
  /// how an undisclosed promoter pledge becomes a fabricated all-clear. A `0`
  /// in these columns means a filer reported zero.
  promoterPct       Float?
  pledgedPct        Float?
  fiiPct            Float?
  diiPct            Float?
  publicPct         Float?
  /// Present in NSE's summary payload as `employeeTrusts` / `underlyingDrs`
  /// and previously dropped on the floor. MONEY-1207.
  employeeTrustsPct Float?
  underlyingDrsPct  Float?
  /// The source row verbatim, JSON-stringified. String, not Json: the shape is
  /// unverified, so this is an audit artifact to RE-PARSE from, and a Json
  /// column would invite queries against keys that may not survive the first
  /// shape correction.
  raw               String
  source            String   @default("NSE_SHP")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  /// One pattern per symbol per EXCHANGE per quarter. A restatement REPLACES
  /// the row (last filing wins) rather than accumulating — hence upsert.
  ///
  /// `exchange` joined the key in MONEY-1207, before the BSE provider shipped
  /// and not after. NSE and BSE publish the SAME company's pattern separately,
  /// and 2,465 symbols are listed on both (measured on prod). Without
  /// `exchange` in the key the first BSE write would have upserted straight
  /// over the NSE row for every one of them — not a duplicate, an ERASURE, and
  /// a silent one, since both rows are legitimately named the same company.
  @@unique([symbol, exchange, quarter])
  /// Cross-sectional read: "every name whose promoter pledge moved in 2026-03".
  /// The unique's (symbol, …) prefix cannot serve a quarter-only predicate.
  /// No separate [symbol, quarter DESC] index: with an equality match on the
  /// prefix, Mongo walks the unique's index backwards for a DESC sort.
  @@index([quarter])
  @@map("shareholding_patterns")
}

/// Per-quarter shareholding BREAKDOWN, parsed from the XBRL that NSE links from
/// the same payload the summary comes from (`xbrl` / `xbrlFileSize` keys).
///
/// SEPARATE from `ShareholdingPattern` on purpose, and the separation is the
/// point (MONEY-1207):
///
///   - `shareholding_patterns` is NSE's SUMMARY endpoint: promoter + public +
///     employee trusts + DRs. It has no FII/DII split at all — the columns for
///     them existed and were null on 100% of 7,953 rows, which read as "this
///     company has no institutional holders" rather than "we never fetched it".
///   - this table is the FILING itself, category by category, with its own
///     provenance and its own fetch cadence. A missing row here means the XBRL
///     was not parsed; it says nothing about the summary, and vice versa.
///
/// Same absence rule as everywhere in this schema: every percentage is nullable
/// and is NEVER defaulted to 0. A `0` means a filer reported zero.
model ShareholdingBreakdown {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  symbol   String
  exchange String @default("NSE")
  /// Canonical `YYYY-MM` of the quarter END, produced by the SAME
  /// normalizeQuarter() as ShareholdingPattern so the two join on (symbol,
  /// quarter) without a second spelling of the rule.
  quarter  String

  // ── Promoter ──────────────────────────────────────────────────────────────
  promoterPct        Float?
  promoterPledgedPct Float?

  // ── Institutional, foreign ────────────────────────────────────────────────
  /// FPIs (SEBI Cat I + II). "FII" is the retail-facing name for this line.
  fiiPct Float?

  // ── Institutional, domestic. `diiPct` is the filing's own DII total when it
  //    states one; it is NOT computed by summing the legs below, because a
  //    filing may carry legs we do not model and a derived total would then
  //    silently understate. Null total + populated legs is a legitimate state.
  diiPct          Float?
  mutualFundPct   Float?
  insurancePct    Float?
  banksFiPct      Float?
  alternateInvPct Float?
  govtPct         Float?

  // ── Public and the rest ───────────────────────────────────────────────────
  publicPct               Float?
  retailPct               Float?
  employeeTrustPct        Float?
  custodianDrPct          Float?
  nonPromoterNonPublicPct Float?

  // ── Absolute counts, where the filing gives them. BigInt: an Indian large
  //    cap's share count exceeds 2^53 in paise-denominated derivations.
  promoterShares BigInt?
  fiiShares      BigInt?
  diiShares      BigInt?
  publicShares   BigInt?
  totalShares    BigInt?

  /// The XBRL document this row was read from, so a disputed figure is
  /// checkable against the filing rather than against our parse of it.
  sourceUrl String?
  /// Verbatim source, JSON-stringified — an audit artifact to RE-PARSE from
  /// when the taxonomy shifts. String not Json, same reasoning as
  /// ShareholdingPattern.raw.
  raw       String
  source    String   @default("NSE_SHP_XBRL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A restatement REPLACES the row (last filing wins), so upsert, not create.
  @@unique([symbol, exchange, quarter])
  @@index([quarter])
  @@index([symbol, exchange])
  @@map("shareholding_breakdown")
}

// MONEY-1098 P5.4 — PIT (SEBI Reg 7 insider), SAST Reg-29 and promoter-pledge
// events, one row per disclosure. Three feeds, one table: they answer the same
// question ("who moved this stock's ownership, when, how much") and splitting
// them would make the only interesting query a three-way union.
model InsiderEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  symbol    String
  exchange  String   @default("NSE")
  /// UTC midnight of the IST calendar day the filing names. For PIT this is the
  /// TRANSACTION window end (acqtoDt), NOT the intimation date: the analytical
  /// question is when the insider traded, and an intimation date can be
  /// restated — which would mint a second dedupeKey for one event.
  date      DateTime
  /// The disclosing / acquiring person or entity. "" when the feed omits it.
  person    String   @default("")
  /// PIT | SAST | PLEDGE
  category  String
  /// BUY | SELL | PLEDGE_CREATION | PLEDGE_RELEASE | PLEDGE_INVOCATION — or the
  /// VERBATIM upper-cased source text when unrecognized. Deliberately not an
  /// enum with an OTHER bucket: the day SEBI adds a transaction type, every row
  /// of it would become indistinguishable from every other unknown.
  action    String   @default("")
  /// BigInt, not Int, for the same reason as InstitutionalDeal.qty: a share
  /// count in a high-float penny name exceeds Int32. Write via BigInt(n) through
  /// Prisma — never $runCommandRaw, which stores a double.
  qty       BigInt?
  /// Rupee value. Nullable, never 0 on a `-` — see ShareholdingPattern.
  value     Float?
  raw       String
  /// NSE_PIT | NSE_SAST | NSE_PLEDGE — provenance back to the exact feed.
  source    String
  createdAt DateTime @default(now())

  /// SHA-256 hex of insiderEventKey(row) — the ALL-BUSINESS-FIELDS identity
  /// (category|symbol|dateISO|person|action|qty|value), derived in
  /// research/data-sources/ownership-logic.ts.
  ///
  /// WHY A DERIVED KEY AT ALL: insider filings ship NO stable identifier. No
  /// filing id, no ack number, no URL that survives a restatement in any of the
  /// three feeds — and NSE's per-symbol endpoints serve a ROLLING window, so
  /// every weekly run re-reads the same disclosures. Without an identity the
  /// table grows by one duplicate set per run, forever.
  ///
  /// WHY ALL FIELDS: the same promoter can legitimately file two trades in the
  /// same name on the same day at different sizes, and BOTH must survive — so
  /// qty and value are part of the identity, not attributes of it. Only a
  /// byte-identical repeat collapses. `raw` is deliberately EXCLUDED: it carries
  /// volatile fields (attachment URLs with rotating tokens), and including it
  /// would mint a new key for an unchanged event on every run — precisely the
  /// failure the key exists to prevent.
  ///
  /// WHY HASHED, not a literal @@unique over the 7 columns: that alternative is
  /// variable-width free-text (`person`, `action`), useless as a query prefix,
  /// and would put a Float (`value`) inside a uniqueness constraint. One
  /// fixed-width derived key sidesteps all three and keeps the normalisation in
  /// a unit-tested function. Same posture as P4.6's InstitutionalDeal.dedupeKey.
  dedupeKey String

  @@unique([dedupeKey])
  /// Hot read: the stock-detail Ownership tab — this symbol's events, newest
  /// first, optionally narrowed to one category.
  @@index([symbol, category, date(sort: Desc)])
  /// Cross-sectional: "every insider BUY this week", "all pledges created in
  /// June" — symbol is not in the predicate, so the index above cannot serve it.
  @@index([category, date(sort: Desc)])
  /// Ops/audit sweeps for a given day (re-parse verification, retention).
  @@index([date])
  @@map("insider_events")
}

model DerivativeSummary {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  symbol   String // underlying, e.g. "RELIANCE" / "NIFTY"
  exchange String   @default("NSE")
  date     DateTime // Trading date (UTC midnight of the IST day)

  // Headline derivables. EVERY field is nullable and null means "could not
  // determine" — never 0. DerivativeSummaryCalc in
  // core/market-data/fo-analytics-logic.ts is the spec; this is storage.
  futOi       BigInt? // total futures OI across ALL expiries (roll-proof basis)
  futOiChange BigInt? // vs previous TRADING day, same basis; null = no prev day
  futBasisPct Float? // (near fut close - underlying close) / underlying * 100
  pcrOi       Float? // put/call OI, all expiries; null when call side is 0
  pcrVol      Float? // put/call volume, same rule
  maxPain     Float? // strike minimising ITM payout on the near OPTION chain
  rolloverPct Float? // ROLLED-FORWARD share of futures OI (market convention)
  oiBuildup   String? // LONG | SHORT | LONG_UNWIND | SHORT_COVER

  // Components — without these the headlines are unauditable after the fact.
  // nearExpiryOiPct is deliberately NOT stored: it is exactly 100 - rolloverPct
  // and a stored duplicate is a thing that can drift.
  nearFutExpiry   DateTime? // contract the basis/rollover/buildup used
  nearFutOi       BigInt?
  nearFutClose    Float?
  maxPainExpiry   DateTime? // != nearFutExpiry whenever weeklies are listed
  callOi          BigInt?
  putOi           BigInt?
  callVol         BigInt?
  putVol          BigInt?
  underlyingClose Float? // echo of the cash close the basis was priced against

  source    String   @default("BHAVCOPY_HIST")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, exchange, date])
  @@index([symbol, date])
  @@index([date])
  @@map("derivative_summary")
}

model FeedBackfillProgress {
  id     String   @id @default(auto()) @map("_id") @db.ObjectId
  family String // REPORT_REGISTRY family id, e.g. "nse-cm-legacy"
  date   DateTime // Trading date walked (UTC midnight of the IST day)
  // TWO vocabularies share this field, split by the `family` namespace, and
  // neither is listed here — a list duplicated in a comment has now drifted
  // twice (ZERO in MONEY-1169, UNREADABLE in MONEY-1205, both invisible from
  // here). The authorities are:
  //   family "<id>"        the WALK — DONE | MISSING | ERROR, described in the
  //                        "FeedBackfillProgress - per (family, date)
  //                        checkpoint" block comment earlier in this file.
  //   family "parse:<id>"  the PARSE — see `PARSE_STATUS` in
  //                        scripts/jobs/feed-parse.ts, which also documents
  //                        which statuses are terminal on resume and why.
  status String
  bytes  Int      @default(0)
  detail String? // error text / http status, for triage
  at     DateTime @default(now())

  // Resume reads this: "everything already terminal for family X". Compound
  // unique also makes the checkpoint write an idempotent upsert, so a job that
  // dies mid-day and restarts cannot double-count.
  @@unique([family, date])
  @@index([family, status])
  @@map("feed_backfill_progress")
}

// DerivativeEOD - end-of-day derivatives bar (MONEY-941 / P3 step 4).
//
// Separate from DailyPrice because a derivative is not keyed by instrument
// alone: the same underlying has many simultaneously-live contracts that differ
// by expiry, strike and option type, and they have fields cash equities do not
// (settlement price, open interest and its change). Forcing them into
// DailyPrice would mean either a null-riddled cash table or a fake instrument
// row per contract — and MONEY-1085's rule forbids minting instruments from
// price files.
//
// Keyed on the CONTRACT rather than on an InstrumentMapping FK for the same
// reason: F&O contracts expire, so most of them will never exist in
// instrument_mappings, and a required FK would silently drop the majority of
// the history this model exists to hold.
/// Per-stock exchange flag — MONEY-1100 P4.5. APPEND-ONLY.
///
/// One row per (stock, day, flag) as published. Nothing upserts, dedupes or
/// diffs against yesterday: the HISTORY is the signal. "XYZ entered GSM Stage I
/// on 4-Aug and left on 21-Aug" is the retail warning; a current-state table can
/// only ever answer "not flagged today" and loses the entry date the moment the
/// flag clears. A stock carrying the same code for 40 sessions is 40 rows.
///
/// `kind` is a String, not a Prisma enum, on purpose: NSE adds frameworks
/// without notice (ESM appeared in 2023), and an enum makes a new flag family
/// un-storable until a schema push lands. The TS union `StockFlagKind` in
/// core/market-data/stock-flags.ts is the source of truth.
///
/// `value` encoding is fixed per kind — see the module doc in stock-flags.ts.
/// Surveillance codes are stored VERBATIM and decoded at read time
/// (`decodeSurveillanceCode`), so a better decode table re-reads old rows.
model StockFlag {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  /// NSE trading symbol exactly as published (keeps NSE's `$` suffix).
  symbol       String
  exchange     String   @default("NSE")
  /// Settlement series when the file names one (EQ/BE/BZ/SM/ST), else null.
  series       String?
  /// Resolved InstrumentMapping id when the writer could join, else null.
  /// A plain ObjectId scalar, NOT a Prisma relation: adding a relation would
  /// require a back-reference on InstrumentMapping, and — more importantly —
  /// dropping unresolved rows would throw away exactly the flags worth having
  /// (SME/`$`-suffixed names are the ones that get surveilled).
  instrumentId String?  @db.ObjectId
  /// UTC midnight of the trading day the flag describes (not the fetch day).
  date         DateTime
  /// BAND_CHANGE | PRICE_BAND | SURVEILLANCE | FO_BAN | WK52_HIGH_LOW |
  /// SERIES_CHANGE | SHORT_SELLING
  kind         String
  /// Compact JSON or a bare code; encoding fixed per kind.
  value        String
  /// report-registry family id (e.g. "nse-fo-secban") — provenance back to the
  /// exact archived family and its URL builder.
  source       String
  /// Ingestion time, deliberately distinct from `date` ("when we learned it").
  createdAt    DateTime @default(now())

  // NO @@unique ANYWHERE. A unique on (symbol,date,kind) — or worse
  // (symbol,kind,value) — would silently collapse a 40-day ban into one row and
  // destroy the run length, which IS the datum. Re-run safety comes from the
  // existing feed-parse `family_date` checkpoint, not from a DB constraint.

  /// Hot read: the stock-detail surface — this stock's flags, newest first,
  /// optionally narrowed to one kind ("is it under surveillance, and since
  /// when?"). Prefix (symbol) and (symbol,kind) both served.
  @@index([symbol, kind, date(sort: Desc)])
  /// Cross-sectional read: "everything banned today", "all names entering GSM
  /// this week" — the market-wide digest. symbol is not in the predicate here,
  /// so the index above cannot serve it.
  @@index([kind, date(sort: Desc)])
  /// Ops/audit sweeps: what landed for day D (re-parse verification, retention,
  /// the MONEY-1169 "files but zero rows" class). Neither index above has a
  /// date-only prefix.
  @@index([date])
  @@map("stock_flags")
}

// MONEY-1108 P8d — daily FII/DII institutional flows, the "who bought today"
// sentiment datum. Source: NSE `/api/fiidiiTradeReact` (provisional cash
// market), parsed by core/market-data/institutional-flows.ts.
//
// Market-WIDE, not per-symbol: one row per (day, category, segment) for the
// entire market, so the table grows by ~2 rows/trading day. Per-stock FII
// attribution is a different dataset entirely (`StockShareholding`, from P5).
//
// UNBACKFILLABLE. The endpoint takes no date parameter and serves only the
// current reading, so a day not captured never enters the table. Hence the
// daily schedule and the archived raw bytes (feeds/NSE/api/fii-dii/) — those
// are the only durable copy if this parser ever needs re-running.
model InstitutionalFlow {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// UTC midnight of the IST trading day the flow describes — NOT the fetch
  /// day. The two differ whenever an archived response is replayed.
  date     DateTime
  /// "FII" | "DII". FII and FPI are the same money under two regulatory
  /// names and NSE prints them as one bucket, so they collapse to FII.
  category String
  /// "CASH" today. Present from the start so the F&O participant leg
  /// (fao_participant_oi/vol, arriving via P2) and the NSDL FPI leg can be
  /// added as segments without a migration or a re-read of existing rows.
  segment  String   @default("CASH")

  /// Gross purchases in ₹ CRORE — NSE's own unit, stored UNCONVERTED. The
  /// unit lives in the field's documentation rather than its name because all
  /// three money columns share it (cf. IndexClose.turnoverCr, which needed the
  /// suffix only because its siblings are in different units).
  buyValue  Float
  /// Gross sales, ₹ crore.
  sellValue Float
  /// Net (buy − sell), ₹ crore. Negative = net selling. Stored rather than
  /// derived at read time: NSE publishes its own net, and a publisher
  /// correction to it is data we would otherwise discard.
  netValue  Float

  /// Provenance — INSTITUTIONAL_FLOW_SOURCES, e.g. "NSE_FII_DII_CASH".
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// UNIQUE, deliberately — and note this is the OPPOSITE call from StockFlag
  /// above, which forbids one. There, consecutive days ARE the datum (a 40-day
  /// ban collapsing to one row destroys the run length). Here each
  /// (day, category, segment) is a single scalar reading, so a re-run must
  /// OVERWRITE it, not append a second copy. Without this, one Pub/Sub
  /// redelivery would double a day's flows in every aggregate built on them.
  @@unique([date, category, segment])
  /// Hot read: the sentiment panel's "last N days of FII net flow" series.
  @@index([category, date(sort: Desc)])
  /// Cross-sectional: everything recorded for day D (ops sweeps, the
  /// flow-vs-Nifty overlay joining on date).
  @@index([date])
  @@map("institutional_flows")
}

// MONEY-1106 (Data Engine P8b) — official Indian macro series.
//
// One row = one (series, period) observation. Sources are RBI's National
// Summary Data Page, which republishes the Weekly Statistical Supplement plus
// MOSPI's CPI and the Office of the Economic Adviser's WPI. The source registry,
// the label→seriesId map and both HTML parsers live in
// `@usemoney/core/market-data/macro-series` (pure, unit-tested); the worker
// (`workers/src/processors/macro-sync.ts`) only does I/O.
//
// Feeds: FIRE real-return assumptions, research-agent macro context, market
// context panels.
model MacroSeries {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// Canonical series id, e.g. RBI_REPO_RATE / MOSPI_CPI_COMBINED /
  /// OEA_WPI_ALL_COMMODITIES / RBI_FOREX_RESERVES_TOTAL_USD_MN. Stable forever:
  /// it is half the unique key, so renaming one forks the series in place
  /// rather than moving it.
  seriesId String

  /// UTC midnight of the period the observation describes.
  ///
  /// WEEKLY / FORTNIGHTLY → the period-END date exactly as RBI publishes it
  /// ("week ended Jul. 31" → 2026-07-31). MONTHLY → the FIRST of the month
  /// (June 2026 → 2026-06-01), because the page names a month and no day; a
  /// month-end anchor would have to guess 28/29/30/31 and would move under a
  /// leap year.
  ///
  /// Deliberately NOT the fetch date. Every one of these pages shows several
  /// past periods at once, so "when we read it" and "what it is about" are
  /// different facts — conflating them is what made the F&O summaries look
  /// complete in MONEY-1189.
  period DateTime

  /// The observation. Always finite: `parseMacroNumber` rejects blanks, RBI's
  /// several absence markers, and the published bank RANGES ("8.40/10.00")
  /// before a value can ever reach here.
  value Float

  /// PERCENT | INDEX | INR_CRORE | USD_MILLION | INR_PER_UNIT. Stored per row
  /// because one page mixes all of them, so a bare Float is uninterpretable.
  unit String

  /// WEEKLY | FORTNIGHTLY | MONTHLY — how to read the gap between periods.
  frequency String

  /// MacroSource id ("rbi-nsdp-rates"), i.e. provenance back to the exact URL
  /// builder that produced this row.
  source String

  /// The upstream row label VERBATIM, base-year parenthetical included
  /// ("Wholesale Price Index (2022-23=100)"). Matching strips that so a rebase
  /// keeps feeding the same seriesId; keeping the raw label here is what makes
  /// the resulting level DISCONTINUITY discoverable instead of invisible.
  label String

  /// The page's own release stamp ("Date : Aug 07, 2026"), when present.
  /// Distinct from `period`: it is when RBI published, not what it is about.
  releasedOn DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// THE idempotency key. Re-ingestion is the normal case, not the exception:
  /// the rates page shows 6 week-ended columns and the prices page 3 months, so
  /// a weekly run re-reads periods it already stored — by design, because that
  /// overlap is what heals a missed run. Upserting on (seriesId, period) makes
  /// every one of those a no-op update instead of a duplicate.
  ///
  /// `source` is NOT in the key, on purpose. It is provenance, not identity: if
  /// a series ever moved to a different page, keying on source would silently
  /// fork one economic series into two rather than continuing it. Adding
  /// `unit` would be the same mistake — a unit change is a redefinition that
  /// must be visible, and the two forex magnitudes are already distinct
  /// seriesIds (…_INR_CR / …_USD_MN) precisely so this key stays honest.
  @@unique([seriesId, period])
  /// Hot read: one series as a time series, newest first ("repo rate history").
  /// The unique above is (seriesId, period) ASC, which cannot serve a DESC scan
  /// as cheaply.
  @@index([seriesId, period(sort: Desc)])
  /// Cross-sectional read: "everything as of period P" for a macro panel, and
  /// the ops sweep for what a given run wrote.
  @@index([period(sort: Desc)])
  /// Provenance sweep: "what did rbi-nsdp-forex write, and when did it stop".
  @@index([source, period(sort: Desc)])
  @@map("macro_series")
}

// MONEY-1187 (Data Engine P11) — participant-wise F&O positioning.
//
// One row = one (day, participant, bucket) reading: how many contracts Client /
// DII / FII / Pro held long and short in each of the six derivative buckets.
// This is the "who is positioned which way" datum that the FII/DII CASH flows
// above cannot answer — `InstitutionalFlow` is money crossing the tape in the
// cash market, this is exposure standing open in derivatives. They are routinely
// confused and they routinely disagree, which is itself the signal.
//
// ## Why this is a PARSE ticket, not a fetch ticket
//
// Nothing here needs to be scraped. `fao-participant-oi`, `fao-participant-vol`
// and `fii-stats` have been archiving to `feeds/NSE/` since P2 and prod holds
// 1,636 / 1,636 / 1,635 files respectively (verified 2026-08-13). The bytes were
// always there; only the parse was missing. So the backfill is a re-walk of the
// existing archive via `scripts/jobs/feed-parse.ts`, with no new egress, no new
// rate limit and no new failure mode.
//
// That is worth stating because the sibling P11 items are NOT in this position:
// `mwpl`, `corpbond`, `wdmlist`, `cbm` and `egr` all have ZERO archived files
// because their registry paths 404. Those are URL-discovery work. This one is
// not, and conflating them is how a "P11" estimate goes wrong by weeks.
//
// ## Why the storage grain is UNPIVOTED
//
// The file is WIDE — one row per participant, six (long, short) column pairs
// across, plus a totals pair. Stored in that shape, "FII net index-future
// position over the last 90 days" is a column name, so every new question needs
// a new column and every aggregate needs a hardcoded list of twelve fields.
// Unpivoted to (participant, bucket), the same question is a filter, and adding
// a seventh bucket the day NSE invents one is a data change rather than a
// migration.
//
// ## What is NOT stored, and why
//
// The file's "Total Long Contracts" / "Total Short Contracts" columns are a
// CHECKSUM over the six legs, not a seventh bucket. Storing them would double
// every sum built on this table — silently, because the number would look
// plausible. The parser verifies them and reports a mismatch; it does not
// persist them.
model MarketPositioning {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// UTC midnight of the IST trading day the positions describe.
  ///
  /// Parsed from the file's TITLE ROW ("…as on Aug 13, 2026"), which is the
  /// only place the date appears — not from the archive key's fetch day and not
  /// from the filename. Those agree on an ordinary night and diverge on exactly
  /// the days that matter: a replayed archive, a late publication, a re-walk of
  /// history. Trusting the filename is the same wrong-granularity assumption
  /// that made the F&O summaries report SUCCESS over a 456-day hole
  /// (MONEY-1189).
  date DateTime

  /// CLIENT | DII | FII | PRO — NSE's four participant categories, verbatim
  /// except for casing. "Pro" is proprietary desks trading the broker's own
  /// book; it is NOT a client bucket and must never be folded into one.
  participant String

  /// FUT_IDX | FUT_STK | OPT_IDX_CALL | OPT_IDX_PUT | OPT_STK_CALL |
  /// OPT_STK_PUT. The six real legs; see the totals note above for the seventh
  /// that deliberately is not here.
  bucket String

  /// OI | VOLUME. The two files are column-identical and describe different
  /// things: open interest is a STOCK (positions standing at close) and volume
  /// is a FLOW (contracts traded during the day). Same schema, incomparable
  /// magnitudes — a chart that averaged them would be meaningless, so the
  /// discriminator is part of the identity key rather than a provenance field.
  metric String

  /// Contracts held long. NSE publishes contract COUNTS, not notional — the
  /// lot size is not in this file, so a rupee value cannot be derived here and
  /// deliberately is not stored as if it could.
  longQty Float

  /// Contracts held short.
  shortQty Float

  /// long − short. Stored rather than computed at read time because it is the
  /// field almost every consumer actually wants, and because a stored net makes
  /// the DoD-change query a single index scan instead of a per-row subtraction
  /// over two days.
  netQty Float

  /// ₹ CRORE bought / sold / net, and the ₹ crore of open interest at end of
  /// day. ALL NULLABLE, and null on every row the participant files produce —
  /// MONEY-1204 / P0.1.
  ///
  /// The participant files (`nse-fao-participant-oi` / `-vol`) publish contract
  /// COUNTS and nothing else; the lot size is not in them, so a notional cannot
  /// be derived and `longQty`'s comment says so. `nse-fii-stats` publishes both
  /// counts AND rupees for the same participant and days, which is most of why
  /// it is worth parsing at all — so the rupee columns get real fields here
  /// rather than being dropped or, worse, crammed into the qty columns.
  ///
  /// Nullable is the honest shape, not a convenience: a null means "this feed
  /// does not publish a value for this cell", which is a different fact from a
  /// published zero, and there are real published zeros in here (NIFTYFPI
  /// futures printed 0 / 0.00 on 13-Aug-2026).
  longValue  Float?
  shortValue Float?
  netValue   Float?

  /// Contracts still open at end of day, and their ₹ crore — a SINGLE-SIDED
  /// stock with no long/short split, which is exactly why it is not folded into
  /// `longQty`/`shortQty`. Doing that would require inventing a `shortQty: 0`
  /// and would publish "FII holds no short open interest", a claim the file
  /// never makes.
  openInterestQty   Float?
  openInterestValue Float?

  /// Provenance — the archive family that produced this row
  /// ("nse-fao-participant-oi" / "nse-fao-participant-vol" / "nse-fii-stats").
  source String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// THE idempotency key, and note `metric` is IN it. Without that field the OI
  /// and VOL files — which carry the same participants, the same buckets and
  /// the same day — would collide on every single row, and whichever ran second
  /// would overwrite the first. The table would look full and be half wrong.
  ///
  /// Re-ingestion is the normal case: the P11 backfill re-walks 1,636 archived
  /// days, and a Pub/Sub redelivery re-walks today. Upserting on this key makes
  /// both a no-op update.
  ///
  /// MONEY-1204: `nse-fii-stats` describes the SAME participant (FII) on the
  /// SAME days, so it would land on this exact key were it not given its own
  /// `metric` ("FII_STATS") and its own bucket namespace (`IDX_FUT`, not
  /// `FUT_IDX` — see `fii-stats-logic.ts`). Reusing either would not raise a
  /// conflict; it would silently overwrite the participant feed's FII rows
  /// every night. Any future feed describing an existing participant must do
  /// the same: claim a new `metric`, never borrow one.
  @@unique([date, participant, bucket, metric])
  /// Hot read: "FII net position in index futures, last N days" — the sentiment
  /// panel's actual query, newest first.
  @@index([participant, bucket, metric, date(sort: Desc)])
  /// Cross-sectional: everything recorded for day D (the positioning table, ops
  /// sweeps, joining against IndexClose for the overlay).
  @@index([date, metric])
  @@map("market_positioning")
}

// MONEY-1187 (Data Engine P11 item 7) — NSE exchange circulars.
//
// One row = one circular AS ISSUED TO ONE DEPARTMENT. That distinction is the
// whole design of this table; see the key note below.
//
// Source is `/api/circulars?fromDate&toDate`, whose response is WRAPPED
// (`{data, fromDate, toDate}`) rather than a bare array — a parser that assumes
// an array reads zero circulars out of a perfectly good 200 and reports it as a
// quiet week.
model NseCircular {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// NSE's circular number ("75736"). NOT unique on its own — see @@unique.
  circularNumber String
  /// The display number as printed, which carries the department prefix.
  displayNumber  String @default("")

  /// The issuing department ("Listing", "Emerge", "Surveillance"). Half of the
  /// identity key, not decoration.
  department String
  /// NSE's own category. Measured 2026-08-13: ALL 45 surveillance circulars
  /// carry category "Compliance", so this field is far coarser than it looks
  /// and must never be the primary classifier — the topic classifier reads
  /// subject and department FIRST for exactly that reason.
  category   String @default("")

  /// The subject line, verbatim.
  subject String
  /// The company a company-specific circular concerns, when named.
  company String @default("")

  /// UTC midnight of the IST day NSE dated the circular, parsed from `cirDate`
  /// (YYYYMMDD), which is the authoritative one. The response also carries
  /// `cirDisplayDate` ("August 13, 2026") — same fact, looser format, not
  /// trusted. Round-trip validated, so an impossible date like 20260230 is
  /// REJECTED rather than silently rolling into 2 March.
  ///
  /// There is deliberately NO effectiveDate column. The endpoint has no such
  /// field; effective dates live in the linked PDF body. An always-null column
  /// would advertise a datum this source cannot supply.
  circularDate DateTime

  /// Our closed-set topic — TRADING_HOLIDAY | SURVEILLANCE | MARGIN | LISTING |
  /// SETTLEMENT | TECHNOLOGY | MUTUAL_FUND | CORPORATE_ACTION | COMPLIANCE |
  /// OTHER. OTHER is an unconditional final fallback and absorbs ~1.7% of live
  /// traffic legitimately: a classifier without a catch-all does not become
  /// more precise, it develops a new failure path.
  topic String

  /// Attachment URL, when the circular has one.
  fileUrl         String @default("")
  fileName        String @default("")
  fileExt         String @default("")
  /// APPROXIMATE size in bytes, derived from NSE's rounded-up KiB label.
  /// Named for what it is: CML75737.pdf is labelled "366 KB" and is actually
  /// 374,086 bytes. A field called `sizeBytes` would be quietly wrong.
  approxSizeBytes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Identity is (circularNumber, department), and the second half is NOT
  /// padding. Measured over one live 237-record window: only 205 circular
  /// numbers are distinct, and 26 numbers appear more than once — NSE re-issues
  /// one circular under EVERY department it applies to (75736 is filed under
  /// both "Listing" and "Emerge" with the same subject). Keying on the number
  /// alone silently discards half of every re-issued circular, and the loss is
  /// invisible: the row that survives looks completely normal.
  ///
  /// With the department included, the same window is 237/237 unique.
  @@unique([circularNumber, department])
  /// Hot read: "what came out this week", newest first.
  @@index([circularDate(sort: Desc)])
  /// The topic feed a retail surface actually renders.
  @@index([topic, circularDate(sort: Desc)])
  @@index([department, circularDate(sort: Desc)])
  @@map("nse_circulars")
}

// MONEY-1100 P4.6 — disclosed institutional prints from NSE's rolling
// `bulk.csv` / `block.csv` snapshots (history: historicalOR/bulk-block-short-deals).
//
// `dealType` comes from the FAMILY, never the bytes: the two files are
// shape-identical and nothing inside either says which one you are holding.
//
// `date` is the row's OWN trade date, NOT the archive key's fetch day. These
// snapshots routinely carry prints from earlier sessions (a Monday fetch of
// bulk.csv holds Friday's rows) — see core/market-data/deals.ts.
model InstitutionalDeal {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  date         DateTime // trade date (UTC midnight of the IST day)
  symbol       String
  exchange     String   @default("NSE")
  // "" when the file drops the descriptive column — a rename must not cost a
  // whole day of prints, so it is not part of row validity.
  securityName String   @default("")
  clientName   String // the disclosed counterparty — the point of this feed
  buySell      String // BUY | SELL
  // BigInt, not Int: a single print in a high-float penny name can exceed
  // Int32 (the same reason DailyPrice.deliveryQty is BigInt). Write it as
  // BigInt(row.qty) via Prisma — never $runCommandRaw, which stores a double.
  qty          BigInt
  avgPrice     Float // Trade Price / Wght. Avg. Price
  dealType     String // BULK | BLOCK
  remarks      String? // null on `-` AND when block.csv omits the column
  source       String   @default("NSE_DEALS")
  createdAt    DateTime @default(now())

  /// SHA-256 hex of exactDealKey(row) — the ALL-FIELDS identity from map §5,
  /// derived in core/market-data/deals.ts. All fields participate because the
  /// same client can legitimately print the same symbol twice in one day at
  /// different prices; only a byte-identical repeat (the rolling snapshot
  /// serving yesterday's print again) may collapse. A fixed-width derived key
  /// beats the literal 10-field compound unique: no variable-width free-text
  /// index, no Float inside a uniqueness constraint, and the normalisation
  /// lives in a unit- and mutation-tested function.
  dedupeKey String

  @@unique([dedupeKey])
  @@index([symbol, date])
  @@index([date])
  @@index([clientName, date]) // repeat-buyer detection (feeds MONEY-1117)
  @@map("institutional_deals")
}

// MONEY-1100 P4.6 — NSE SLB open lending positions per security. Borrow demand
// is the closest thing India publishes to single-stock short interest.
//
// NOT YET ARCHIVED: `nse-slb-openpos`'s registry URL probed 404 on 2026-08-08,
// so this model AND parseSlbOpenPositions are written from map §5, not from
// measured bytes. Verify both against a real file before enabling the family.
model SlbPosition {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  date       DateTime // trading date (UTC midnight of the IST day)
  symbol     String
  exchange   String    @default("NSE")
  series     String? // null when the file has no Series column
  // Int is safe here (unlike InstitutionalDeal.qty): SLB eligibility is a
  // curated ~liquid-names list, so open interest stays orders of magnitude
  // below Int32 — no penny-stock share counts.
  openQty    Int
  expiryDate DateTime? // SLB contracts are month-series; null if not broken out
  openValue  Float?
  source     String    @default("NSE_SLB")
  createdAt  DateTime  @default(now())

  // VERIFY ON FIRST ARCHIVE: this holds only if the file is one row PER
  // SECURITY. If it breaks positions out per expiry, this unique COLLIDES and
  // the writer must aggregate across expiries (or the unique must widen to
  // include expiryDate). Decide against the real bytes, not the fixture.
  // WIDENED after the first real archive — MONEY-1201.
  //
  // The comment above asked for exactly this decision to be made "against the
  // real bytes, not the fixture", and the real bytes settled it: NSE's
  // `slb_openpos_{DDMMYYYY}.csv` is one row per (SECURITY, SERIES), not per
  // security. On 13-Aug-2026, 116 of 331 symbols appear more than once (CDSL
  // nine times).
  //
  // Under the old `[symbol, date]` the writer's upsert was LAST-WRITE-WINS, so
  // 238,395,729 shares of open interest would have stored as 37,607,169 —
  // 84.2% of the borrow demand silently discarded, while the run reported 331
  // successful rows. A summing writer was the alternative and is worse: it
  // destroys the per-series ladder, which is the shape that makes this data
  // worth having as a short-interest proxy.
  //
  // `series` is nullable because older files may omit the column; a null
  // participates in the key as its own value, which is correct — "no series
  // reported" is one position, not a collision with every other.
  @@unique([symbol, date, series])
  @@index([date])
  @@index([symbol, date(sort: Desc)])
  @@map("slb_positions")
}

/// NSE wholesale-debt security master — MONEY-1204 (P14 / 14b.1).
///
/// Fed by TWO archived families that describe overlapping halves of the same
/// universe and agree on exactly one key: `nse-wdm-list` (`wdmlist_*.csv`,
/// 10,678 rows on 14-Aug-2026 — G-Secs, SDLs, PSU paper) and
/// `nse-corporate-bond-report` (3,717 rows — corporate issues, and the only one
/// of the two carrying `Issuer`, `Face Value` and `Credit Rating`).
///
/// Keyed on ISIN and NOT on symbol. The two files spell the instrument
/// differently (`CG2036` vs `AXBK32`), those namespaces do not intersect, and
/// MONEY-1093 already established that `series` lives in three incompatible
/// namespaces across NSE/BSE/Kite. ISIN is the one identifier every debt feed
/// prints and the one that joins to `InstrumentMapping`'s ~12k DEBT rows.
model BondMaster {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// The join key. Normalised .trim().toUpperCase() on ingest, because
  /// `cbm_trd` prints ISINs with a TRAILING SPACE ("INE261F08EO7 ") while
  /// wdmlist does not — an un-normalised join silently matches nothing, which
  /// looks exactly like "this bond does not trade".
  isin String @unique

  /// The exchange's own short name (wdmlist SECURITY / report Security).
  /// NOT unique: one issuer reuses a symbol across series (BOB appears four
  /// times on 14-Aug-2026 with four different ISINs and four maturities).
  symbol String

  /// GS | SG | PT | AT | ... — the exchange's security-type code, stored
  /// VERBATIM and decoded only at render, same rule as StockFlag's
  /// surveillance codes.
  secType String

  issuer       String?
  issueName    String?
  issueDesc    String?
  creditRating String?

  /// Annual coupon in PERCENT (7.88 = 7.88%). Parsed from the ISSUE_NAME
  /// column, which is where NSE puts it ("8.33%"). NULLABLE and never 0: a
  /// zero-coupon bond and a bond whose coupon we failed to read are different
  /// facts, and only one of them is tradeable information.
  coupon          Float?
  /// Yearly | Half Yearly | Quarterly | ... as published.
  couponFrequency String?
  faceValue       Float?

  issueDate       DateTime?
  /// NULL is MEANINGFUL here, not missing: perpetual instruments (BOB's Tier-1
  /// series) genuinely have no maturity date and print an empty cell. Defaulting
  /// it to any date would invent a redemption that will never happen.
  maturityDate    DateTime?
  nextCouponDate  DateTime?
  lastTradedDate  DateTime?
  lastTradedPrice Float?

  /// Listed | Delisted | Matured | ... as published.
  status String?

  /// The registry family id that produced this row.
  source String
  /// The trading day of the file this row was read from.
  asOf   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([symbol])
  @@index([maturityDate])
  @@index([secType, maturityDate])
  @@map("bond_master")
}

/// Daily traded price + yield for a debt instrument — MONEY-1204 (P14 / 14b.1).
///
/// From `nse-cbm-trades` (`cbm_trd{YYYYMMDD}.csv`). This is the price series
/// that gives the ~12k DEBT rows in `InstrumentMapping` something to show: the
/// cash bhavcopy does not carry them, which is why a bond page is empty today.
model BondEOD {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// Normalised exactly as BondMaster.isin — see the trailing-space note there.
  isin String
  /// Read from the file's own `Trade Date` column, NOT from the archive key.
  /// The two agree on an ordinary night and diverge on a replay, a late
  /// publication or a re-walk — the MONEY-1189 wrong-granularity trap.
  date DateTime

  /// CBM (corporate bond market) | WDM (wholesale debt) — which segment's file
  /// this row came from. IN THE UNIQUE KEY: the same ISIN can print on the same
  /// day in both segments at different prices, and collapsing them would make
  /// the row order-dependent (MONEY-1201's SLB lesson, where 84.2% of open
  /// interest vanished to a last-write-wins upsert).
  segment String

  lastPrice           Float?
  lastYtm             Float?
  /// Volume-weighted average price. Header has a DOUBLE SPACE
  /// ("Weighted Average Price  (Rs.)") — do not normalise it away blindly.
  wapPrice            Float?
  wtdYtm              Float?
  /// Rs in LACS, the file's own unit, stored UNCONVERTED — the field name
  /// carries the unit rather than the value being silently rescaled.
  lastTradeValueLacs  Float?
  totalTradeValueLacs Float?

  source    String
  createdAt DateTime @default(now())

  @@unique([isin, date, segment])
  @@index([date])
  @@index([isin, date(sort: Desc)])
  @@map("bond_eod")
}

/// Market-wide F&O open interest per underlying — MONEY-1204 (P14 / 14b.2).
///
/// ## Why `mwpl` and `utilisationPct` are NULLABLE and null today
///
/// The task asked for MWPL utilisation (`combinedOi / mwpl`). Only the
/// NUMERATOR is obtainable: `nse-combine-oi-deleq`
/// (`combineoi_deleq_{DDMMYYYY}.csv`, 688 archived days back to 2023-04)
/// publishes notional and futures-equivalent open interest per symbol and
/// NOTHING ELSE — verified against the real 14-Aug-2026 file, whose complete
/// header is `Date,ISIN,Scrip Name,Symbol,Notional Open Interest,
/// Portfolio-wise Futures Equivalent Open Interest`.
///
/// The DENOMINATOR lives in `mwpl_cli`, whose registry path 404s and which has
/// ZERO archived objects (confirmed 2026-08-16 against the prod bucket). The
/// neighbouring `oi_cli_limit` was checked and does not carry it either — its
/// columns are `SYMBOL,CLIENT_LIMIT,EXCHANGE`, a PER-CLIENT limit, which is a
/// different quantity and would produce a plausible, wrong utilisation.
///
/// So the OI is stored because it is real and useful on its own, and the two
/// derived fields stay NULL rather than being computed from the nearest
/// available number. A null utilisation reads as "not known"; a wrong one reads
/// as a risk signal, and the `>= 80%` StockFlag downstream would fire on it.
model MwplDaily {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  symbol String
  /// Also published, and the more stable join key.
  isin   String?
  /// From the file's own `Date` column (DD-MM-YYYY), not the archive key.
  date   DateTime

  /// Notional open interest across the market for this underlying.
  notionalOi Float?
  /// NSE's portfolio-wise futures-equivalent OI — a different measure, kept
  /// apart rather than folded in. It is fractional (140455762.42 for RELIANCE),
  /// so Float, not Int.
  futEquivOi Float?

  /// The market-wide position limit. NULL until a source for it exists — see
  /// the model note above. Do NOT populate this from `oi_cli_limit`.
  mwpl           Float?
  /// combinedOi / mwpl * 100. NULL whenever `mwpl` is null, which is always
  /// today. Never defaulted, never derived from a substitute denominator.
  utilisationPct Float?

  source    String
  createdAt DateTime @default(now())

  @@unique([symbol, date])
  @@index([date])
  @@index([symbol, date(sort: Desc)])
  @@map("mwpl_daily")
}

model DerivativeEOD {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  symbol     String // underlying, e.g. "RELIANCE" / "NIFTY"
  exchange   String   @default("NSE")
  instrument String // FUTIDX | FUTSTK | OPTIDX | OPTSTK
  expiry     DateTime
  // Options only. Stored as 0 / "XX" for futures rather than null so every
  // futures row carries the SAME sentinel values in the compound unique below.
  // (An earlier version of this comment claimed "MongoDB treats nulls as
  // distinct" — wrong: Mongo unique indexes compare nulls as EQUAL. The
  // sentinel design is still right, for the honest reason: null-in-identity
  // makes intent illegible and Prisma's typed filters awkward.)
  strike     Float    @default(0)
  optionType String   @default("XX") // CE | PE | XX (future)
  date       DateTime // Trading date (UTC midnight of the IST day)
  open       Float
  high       Float
  low        Float
  close      Float
  settle     Float?
  volume     Int      @default(0)
  openInt    Int      @default(0)
  oiChange   Int      @default(0)
  valueLakh  Float?
  source     String   @default("BHAVCOPY_HIST")
  createdAt  DateTime @default(now())

  @@unique([symbol, exchange, instrument, expiry, strike, optionType, date])
  @@index([symbol, date])
  @@index([date])
  @@map("derivative_eod")
}

model DailyPrice {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  instrumentId String            @db.ObjectId
  instrument   InstrumentMapping @relation(fields: [instrumentId], references: [id])
  date         DateTime // Trading date (UTC midnight)
  open         Float
  high         Float
  low          Float
  close        Float
  volume       Int               @default(0)
  adjClose     Float?
  source       String            @default("YAHOO") // YAHOO | ZERODHA
  createdAt    DateTime          @default(now())

  // MONEY-1100 P4.1 — delivery data (sec_bhavdata_full / SCBSEALL). All
  // nullable so pre-existing rows and sources without delivery stay valid.
  // deliveryQty is BigInt: single-day deliverable volume on the most-traded
  // names can exceed Int32 (Vodafone Idea has printed >1B shares/day).
  // NULL delivery on a row means "not reported" (NSE prints `-` on
  // trade-for-trade series, where delivery is 100% by construction) — never
  // coalesce to 0 or 100 at write time; see core/market-data/delivery.ts.
  deliveryQty BigInt?
  deliveryPct Float?
  avgPrice    Float? // reported session VWAP (AVG_PRICE), not derived
  trades      Int?

  @@unique([instrumentId, date])
  @@index([date])
  @@map("daily_prices")
}

// Intraday Bar - Sub-daily OHLCV bars (1m/5m/15m/30m/60m) cached from
// Zerodha Kite Connect or Yahoo Finance by the `intraday-sync` worker.
//
// Why this exists (MONEY-123 Part A):
//   Both Zerodha and Yahoo cap their live intraday chart API responses
//   at ~3 trading days per request, regardless of the `from`/`period1`
//   we pass. That makes TradingView's backward-scroll pattern impossible
//   to serve from live upstream calls alone. This collection is our own
//   rolling 90-day buffer - the post-market ingestion worker populates
//   it once per day and the UDF history route reads from it first.
//
// Retention strategy: 90 days rolling. Bars older than 90 days are
// deleted by a housekeeping job (not yet implemented - placeholder is
// the `source` field which will let the job identify this collection's
// rows cheaply).
//
// Shape rationale:
//   - `time` is the bar's START timestamp (UTC), to the minute.
//     Distinct from DailyPrice's `date` which is always UTC midnight.
//   - `interval` is the bar width as a short string: "1m", "5m", "15m",
//     "30m", "60m". A single instrument has one row per (interval, time)
//     pair, so scrolling through 5m and 15m on the same symbol shares
//     the instrument row but has independent bar series.
//   - `source` tracks which upstream produced the row so we can audit
//     data quality issues and re-ingest from a different source if
//     needed. Default YAHOO because early backfills will use Yahoo
//     until the Zerodha cookie/token rotation is sorted out for the
//     worker context.
model IntradayBar {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  instrumentId String            @db.ObjectId
  instrument   InstrumentMapping @relation(fields: [instrumentId], references: [id])
  interval     String // "1m" | "5m" | "15m" | "30m" | "60m"
  time         DateTime // Bar start time (UTC)
  open         Float
  high         Float
  low          Float
  close        Float
  volume       Int               @default(0)
  source       String            @default("YAHOO") // YAHOO | ZERODHA
  createdAt    DateTime          @default(now())

  @@unique([instrumentId, interval, time])
  @@index([instrumentId, interval, time(sort: Desc)])
  @@index([time])
  @@map("intraday_bars")
}

// Latest Quote - Real-time quote cache (one per instrument)
model LatestQuote {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  instrumentId  String            @unique @db.ObjectId
  instrument    InstrumentMapping @relation(fields: [instrumentId], references: [id])
  price         Float
  change        Float?
  changePercent Float?
  open          Float?
  high          Float?
  low           Float?
  previousClose Float?
  volume        Int?
  marketCap     Float?

  /// ── The four fields that made this cache LOSSY — MONEY-1255 ────────────
  ///
  /// `QuoteData` has carried `pe`, `eps`, `week52High` and `week52Low` since
  /// MONEY-1198, but this row did not, so the DB leg of the quote chain could
  /// not reconstruct them. That leg is consulted BEFORE live Yahoo, so any
  /// symbol with a `LatestQuote` row fresher than 60s resolved to an envelope
  /// with those four ABSENT — and the KEY METRICS card renders a missing
  /// metric as "—". The card therefore flickered: populated on a cold miss,
  /// dashed 30s later on the next poll, with MARKET CAP (which IS stored)
  /// staying put throughout. The degraded envelope was then written into the
  /// 15s shared cache, so the loss propagated to every other reader.
  ///
  /// The general shape: a cache row that stores a SUBSET of the type it caches
  /// silently degrades its callers on every HIT. Anything added to `QuoteData`
  /// must be added here in the same change.
  ///
  /// ## Nullable, and CLEARED rather than left stale
  ///
  /// All four are legitimately absent: a loss-making company has no trailing
  /// P/E, and `week52High`/`week52Low` are OMITTED by `sane52WeekRange`
  /// (apps/web/lib/market/yahoo-client-logic.ts) whenever the reported window
  /// fails to contain the prices we can see. The upserts write `?? null`, not
  /// `?? 0` and not `undefined`: a value that stops being reported must be
  /// erased, because re-serving the last good one would print a number we no
  /// longer believe — which is exactly what that guard exists to prevent. `0`
  /// would be worse still: it is a factual claim a screen would act on.
  ///
  /// ## ABSENT, not null, on every pre-existing row
  ///
  /// A Mongo `prisma db push` creates INDEXES, never FIELDS, so every row
  /// written before this change carries no such attribute at all, and Prisma's
  /// Mongo connector does not treat absent as null — BOTH `{pe: null}` and
  /// `{pe: {not: null}}` return ZERO rows. Filter with
  /// `OR: [{pe: null}, {pe: {isSet: false}}]` or a raw `$exists`. This class
  /// has caused MONEY-1050, MONEY-1205, MONEY-1234 and MONEY-1236.
  pe         Float?
  eps        Float?
  week52High Float?
  week52Low  Float?

  timestamp DateTime
  source    String   @default("YAHOO")
  updatedAt DateTime @updatedAt

  @@index([changePercent])
  @@index([instrumentId, changePercent])
  // MONEY-1092 - the discover heatmap sorts the whole collection by market
  // cap (`orderBy: { marketCap: "desc" }`, apps/web/lib/actions/
  // discover-heatmap.ts). Without an index on marketCap MongoDB cannot serve
  // that order from an index: it examines every document matching the filter
  // and runs a blocking in-memory SORT before `take` applies. That is the
  // 10s timeout behind "Failed to load market heatmap".
  //
  // Descending matches the query's direction so the planner walks the index
  // forward and stops at `take` instead of sorting. `marketCap: { gt: 0 }`
  // becomes an index range on the same key, so the filter rides the scan.
  // Verify with explain(): expect IXSCAN on marketCap and NO SORT stage.
  @@index([marketCap(sort: Desc)])
  @@map("latest_quotes")
}

// Market Data Sync Log - Tracks instrument and price sync operations
model MarketDataSyncLog {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  syncType         String // INSTRUMENT_SYNC | PRICE_BACKFILL | QUOTE_REFRESH
  source           String // ZERODHA | YAHOO
  status           String    @default("RUNNING") // RUNNING | COMPLETED | FAILED
  recordsProcessed Int       @default(0)
  recordsFailed    Int       @default(0)
  errorMessage     String?
  metadata         Json?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?

  @@index([syncType, startedAt])
  @@map("market_data_sync_logs")
}

// WatchList - User's custom watchlists
model WatchList {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String   @default("Default")
  description String?
  type        String   @default("STOCK") // "STOCK" or "MF"
  symbols     String[] // Array of symbols (legacy, kept for backward compat)
  color       String? // Hex color for UI
  icon        String? // Icon name
  order       Int      @default(0) // Display order
  isDefault   Boolean  @default(false)

  items WatchlistItem[] // Structured items with instrument references

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, isDefault])
  @@map("watch_lists")
}

// WatchlistItem - Individual instrument in a watchlist
model WatchlistItem {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  watchlistId  String    @db.ObjectId
  watchlist    WatchList @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  instrumentId String?   @db.ObjectId // Optional reference to InstrumentMapping
  symbol       String
  exchange     String
  addedAt      DateTime  @default(now())
  sortOrder    Int       @default(0)

  @@unique([watchlistId, symbol, exchange])
  @@index([watchlistId])
  @@map("watchlist_items")
}

// MutualFundMaster - AMFI master data for MF discovery
model MutualFundMaster {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  schemeCode   String    @unique
  schemeName   String
  amcName      String
  category     String // Large Cap, Mid Cap, Flexi Cap, ELSS, etc.
  subCategory  String? // Growth, Dividend, Direct, Regular
  plan         String? // DIRECT, REGULAR
  nav          Float
  navDate      DateTime
  aum          Float? // in crores
  returns1Y    Float?
  returns3Y    Float?
  returns5Y    Float?
  expenseRatio Float?
  riskLevel    String? // Low, Moderate, High, Very High
  isActive     Boolean   @default(true)
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Link to InstrumentMapping (optional, for Yahoo symbol mapping)
  instrumentId String? @db.ObjectId

  // ISIN codes from AMFI feed
  isinGrowth   String?
  isinDividend String?

  // AI-generated short description
  description String?

  // Enriched metadata from Kuvera/Captnemo API
  fundManager      String?
  crisilRating     String?
  volatility       String? // "low", "moderate", "high"
  returnsInception Float?
  fundType         String? // "equity", "debt", "hybrid", "solution", "other"
  /// MONEY-1207. These three had NO column at all, so the page hard-coded
  /// `null` for them. The benchmark in particular must never be synthesised:
  /// MONEY-610 removed a fabricated "Nifty 50 TRI" that was derived from the
  /// fund's own CAGR x 0.7 and rendered as if it were a real index.
  launchDate       DateTime?
  exitLoad         String? // free text as the SID states it ("1% if redeemed <365d")
  benchmarkName    String? // the scheme's OWN stated benchmark, never inferred

  metadataSource   String? // "kuvera", "mfapi", "amfi", "amfi-aum", "amfi-ter"
  metadataSyncedAt DateTime?

  @@index([amcName])
  @@index([category])
  @@index([isActive])
  @@index([isinGrowth])
  @@index([isinDividend])
  // MONEY-1129 - every `orderBy: { aum: "desc" }` over this collection was a
  // blocking in-memory SORT of the whole ~14k-scheme universe. Five call sites:
  // the MF screener (apps/web/lib/actions/screener.ts + packages/services/src/
  // screener.service.ts, both with NO `take` - so the sort ran on every screener
  // page load, on every tab), the discover top-500 and popular-funds fallback
  // (packages/services/src/discover.service.ts), and the fund-composition worker
  // batch. Descending matches the query direction, so the planner walks the
  // index forward and the `take`-bounded call sites stop early instead of
  // sorting the universe first.
  @@index([aum(sort: Desc)])
  // MONEY-1129 - the 30-day NAV-freshness gate (`navDate: { gte: cutoff }`,
  // buildMfScreenWhere in packages/services/src/screener.service.ts, mirrored in
  // apps/web/lib/screener/match-score.ts) is on EVERY screener query unless
  // SKIP_MF_NAV_GATE=1. It cuts ~14k -> ~1.7k in prod, so it deserves real index
  // bounds. Kept as its own single-field index rather than folding it into a
  // compound with `aum`: `navDate` is a RANGE predicate, and under Mongo's
  // Equality-Sort-Range rule a range key cannot be followed by a usable sort key
  // - `@@index([navDate, aum(sort: Desc)])` would bound the filter but STILL
  // leave a blocking SORT on aum, i.e. it would not fix the thing we are here to
  // fix. Two singles let the planner choose (tight navDate bounds + small sort,
  // or aum-ordered scan + no sort) and pick the winner per shape.
  @@index([navDate])
  // MONEY-1129 - popular-MF fallback in apps/web/app/api/market/search/route.ts
  // (`where: { isActive, plan: "DIRECT" }, orderBy: { nav: "desc" }, take: 5`).
  // Descending + `take: 5` means the planner reads a handful of index entries
  // instead of sorting every scheme to return five rows.
  @@index([nav(sort: Desc)])
  @@map("mutual_fund_masters")
}

// MfNavHistory - Historical NAV data for mutual funds (cached from MFAPI.in)
model MfNavHistory {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  schemeCode String
  date       DateTime
  nav        Float
  createdAt  DateTime @default(now())

  @@unique([schemeCode, date])
  @@index([schemeCode])
  /// MONEY-1486 — the watermark an incremental prod->QA copy would need.
  /// NOT USED BY ANYTHING YET, and `prisma db push` has not been run, so this
  /// index exists in NEITHER environment. `index-guard.ts` audits `@@unique`
  /// only, so nothing will report it missing either.
  ///
  /// `date` cannot serve: `mf-nav-backfill` writes a scheme's ENTIRE history in
  /// one go, so 184,119 rows inserted in ONE day carry `date` from 2014-05-27
  /// to 2026-09-18 (measured on prod) — a `$gt` bound on it goes permanently
  /// blind to every backfilled scheme. `createdAt` is `@default(now())`,
  /// applied at INSERT, so a 2014 NAV backfilled tonight still sorts above the
  /// mark. It is the only property that survives a backfill.
  ///
  /// Needed on BOTH sides before any use: QA for the `max()` read, prod for the
  /// `$gt` dump. Armed with prod unindexed it COLLSCANs 13.8M documents to find
  /// ~152k. See docs/reference/qa-sync-incremental-decision-2026-09.md.
  @@index([createdAt])
  @@map("mf_nav_history")
}

