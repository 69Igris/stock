/// Where a stored composition CAME FROM — MONEY-1405 D6.
///
/// This was a free `String` defaulting to "gemini", which was accurate and
/// said nothing, because there was only ever one writer. Now there are two and
/// they are not comparable: one is the AMC's filed SEBI portfolio statement,
/// the other is `gemini-2.5-pro` asked what it believes a fund holds with no
/// document in front of it.
///
/// `GEMINI_RECALL` is `@map`ped to the literal "gemini" ON PURPOSE. 111 rows
/// already carry that string, and a Prisma enum read of a value the enum does
/// not declare THROWS — so a plain `GEMINI_RECALL` value would turn every
/// existing composition read into an exception the moment the client was
/// regenerated, with no migration step anywhere in the diff to warn anyone.
/// The map makes the rename a code-level one and the stored bytes unchanged.
enum FundCompositionSource {
  AMC_DISCLOSURE
  GEMINI_RECALL @map("gemini")
}

model FundCompositionMeta {
  id              String                @id @default(auto()) @map("_id") @db.ObjectId
  fundType        String // "MF" or "ETF"
  fundId          String
  totalHoldings   Int                   @default(0)
  extractedAt     DateTime
  source          FundCompositionSource @default(GEMINI_RECALL)
  status          String                @default("READY") // PENDING, EXTRACTING, READY, FAILED, STALE
  sectorBreakdown Json? // [{ sector: "Banking", weight: 25.5 }]
  capBreakdown    Json? // [{ cap: "LARGE", weight: 65 }]
  assetBreakdown  Json? // [{ type: "EQUITY", weight: 85 }]
  /// NO LONGER WRITTEN — MONEY-1405 D6. The column and its 111 historical
  /// values stay because they are the evidence: every one of them sat at
  /// 0.95-0.99 while reciting a 26-28 month old portfolio. It was the model's
  /// grade of its own answer, defaulting to 0.7 when the model volunteered
  /// none, and a self-report cannot be evidence about itself.
  confidence      Float?
  dataAsOf        String? // "2025-12" - when the portfolio data is from
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([fundType, fundId])
  @@index([status])
  @@map("fund_composition_meta")
}

