// Chat History Model
model ChatHistory {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Chat metadata
  pagePath    String // e.g., "/dashboard", "/tradebook"
  pageName    String // e.g., "Dashboard", "Tradebook"
  pageIcon    String? // Icon name for display
  customTitle String? // User-defined title (overrides auto-generated)

  // Messages stored as JSON array
  messages Json[] // Array of { id, role, content, timestamp }

  /// MONEY-1245 — the raw Gemini turns (functionCall / functionResponse) for
  /// the tool-driven side chats, Ask FIRE and Ask Screener.
  ///
  /// Kept OUT of `messages` on purpose: that field holds
  /// { id, role, content, timestamp } and /chat-history's viewer renders
  /// exactly that shape, so folding tool turns in would render as garbage.
  /// This is what a resumed chat replays so the model still knows which plan
  /// or screen edits it already applied — without it a resume looks continuous
  /// to the user while the model starts blind.
  ///
  /// A SINGLE optional Json, not Json[]: a Mongo `db push` creates indexes,
  /// not fields, so this attribute is ABSENT (not null, not []) on every one
  /// of the pre-existing rows. NEVER filter on it — `{toolConversation: null}`
  /// and `{not: null}` both return zero. Read it by id and treat missing as
  /// "no tool context", which is correct for every StockSage chat.
  /// (That class caused MONEY-1050, MONEY-1234 and MONEY-1235.)
  toolConversation Json?

  // Status
  isArchived Boolean @default(false)

  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isArchived])
  @@index([userId, pagePath])
  @@index([lastMessageAt])
}

