// AI Decision Log (MONEY-786). A durable, append-only audit row for every
// autonomous AI decision the platform makes — research runs, portfolio
// roasts, chat replies, nudges, scans, rebalance insights. Captures the
// input, output, model rationale and quality/cost telemetry so AI behaviour
// is reviewable after the fact. Audit logs are retained even if the user is
// deleted (userId is nullable, no onDelete cascade).
enum AiDecisionType {
  RESEARCH_RUN
  ROAST
  CHAT_REPLY
  NUDGE
  SCAN
  REBALANCE_INSIGHT
}

enum AiDecisionProvider {
  GOOGLE
  ANTHROPIC
}

model AIGenerationLog {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String? @db.ObjectId

  // What kind of decision this was and who produced it.
  decisionType AiDecisionType
  provider     AiDecisionProvider @default(GOOGLE)
  model        String

  // The decision payload: prompt-shaped input, the generated output, and the
  // model's stated rationale for the decision.
  input     Json
  output    Json
  rationale String

  // Telemetry (best-effort; any may be absent depending on the call site).
  inputTokens  Int?
  outputTokens Int?
  latencyMs    Int?
  costUsd      Float?
  qualityScore Float?

  // Outcome ("COMPLETED" | "FAILED" | "REFUSED" | …) and the originating
  // session, plus a freeform metadata bag for call-site-specific context.
  outcome   String?
  sessionId String?
  metadata  Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([decisionType, createdAt])
  @@index([userId, createdAt])
  @@map("ai_generation_logs")
}

// ============== INVESTOR PROFILE & MASTERY (MONEY-787, B2) ==============
// Self-learning memory of who the investor is, plus a per-concept mastery
// model (Bayesian Knowledge Tracing + Item Response Theory). Together these
// let the AI personalise explanations to the user's actual experience and
// what they've already demonstrably learned. Unlike the AI audit log, these
// rows ARE user data and MUST cascade-delete with the user.

enum RiskAppetite {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MasteryLevel {
  NEW
  LEARNING
  PRACTICING
  PROFICIENT
  MASTERED
}

// One self-learning behavioural profile per user. `confidence` rises as we
// gather more signal; `seededFrom`/`traits` are freeform telemetry bags so we
// can evolve the heuristics without a migration. The 0..1 trait scores
// (panicSeller, overtrader, …) are soft propensities, not hard labels.
model InvestorProfile {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  riskAppetite    RiskAppetite    @default(MODERATE)
  experienceLevel ExperienceLevel @default(BEGINNER)

  // How much we trust this profile (0..1). Starts low, rises with evidence.
  confidence Float @default(0.1)

  // The signals this profile was last seeded/derived from (FIRE SWR, F&O
  // usage, 30d trade count, concentration, …). Audit + re-seed input.
  seededFrom Json?

  // Behavioural propensities, each a soft 0..1 score.
  panicSeller    Float @default(0)
  overtrader     Float @default(0)
  fomoProne      Float @default(0)
  dividendSeeker Float @default(0)

  // Open-ended bag for future derived traits.
  traits Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("investor_profiles")
}

// Per-concept mastery estimate. `conceptId` is a taxonomy slug (e.g.
// "valuation.pe-ratio") — NOT an ObjectId. `theta` is the IRT ability
// estimate; `pKnown` is the BKT P(known). `glow` is a 0..1 brightness for UI.
model ConceptMastery {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  conceptId String // taxonomy slug, not an ObjectId

  theta    Float        @default(0) // IRT ability, ~N(0,1)
  pKnown   Float        @default(0.1) // BKT P(known)
  level    MasteryLevel @default(NEW)
  glow     Float        @default(0) // 0..1 UI brightness
  attempts Int          @default(0)

  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, conceptId])
  @@index([userId])
  @@index([conceptId, updatedAt])
  @@map("concept_mastery")
}

// ============== BEHAVIOUR SIGNAL CAPTURE (MONEY-788, B3) ==============

// Append-only behavioural event stream. Every meaningful AI interaction
// (research run completed, chat intent resolved, portfolio roast) writes one
// row at capture-time. The nightly rollup (B4) reads this stream to derive
// snapshots + insights. `conceptIds` are taxonomy slugs (e.g.
// "valuation.pe-ratio") — NOT ObjectIds. `data` is a free-form payload
// (skill, symbols, mode, score, …). `refId` links back to a source row
// (researchSession / roast sessionId / chat messageId).
model UserEvent {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind       String // "research_completed", "chat_intent", "roast_completed", …
  surface    String // "RESEARCH", "CHAT", "ROAST", …
  conceptIds String[] // taxonomy slugs touched by this event
  data       Json? // free-form payload (skill, symbols, mode, score, …)
  refId      String? // source row id (sessionId / messageId)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, kind, createdAt])
  @@index([kind, createdAt])
  @@map("user_events")
}

// Per-user portfolio behaviour snapshot. WRITTEN by the nightly rollup (B4),
